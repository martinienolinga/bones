diff --git a/crates/bones-render/src/tiles.rs b/crates/bones-render/src/tiles.rs
new file mode 100644
index 0000000..b6cc10c
--- /dev/null
+++ b/crates/bones-render/src/tiles.rs
@@ -0,0 +1,160 @@
+//! Vignettes 3D rendues chacune dans sa propre texture, sur fond
+//! transparent (alpha prémultiplié) : l'interface les pose sur ses cartes
+//! comme des images natives (galeries de préréglages).
+//!
+//! Une texture par vignette plutôt qu'un atlas : la passe de rendu efface et
+//! résout (MSAA) toute sa cible, les vignettes ont des tailles différentes
+//! (cartes, bandeau d'une feuille), et l'on évite une copie. Chaque vignette
+//! est soumise aussitôt : ses uniformes (caméra, matrices des os) sont ainsi
+//! lus avant que la suivante ne les remplace.
+
+use crate::renderer::Renderer;
+use crate::scene::Scene;
+use crate::targets::RenderTargets;
+
+/// Attachements gardés pour des tailles différentes (cartes, bandeau…).
+const TARGET_SIZES: usize = 3;
+
+struct Tile {
+    texture: wgpu::Texture,
+    view: wgpu::TextureView,
+    /// Change à chaque (re)création de la texture.
+    generation: u64,
+}
+
+/// Vignettes rendues, par emplacement.
+#[derive(Default)]
+pub struct Tiles {
+    slots: Vec<Option<Tile>>,
+    /// Attachements (profondeur, MSAA) par taille, du plus récent au plus ancien.
+    targets: Vec<RenderTargets>,
+    generation: u64,
+}
+
+impl Tiles {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Vue de la vignette `slot` (format du moteur) et sa génération : une
+    /// nouvelle génération signale une nouvelle texture à réenregistrer.
+    pub fn view(&self, slot: usize) -> Option<(&wgpu::TextureView, u64)> {
+        let tile = self.slots.get(slot)?.as_ref()?;
+        Some((&tile.view, tile.generation))
+    }
+
+    /// Texture de la vignette `slot` (relecture dans les tests).
+    pub fn texture(&self, slot: usize) -> Option<&wgpu::Texture> {
+        Some(&self.slots.get(slot)?.as_ref()?.texture)
+    }
+
+    /// Taille en pixels de la vignette `slot`.
+    pub fn size(&self, slot: usize) -> Option<[u32; 2]> {
+        self.texture(slot).map(|t| [t.width(), t.height()])
+    }
+
+    /// Nombre d'emplacements.
+    pub fn len(&self) -> usize {
+        self.slots.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.slots.is_empty()
+    }
+
+    /// Ne garde que les `len` premiers emplacements (mémoire libérée).
+    pub fn truncate(&mut self, len: usize) {
+        self.slots.truncate(len);
+        if self.slots.is_empty() {
+            self.targets.clear();
+        }
+    }
+
+    /// Prépare `scene` et la dessine dans la vignette `slot` de `size` pixels
+    /// (créée ou recréée au besoin), sur fond transparent. Le fond de la
+    /// scène est ignoré. La commande est soumise immédiatement.
+    pub fn render(
+        &mut self,
+        renderer: &mut Renderer,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        scene: &Scene,
+        slot: usize,
+        size: [u32; 2],
+    ) {
+        let size = [size[0].max(1), size[1].max(1)];
+        let format = renderer.targets.format();
+        let view = self.ensure(device, format, slot, size).view.clone();
+        renderer.prepare(device, queue, scene);
+        // Fond noir transparent : les bords anticrénelés restent en alpha
+        // prémultiplié, comme l'attend egui.
+        renderer.frame.background = [0.0; 3];
+        renderer.frame.clear_alpha = 0.0;
+        let targets = self.targets(device, format, renderer.targets.samples(), size);
+        let mut encoder =
+            device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("tile") });
+        renderer.draw(&mut encoder, targets.views(), &view, size);
+        queue.submit([encoder.finish()]);
+    }
+
+    /// Vignette `slot` à la bonne taille.
+    fn ensure(
+        &mut self,
+        device: &wgpu::Device,
+        format: wgpu::TextureFormat,
+        slot: usize,
+        size: [u32; 2],
+    ) -> &Tile {
+        if self.slots.len() <= slot {
+            self.slots.resize_with(slot + 1, || None);
+        }
+        let fits = self.slots[slot]
+            .as_ref()
+            .is_some_and(|t| [t.texture.width(), t.texture.height()] == size && t.texture.format() == format);
+        if !fits {
+            self.generation += 1;
+            let texture = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("tile"),
+                size: wgpu::Extent3d {
+                    width: size[0],
+                    height: size[1],
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                    | wgpu::TextureUsages::TEXTURE_BINDING
+                    | wgpu::TextureUsages::COPY_SRC,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&wgpu::TextureViewDescriptor::default());
+            self.slots[slot] = Some(Tile {
+                texture,
+                view,
+                generation: self.generation,
+            });
+        }
+        self.slots[slot].as_ref().expect("vignette créée")
+    }
+
+    /// Attachements pour `size`, réutilisés d'une image à l'autre.
+    fn targets(
+        &mut self,
+        device: &wgpu::Device,
+        format: wgpu::TextureFormat,
+        samples: u32,
+        size: [u32; 2],
+    ) -> &RenderTargets {
+        let found = self.targets.iter().position(|t| t.size() == size);
+        let mut targets = match found {
+            Some(i) => self.targets.remove(i),
+            None => RenderTargets::new(format, samples),
+        };
+        targets.ensure(device, size);
+        self.targets.insert(0, targets);
+        self.targets.truncate(TARGET_SIZES);
+        &self.targets[0]
+    }
+}
diff --git a/crates/bones-render/tests/stage.rs b/crates/bones-render/tests/stage.rs
new file mode 100644
index 0000000..4d4a2c5
--- /dev/null
+++ b/crates/bones-render/tests/stage.rs
@@ -0,0 +1,135 @@
+//! Vignettes des préréglages joués sur le mannequin (`Tiles`) : fond
+//! transparent, modèle cadré, et expressions faciales nettement distinctes
+//! les unes des autres (critère de lisibilité des cartes).
+//!
+//! `BONES_RENDER_DUMP=dossier` écrit les vignettes (PPM) pour inspection.
+
+mod common;
+
+use bones_core::presets::{Category, Shot, StageModel, Staged, builtin, find_builtin};
+use bones_core::{Rig, Viewport};
+use bones_render::{Readback, Renderer, Scene, Tiles};
+use common::FORMAT;
+use glam::Mat4;
+
+const TILE: [u32; 2] = [200, 220];
+
+struct Bench {
+    device: wgpu::Device,
+    queue: wgpu::Queue,
+    renderer: Renderer,
+    tiles: Tiles,
+    model: StageModel,
+}
+
+impl Bench {
+    fn new() -> Option<Self> {
+        let (device, queue) = common::device()?;
+        let rig: Rig = bones_core::samples::mannequin();
+        let mut renderer = Renderer::new(&device, FORMAT);
+        renderer.set_mesh(&device, &queue, &rig.mesh, 1);
+        renderer.set_skin(&device, &queue, &rig.skin, 1);
+        Some(Self {
+            device,
+            queue,
+            renderer,
+            tiles: Tiles::new(),
+            model: StageModel::new(&rig),
+        })
+    }
+
+    /// Rend l'image `frame` de `staged` et retourne ses pixels RGBA.
+    fn render(&mut self, staged: &Staged, frame: usize) -> Vec<u8> {
+        let (mut world, mut joints): (_, Vec<Mat4>) = (Vec::new(), Vec::new());
+        staged.joints(&self.model, frame, &mut world, &mut joints);
+        let viewport = Viewport::new(TILE[0] as f32, TILE[1] as f32);
+        let camera = staged.camera(viewport.aspect(), 0.08);
+        let scene = Scene {
+            view_proj: camera.view_proj(&viewport),
+            eye: camera.eye(),
+            viewport: [0.0, 0.0, viewport.width, viewport.height],
+            background: [0.5, 0.5, 0.5],
+            joints: &joints,
+            show_mesh: true,
+            textured: true,
+            weights: None,
+            lines: &[],
+            bones: &[],
+            overlay_lines: &[],
+        };
+        let (device, queue) = (&self.device, &self.queue);
+        self.tiles
+            .render(&mut self.renderer, device, queue, &scene, 0, TILE);
+        let mut encoder = device.create_command_encoder(&Default::default());
+        let readback = Readback::copy(device, &mut encoder, self.tiles.texture(0).unwrap()).unwrap();
+        queue.submit([encoder.finish()]);
+        readback.wait().expect("relecture GPU")
+    }
+}
+
+/// Part des pixels qui diffèrent nettement entre deux images.
+fn difference(a: &[u8], b: &[u8]) -> f32 {
+    let (a, b) = (common::pixels(a), common::pixels(b));
+    let changed = a
+        .iter()
+        .zip(b)
+        .filter(|(p, q)| p.iter().zip(q.iter()).take(3).any(|(x, y)| x.abs_diff(*y) > 24))
+        .count();
+    changed as f32 / a.len() as f32
+}
+
+#[test]
+fn tiles_are_transparent_around_the_model() {
+    let Some(mut bench) = Bench::new() else {
+        eprintln!("aucun adaptateur GPU : test de rendu ignoré");
+        return;
+    };
+    let walk = Staged::new(find_builtin("builtin.human.walk").unwrap(), &bench.model).unwrap();
+    let rgba = bench.render(&walk, 0);
+    common::dump(&rgba, TILE, "stage-walk");
+    let pixels = common::pixels(&rgba);
+    assert_eq!(pixels[0], [0, 0, 0, 0], "fond transparent");
+    let opaque = pixels.iter().filter(|p| p[3] == 255).count() as f32 / pixels.len() as f32;
+    assert!(opaque > 0.08 && opaque < 0.6, "silhouette cadrée ({opaque})");
+    // Bords prémultipliés : jamais de couleur plus forte que l'alpha.
+    assert!(pixels.iter().all(|p| p[..3].iter().all(|c| *c <= p[3])));
+    assert_eq!(bench.tiles.size(0), Some(TILE));
+}
+
+#[test]
+fn expressions_read_differently_on_the_mannequin() {
+    let Some(mut bench) = Bench::new() else {
+        eprintln!("aucun adaptateur GPU : test de rendu ignoré");
+        return;
+    };
+    let mut emotions: Vec<(String, Vec<u8>)> = Vec::new();
+    let expressions = builtin()
+        .iter()
+        .filter(|p| p.info.category == Category::FacialExpression);
+    for preset in expressions {
+        let staged = Staged::new(preset, &bench.model).unwrap();
+        assert_eq!(staged.shot(), Shot::Face);
+        let rgba = bench.render(&staged, 0);
+        let name = format!("face-{}-{}", preset.info.group, preset.info.name).to_lowercase();
+        let name: String = name
+            .chars()
+            .map(|c| if c.is_alphanumeric() { c } else { '-' })
+            .collect();
+        common::dump(&rgba, TILE, &name);
+        if preset.info.group == "Emotions" {
+            emotions.push((preset.info.name.clone(), rgba));
+        }
+    }
+    // Deux émotions quelconques se distinguent nettement sur la carte : une
+    // part sensible des pixels change (mesurée sur le mannequin).
+    for (i, (a, pa)) in emotions.iter().enumerate() {
+        for (b, pb) in &emotions[i + 1..] {
+            let d = difference(pa, pb);
+            eprintln!("{a} / {b} : {:.2} %", d * 100.0);
+            assert!(d > MIN_DIFFERENCE, "{a} et {b} se ressemblent trop ({d})");
+        }
+    }
+}
+
+/// Part minimale de pixels qui changent entre deux émotions.
+const MIN_DIFFERENCE: f32 = 0.002;
