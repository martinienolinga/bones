diff --git a/crates/bones-app/src/ui/popovers/presets/stage.rs b/crates/bones-app/src/ui/popovers/presets/stage.rs
new file mode 100644
index 0000000..b330acd
--- /dev/null
+++ b/crates/bones-app/src/ui/popovers/presets/stage.rs
@@ -0,0 +1,175 @@
+//! Vignettes des cartes rendues avec le mannequin de l'app
+//! (`samples::mannequin`) : animations humanoïdes jouées sur place, corps
+//! entier ; expressions en gros plan sur le visage.
+//!
+//! Un fil de fond charge le mannequin une fois, puis cuit chaque préréglage
+//! demandé ([`Staged`]) : le fil de l'interface ne fait que relever les
+//! résultats, calculer les matrices des os de l'image voulue (quelques
+//! microsecondes) et demander la vignette au rendu (`crate::showcase`). Les
+//! matrices d'une expression (pose fixe) sont calculées une seule fois.
+
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+use std::sync::mpsc::{Receiver, Sender, channel};
+
+use bones_core::presets::{Preset, StageModel, Staged, shot_for};
+use bones_core::{Rig, Transform, Viewport};
+use glam::Mat4;
+
+use crate::showcase::{self, TileRequest};
+
+/// Vignette d'une carte.
+pub enum Tile {
+    /// Texture prête à poser sur la carte.
+    Texture(egui::TextureId),
+    /// En préparation : la carte garde son repère.
+    Pending,
+    /// Préréglage sans sens sur un humain (animal, végétal…).
+    Unsupported,
+}
+
+/// Résultat du fil de fond.
+enum Done {
+    Model(Arc<Rig>, Arc<StageModel>),
+    Staged(String, Option<Staged>),
+}
+
+/// Préréglage cuit, et ses matrices s'il est fixe.
+struct Ready {
+    staged: Staged,
+    still: Option<Arc<[Mat4]>>,
+}
+
+#[derive(Default)]
+pub struct StageCache {
+    jobs: Option<Sender<Preset>>,
+    results: Option<Receiver<Done>>,
+    model: Option<(Arc<Rig>, Arc<StageModel>)>,
+    /// Par identifiant : `None` tant que la cuisson est en cours ou a échoué.
+    staged: HashMap<String, Option<Ready>>,
+    /// Cuissons demandées et pas encore revenues.
+    pending: usize,
+    world: Vec<Transform>,
+    joints: Vec<Mat4>,
+}
+
+impl StageCache {
+    /// Oublie les préréglages cuits (bibliothèque relue) ; le mannequin reste.
+    pub fn clear(&mut self) {
+        self.staged.clear();
+    }
+
+    /// Des cuissons sont en cours : l'appelant redemande une image.
+    pub fn busy(&self) -> bool {
+        self.pending > 0 || (self.jobs.is_some() && self.model.is_none())
+    }
+
+    /// Le préréglage est-il joué en boucle (vignette à redessiner) ?
+    pub fn animated(&self, preset: &Preset) -> bool {
+        self.ready(preset).is_some_and(|r| !r.staged.is_static())
+    }
+
+    fn ready(&self, preset: &Preset) -> Option<&Ready> {
+        self.staged.get(&preset.info.id)?.as_ref()
+    }
+
+    /// Vignette de `preset` dans une carte de `size` points, à l'instant
+    /// `time` (secondes), avec une marge relative `margin` autour du cadrage.
+    pub fn tile(&mut self, ctx: &egui::Context, preset: &Preset, size: egui::Vec2, time: f32, margin: f32) -> Tile {
+        if shot_for(preset).is_none() {
+            return Tile::Unsupported;
+        }
+        self.poll();
+        let id = &preset.info.id;
+        if !self.staged.contains_key(id) {
+            self.submit(preset);
+            return Tile::Pending;
+        }
+        let (Some((rig, model)), Some(Some(ready))) = (&self.model, self.staged.get(id)) else {
+            return Tile::Pending;
+        };
+        let ppp = ctx.pixels_per_point();
+        let px = [(size.x * ppp).round().max(1.0) as u32, (size.y * ppp).round().max(1.0) as u32];
+        let viewport = Viewport::new(px[0] as f32, px[1] as f32);
+        let camera = ready.staged.camera(viewport.aspect(), margin);
+        let frame = ready.staged.frame_at(time);
+        let joints = match &ready.still {
+            Some(j) => j.clone(),
+            None => {
+                ready.staged.joints(model, frame, &mut self.world, &mut self.joints);
+                Arc::from(self.joints.as_slice())
+            }
+        };
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        (id, frame, px, margin.to_bits()).hash(&mut hasher);
+        let request = TileRequest {
+            key: hasher.finish(),
+            size: px,
+            joints,
+            view_proj: camera.view_proj(&viewport),
+            eye: camera.eye(),
+        };
+        match showcase::request(ctx, rig, request) {
+            Some(texture) => Tile::Texture(texture),
+            None => Tile::Pending,
+        }
+    }
+
+    /// Envoie `preset` au fil de fond (lancé à la première demande).
+    fn submit(&mut self, preset: &Preset) {
+        let jobs = self.jobs.get_or_insert_with(|| {
+            let (jobs, results) = spawn();
+            self.results = Some(results);
+            jobs
+        });
+        if jobs.send(preset.clone()).is_ok() {
+            self.staged.insert(preset.info.id.clone(), None);
+            self.pending += 1;
+        }
+    }
+
+    /// Relève les résultats du fil de fond.
+    fn poll(&mut self) {
+        let Some(results) = &self.results else { return };
+        for done in results.try_iter() {
+            match done {
+                Done::Model(rig, model) => self.model = Some((rig, model)),
+                Done::Staged(id, staged) => {
+                    self.pending = self.pending.saturating_sub(1);
+                    let ready = staged.map(|staged| {
+                        let still = self.model.as_ref().filter(|_| staged.is_static()).map(|(_, m)| {
+                            staged.joints(m, 0, &mut self.world, &mut self.joints);
+                            Arc::from(self.joints.as_slice())
+                        });
+                        Ready { staged, still }
+                    });
+                    self.staged.insert(id, ready);
+                }
+            }
+        }
+    }
+}
+
+/// Fil de fond : charge le mannequin, puis cuit les préréglages reçus.
+fn spawn() -> (Sender<Preset>, Receiver<Done>) {
+    let (jobs, inbox) = channel::<Preset>();
+    let (outbox, results) = channel();
+    std::thread::Builder::new()
+        .name("preset-stage".into())
+        .spawn(move || {
+            let rig = Arc::new(bones_core::samples::mannequin());
+            let model = Arc::new(StageModel::new(&rig));
+            if outbox.send(Done::Model(rig, model.clone())).is_err() {
+                return;
+            }
+            for preset in inbox {
+                let staged = Staged::new(&preset, &model).ok();
+                if outbox.send(Done::Staged(preset.info.id.clone(), staged)).is_err() {
+                    return;
+                }
+            }
+        })
+        .expect("fil des vignettes");
+    (jobs, results)
+}
diff --git a/crates/bones-app/src/ui/popovers/presets/tests.rs b/crates/bones-app/src/ui/popovers/presets/tests.rs
new file mode 100644
index 0000000..d847145
--- /dev/null
+++ b/crates/bones-app/src/ui/popovers/presets/tests.rs
@@ -0,0 +1,104 @@
+//! Tests des vignettes des galeries (sans GPU) : les cartes visibles
+//! demandent au rendu une vignette du mannequin — fixe pour une expression,
+//! renouvelée au fil du cycle pour une animation — et les préréglages
+//! d'animaux gardent leur aperçu en bâtons.
+
+use std::time::{Duration, Instant};
+
+use bones_core::{Editor, Mode, Rig, Viewport};
+use egui::{RawInput, Rect, pos2, vec2};
+
+use crate::settings::Settings;
+use crate::showcase;
+use crate::ui::{Busy, Popover, UiState, show};
+
+struct Gallery {
+    ctx: egui::Context,
+    editor: Editor,
+    state: UiState,
+}
+
+impl Gallery {
+    fn open(popover: Popover, name: &str) -> Self {
+        let ctx = egui::Context::default();
+        bones_ui::install(&ctx);
+        let docs = std::env::temp_dir().join(format!("bones-stage-tests-{name}"));
+        let _ = std::fs::remove_dir_all(&docs);
+        let mut editor = Editor::new(Rig::demo());
+        editor.set_mode(Mode::Pose);
+        let mut state = UiState::new(docs, Settings::default());
+        state.popover = Some(popover);
+        state.popover_anchor = 700.0;
+        Self { ctx, editor, state }
+    }
+
+    /// Une image à l'instant `time` ; retourne les clés des vignettes
+    /// demandées.
+    fn frame(&mut self, time: f64) -> Vec<u64> {
+        let input = RawInput {
+            screen_rect: Some(Rect::from_min_size(pos2(0.0, 0.0), vec2(1366.0, 1024.0))),
+            time: Some(time),
+            ..Default::default()
+        };
+        let viewport = Viewport::new(1366.0, 1024.0);
+        let busy = Busy {
+            binding: false,
+            jobs: 0,
+        };
+        let (editor, state) = (&mut self.editor, &mut self.state);
+        let mut output = self.ctx.run_ui(input, |ui| {
+            show(ui.ctx(), editor, state, &viewport, busy);
+        });
+        output.textures_delta.clear();
+        showcase::take_keys(&self.ctx)
+    }
+
+    /// Images jusqu'à ce que les vignettes visibles soient toutes demandées
+    /// (cuisson sur le fil de fond terminée).
+    fn settle(&mut self, time: f64) -> Vec<u64> {
+        let deadline = Instant::now() + Duration::from_secs(60);
+        let mut last = Vec::new();
+        while Instant::now() < deadline {
+            let keys = self.frame(time);
+            if !keys.is_empty() && keys.len() == last.len() && !self.state.presets.stage.busy() {
+                return keys;
+            }
+            last = keys;
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        last
+    }
+}
+
+#[test]
+fn expression_cards_request_still_mannequin_tiles() {
+    let mut g = Gallery::open(Popover::Expressions, "expressions");
+    let keys = g.settle(1.0);
+    // Grille de trois colonnes : au moins deux rangées visibles, jamais toute
+    // la bibliothèque (seules les cartes visibles sont rendues).
+    assert!(keys.len() >= 6, "{} vignettes", keys.len());
+    let total = super::grid::entries(&g.state.presets, super::Kind::Expressions).len();
+    assert!(keys.len() < total, "{} sur {total}", keys.len());
+    // Expression : pose fixe, même contenu d'une image à l'autre.
+    assert_eq!(g.frame(2.5), keys, "vignettes fixes");
+}
+
+#[test]
+fn human_animation_cards_play_in_a_loop() {
+    let mut g = Gallery::open(Popover::Presets, "human");
+    g.state.presets.test_section(0); // Human
+    let first = g.settle(0.0);
+    assert!(first.len() >= 3, "{} vignettes", first.len());
+    let later = g.frame(0.4);
+    assert_eq!(later.len(), first.len());
+    assert_ne!(later, first, "l'animation avance");
+}
+
+#[test]
+fn animal_cards_keep_the_stick_figure() {
+    let mut g = Gallery::open(Popover::Presets, "animals");
+    g.state.presets.test_section(1); // Animals
+    for i in 0..5 {
+        assert!(g.frame(f64::from(i) * 0.1).is_empty(), "aucune vignette du mannequin");
+    }
+}
diff --git a/crates/bones-core/src/presets/expression/actions.rs b/crates/bones-core/src/presets/expression/actions.rs
new file mode 100644
index 0000000..3a5e413
--- /dev/null
+++ b/crates/bones-core/src/presets/expression/actions.rs
@@ -0,0 +1,179 @@
+//! Actions faciales nommées (unités d'action à la FACS, simplifiées), qui
+//! composent les expressions de la bibliothèque. Amplitudes `k` ~ [0, 1].
+//!
+//! Décalages en millimètres sur une tête de référence (voir
+//! [`Expr::shift`]) ; rotations en radians (conventions dans `builder`).
+
+use super::builder::Expr;
+use crate::autorig::face::FaceBone;
+
+impl Expr {
+    // --- Sourcils ---
+    pub fn brows_up(&mut self, k: f32) {
+        for (b, up) in [
+            (FaceBone::BrowInL, 16.0),
+            (FaceBone::BrowMidL, 18.0),
+            (FaceBone::BrowOutL, 13.0),
+        ] {
+            self.pair_rot(b, -0.30 * k, 0.0, 0.0);
+            self.pair_shift(b, 0.0, 1.0 * k, up * k);
+        }
+    }
+    pub fn brows_down(&mut self, k: f32) {
+        self.pair_rot(FaceBone::BrowInL, 0.28 * k, 0.0, 0.12 * k);
+        self.pair_rot(FaceBone::BrowMidL, 0.20 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::BrowOutL, 0.10 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::BrowInL, -7.0 * k, 3.0 * k, -13.0 * k);
+        self.pair_shift(FaceBone::BrowMidL, -3.0 * k, 1.5 * k, -9.0 * k);
+        self.pair_shift(FaceBone::BrowOutL, 0.0, 0.0, -4.0 * k);
+    }
+    /// Sourcils obliques (intérieur relevé) : tristesse, peur.
+    pub fn brows_inner_up(&mut self, k: f32) {
+        self.pair_rot(FaceBone::BrowInL, -0.30 * k, 0.0, 0.10 * k);
+        self.pair_rot(FaceBone::BrowMidL, -0.08 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::BrowOutL, 0.10 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::BrowInL, -4.0 * k, 1.5 * k, 16.0 * k);
+        self.pair_shift(FaceBone::BrowMidL, 0.0, 0.0, 5.0 * k);
+        self.pair_shift(FaceBone::BrowOutL, 0.0, 0.0, -4.0 * k);
+    }
+
+    // --- Paupières (pivot au centre du globe : la rotation suffit) ---
+    pub fn lids_widen(&mut self, k: f32) {
+        self.pair_rot(FaceBone::EyelidTopL, -0.40 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::EyelidBottomL, 0.30 * k, 0.0, 0.0);
+    }
+    pub fn lids_close(&mut self, k: f32) {
+        self.pair_rot(FaceBone::EyelidTopL, 0.85 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::EyelidBottomL, -0.25 * k, 0.0, 0.0);
+    }
+    /// Ferme une seule paupière (clin d'œil) ; `left` choisit le côté.
+    pub fn lid_close_one(&mut self, left: bool, k: f32) {
+        let (top, bot) = if left {
+            (FaceBone::EyelidTopL, FaceBone::EyelidBottomL)
+        } else {
+            (FaceBone::EyelidTopR, FaceBone::EyelidBottomR)
+        };
+        self.rot(top, 0.85 * k, 0.0, 0.0);
+        self.rot(bot, -0.25 * k, 0.0, 0.0);
+    }
+    pub fn squint(&mut self, k: f32) {
+        self.pair_rot(FaceBone::EyelidBottomL, -0.40 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::EyelidTopL, 0.20 * k, 0.0, 0.0);
+    }
+
+    // --- Bouche et mâchoire ---
+    pub fn jaw_open(&mut self, k: f32) {
+        self.rot(FaceBone::Jaw, 0.35 * k, 0.0, 0.0);
+    }
+    pub fn smile(&mut self, k: f32) {
+        self.pair_rot(FaceBone::LipCornerL, -0.35 * k, 0.0, -0.28 * k);
+        self.pair_rot(FaceBone::LipTopL, -0.12 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::LipCornerL, 10.0 * k, -4.0 * k, 12.0 * k);
+        self.pair_shift(FaceBone::LipTopL, 1.5 * k, 0.0, 2.5 * k);
+        self.pair_shift(FaceBone::LipBottomL, 1.5 * k, 0.0, 2.0 * k);
+        self.cheeks_raise(0.6 * k);
+    }
+    pub fn frown_mouth(&mut self, k: f32) {
+        self.pair_rot(FaceBone::LipCornerL, 0.32 * k, 0.0, 0.12 * k);
+        self.pair_rot(FaceBone::LipBottomL, 0.10 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::LipCornerL, 2.0 * k, -1.0 * k, -12.0 * k);
+        self.pair_shift(FaceBone::LipBottomL, 0.0, 1.5 * k, -2.5 * k);
+        self.shift(FaceBone::LipBottom, 0.0, 2.5 * k, 1.5 * k);
+    }
+    /// Un seul coin relevé (sourire en coin, mépris) ; `left` choisit le côté.
+    pub fn corner_up(&mut self, left: bool, k: f32) {
+        let (c, out, side) = if left {
+            (FaceBone::LipCornerL, -0.25 * k, 1.0)
+        } else {
+            (FaceBone::LipCornerR, 0.25 * k, -1.0)
+        };
+        self.rot(c, -0.38 * k, 0.0, out);
+        self.shift(c, side * 8.0 * k, -4.0 * k, 13.0 * k);
+    }
+    pub fn lips_part(&mut self, k: f32) {
+        self.rot(FaceBone::LipTop, -0.15 * k, 0.0, 0.0);
+        self.rot(FaceBone::LipBottom, 0.15 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::LipTopL, -0.10 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::LipBottomL, 0.10 * k, 0.0, 0.0);
+        self.shift(FaceBone::LipTop, 0.0, 0.5 * k, 5.0 * k);
+        self.shift(FaceBone::LipBottom, 0.0, 0.5 * k, -5.0 * k);
+        self.pair_shift(FaceBone::LipTopL, 0.0, 0.0, 3.5 * k);
+        self.pair_shift(FaceBone::LipBottomL, 0.0, 0.0, -3.5 * k);
+    }
+    /// Bouche en avant et resserrée (bisou, « ou »).
+    pub fn pucker(&mut self, k: f32) {
+        self.pair_rot(FaceBone::LipCornerL, 0.0, 0.0, 0.45 * k);
+        self.rot(FaceBone::LipTop, -0.10 * k, 0.0, 0.0);
+        self.rot(FaceBone::LipBottom, 0.10 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::LipCornerL, -13.0 * k, 6.0 * k, 0.0);
+        self.shift(FaceBone::LipTop, 0.0, 10.0 * k, -0.5 * k);
+        self.shift(FaceBone::LipBottom, 0.0, 10.0 * k, 0.5 * k);
+        self.pair_shift(FaceBone::LipTopL, -4.0 * k, 7.0 * k, 0.0);
+        self.pair_shift(FaceBone::LipBottomL, -4.0 * k, 7.0 * k, 0.0);
+    }
+    /// Lèvres étirées sur les côtés (« i », « e »).
+    pub fn widen_mouth(&mut self, k: f32) {
+        self.pair_rot(FaceBone::LipCornerL, 0.0, 0.0, -0.30 * k);
+        self.pair_shift(FaceBone::LipCornerL, 12.0 * k, -4.0 * k, 0.0);
+        self.pair_shift(FaceBone::LipTopL, 3.0 * k, -1.5 * k, 0.0);
+        self.pair_shift(FaceBone::LipBottomL, 3.0 * k, -1.5 * k, 0.0);
+    }
+    /// Lèvre inférieure remontée contre les dents du haut (« f », « v »).
+    pub fn lower_lip_up(&mut self, k: f32) {
+        self.rot(FaceBone::LipBottom, -0.22 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::LipBottomL, -0.18 * k, 0.0, 0.0);
+        self.rot(FaceBone::LipTop, -0.08 * k, 0.0, 0.0);
+        self.shift(FaceBone::LipBottom, 0.0, -3.5 * k, 7.0 * k);
+        self.pair_shift(FaceBone::LipBottomL, 0.0, -3.0 * k, 5.5 * k);
+        self.shift(FaceBone::LipTop, 0.0, 0.5 * k, 2.0 * k);
+    }
+    /// Lèvres pincées l'une contre l'autre (« m », « b », « p »).
+    pub fn lips_press(&mut self, k: f32) {
+        self.rot(FaceBone::LipTop, 0.10 * k, 0.0, 0.0);
+        self.rot(FaceBone::LipBottom, -0.10 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::LipTopL, 0.06 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::LipBottomL, -0.06 * k, 0.0, 0.0);
+        self.shift(FaceBone::LipTop, 0.0, -2.5 * k, -2.5 * k);
+        self.shift(FaceBone::LipBottom, 0.0, -2.5 * k, 3.0 * k);
+        self.pair_shift(FaceBone::LipTopL, 0.0, -1.5 * k, -1.5 * k);
+        self.pair_shift(FaceBone::LipBottomL, 0.0, -1.5 * k, 2.5 * k);
+        self.pair_shift(FaceBone::LipCornerL, -2.5 * k, 0.0, 0.0);
+    }
+
+    // --- Nez, joues ---
+    pub fn nose_wrinkle(&mut self, k: f32) {
+        self.rot(FaceBone::Nose, -0.22 * k, 0.0, 0.0);
+        self.pair_rot(FaceBone::NostrilL, -0.25 * k, 0.0, 0.0);
+        self.shift(FaceBone::Nose, 0.0, 0.0, 3.0 * k);
+        self.pair_shift(FaceBone::NostrilL, 2.0 * k, 0.0, 7.0 * k);
+        // Releveur de la lèvre supérieure (AU 9-10).
+        self.shift(FaceBone::LipTop, 0.0, 0.5 * k, 4.0 * k);
+        self.pair_shift(FaceBone::LipTopL, 0.0, 0.5 * k, 4.5 * k);
+    }
+    pub fn nostrils_flare(&mut self, k: f32) {
+        self.pair_rot(FaceBone::NostrilL, -0.10 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::NostrilL, 6.0 * k, 0.0, 1.5 * k);
+    }
+    pub fn cheeks_raise(&mut self, k: f32) {
+        self.pair_rot(FaceBone::CheekL, -0.30 * k, 0.0, 0.0);
+        self.pair_shift(FaceBone::CheekL, 1.5 * k, 3.0 * k, 9.0 * k);
+    }
+
+    // --- Langue (ignorée si absente) ---
+    pub fn tongue_out(&mut self, k: f32) {
+        self.rot(FaceBone::Tongue1, 0.25 * k, 0.0, 0.0);
+        self.rot(FaceBone::Tongue2, 0.22 * k, 0.0, 0.0);
+    }
+    pub fn tongue_up(&mut self, k: f32) {
+        self.rot(FaceBone::Tongue1, -0.30 * k, 0.0, 0.0);
+        self.rot(FaceBone::Tongue2, -0.18 * k, 0.0, 0.0);
+    }
+
+    // --- Oreilles (animaux) ---
+    pub fn ears_back(&mut self, k: f32) {
+        self.pair_rot(FaceBone::EarL, -0.30 * k, 0.40 * k, 0.0);
+    }
+    pub fn ears_up(&mut self, k: f32) {
+        self.pair_rot(FaceBone::EarL, 0.30 * k, -0.20 * k, 0.0);
+    }
+}
