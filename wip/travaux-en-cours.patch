+use glam::Vec3;
+
+use super::*;
+use crate::presets::create::CreateOptions;
+use crate::presets::model::PresetKind;
+use crate::presets::{RefRig, builtin, find_builtin};
+use crate::{Editor, Rig};
+
+fn preset(id: &str) -> Preset {
+    find_builtin(id).unwrap_or_else(|| panic!("{id}")).clone()
+}
+
+fn root_x(e: &Editor, frame: f32) -> Vec3 {
+    let mut pose = e.rig.pose.clone();
+    e.rig.clip.sample_into(frame, &mut pose);
+    let root = e.rig.skeleton.find("root.x").unwrap();
+    pose.world(&e.rig.skeleton)[root.index()].translation
+}
+
+#[test]
+fn apply_is_a_single_undo_step() {
+    let mut e = Editor::new(Rig::demo());
+    let before = (*e.rig.clip).clone();
+    let edits = e.edit_count();
+    let report = e.apply_preset(&preset("builtin.human.walk"), &ApplyOptions::default()).unwrap();
+    assert!(report.frames > 20);
+    assert!(report.unmapped.len() < e.rig.skeleton.len());
+    assert_eq!(e.rig.clip.keys().len() as u32, report.frames);
+    assert!(e.edit_count() > edits);
+    e.undo();
+    assert_eq!(*e.rig.clip, before);
+    assert!(!e.can_undo());
+    e.redo();
+    assert_eq!(e.rig.clip.keys().len() as u32, report.frames);
+}
+
+#[test]
+fn failed_apply_changes_nothing() {
+    let mut rig = Rig::new("Rope", crate::Mesh::default());
+    rig.set_skeleton(RefRig::Rope.skeleton(), Vec::new());
+    let mut e = Editor::new(rig);
+    let err = e.apply_preset(&preset("builtin.human.walk"), &ApplyOptions::default());
+    assert!(err.is_err());
+    assert!(!e.can_undo());
+}
+
+#[test]
+fn loops_accumulate_root_motion_and_in_place_removes_it() {
+    let mut e = Editor::new(Rig::demo());
+    let walk = preset("builtin.human.walk");
+    let options = ApplyOptions {
+        loops: 3,
+        ..ApplyOptions::default()
+    };
+    let one = {
+        let mut e1 = Editor::new(Rig::demo());
+        e1.apply_preset(&walk, &ApplyOptions::default()).unwrap().frames
+    };
+    let report = e.apply_preset(&walk, &options).unwrap();
+    assert_eq!(report.frames, 3 * (one - 1) + 1);
+    let travel = root_x(&e, (report.frames - 1) as f32) - root_x(&e, 0.0);
+    assert!(travel.z > 3.0, "{travel:?}");
+    let options = ApplyOptions {
+        loops: 2,
+        in_place: true,
+        ..ApplyOptions::default()
+    };
+    let report = e.apply_preset(&walk, &options).unwrap();
+    let travel = root_x(&e, (report.frames - 1) as f32) - root_x(&e, 0.0);
+    assert!(Vec3::new(travel.x, 0.0, travel.z).length() < 1e-3, "{travel:?}");
+}
+
+#[test]
+fn insert_shifts_later_keys_and_continues_from_the_character() {
+    let mut e = Editor::new(Rig::demo());
+    let walk = preset("builtin.human.walk");
+    let n = e.apply_preset(&walk, &ApplyOptions::default()).unwrap().frames;
+    let end = root_x(&e, (n - 1) as f32);
+    let options = ApplyOptions {
+        mode: ApplyMode::Insert,
+        frame: n,
+        ..ApplyOptions::default()
+    };
+    let report = e.apply_preset(&preset("builtin.human.jump"), &options).unwrap();
+    assert_eq!(report.start, n);
+    // Le saut part de là où la marche s'arrête.
+    let start = root_x(&e, n as f32);
+    assert!((Vec3::new(start.x - end.x, 0.0, start.z - end.z)).length() < 0.05, "{start:?} / {end:?}");
+    assert_eq!(e.rig.clip.frame_count, n + report.frames);
+}
+
+#[test]
+fn blend_and_bone_mask_keep_the_rest_of_the_animation() {
+    let mut e = Editor::new(Rig::demo());
+    let walk = preset("builtin.human.walk");
+    let n = e.apply_preset(&walk, &ApplyOptions::default()).unwrap().frames;
+    let walked = (*e.rig.clip).clone();
+    let arm: Vec<_> = ["shoulder.r", "arm.r", "forearm.r", "hand.r"]
+        .iter()
+        .map(|b| e.rig.skeleton.find(b).unwrap())
+        .collect();
+    let options = ApplyOptions {
+        mode: ApplyMode::Blend,
+        frame: 0,
+        bones: arm.clone(),
+        ..ApplyOptions::default()
+    };
+    e.apply_preset(&preset("builtin.human.wave"), &options).unwrap();
+    let (mut a, mut b) = (e.rig.pose.clone(), e.rig.pose.clone());
+    walked.sample_into(10.0, &mut a);
+    e.rig.clip.sample_into(10.0, &mut b);
+    let thigh = e.rig.skeleton.find("thigh.l").unwrap();
+    assert!(a.bones[thigh.index()].abs_diff_eq(&b.bones[thigh.index()], 1e-5));
+    assert!(!a.bones[arm[1].index()].abs_diff_eq(&b.bones[arm[1].index()], 1e-3));
+    assert!(e.rig.clip.frame_count >= n);
+}
+
+#[test]
+fn mirror_raises_the_other_hand() {
+    let skeleton = RefRig::Humanoid.skeleton();
+    let roles = crate::presets::detect(&skeleton);
+    let base = crate::Pose::rest(&skeleton);
+    let wave = preset("builtin.human.wave");
+    let hand = |mirror| {
+        let options = ApplyOptions {
+            mirror,
+            ..ApplyOptions::default()
+        };
+        let (poses, _) = bake_preset(&wave, &skeleton, &roles, &base, &options, 30.0).unwrap();
+        let w = poses[0].world(&skeleton);
+        let (l, r) = (skeleton.find("hand.l").unwrap(), skeleton.find("hand.r").unwrap());
+        (w[l.index()].translation.y, w[r.index()].translation.y)
+    };
+    let (l, r) = hand(false);
+    assert!(r > l + 0.3);
+    let (l, r) = hand(true);
+    assert!(l > r + 0.3);
+}
+
+#[test]
+fn created_preset_reapplies_identically() {
+    let mut e = Editor::new(Rig::demo());
+    e.apply_preset(&preset("builtin.human.dance"), &ApplyOptions::default()).unwrap();
+    let created = e
+        .create_preset(&CreateOptions {
+            name: "My/Dance:1".into(),
+            looping: true,
+            ..CreateOptions::default()
+        })
+        .unwrap();
+    assert_eq!(created.info.name, "My-Dance-1");
+    assert!(matches!(created.kind, PresetKind::Keyframes(_)));
+    let dense = (*e.rig.clip).clone();
+    e.apply_preset(&created, &ApplyOptions::default()).unwrap();
+    let (mut a, mut b) = (e.rig.pose.clone(), e.rig.pose.clone());
+    for f in [0.0, 7.0, 20.0] {
+        dense.sample_into(f, &mut a);
+        e.rig.clip.sample_into(f, &mut b);
+        let (wa, wb) = (a.world(&e.rig.skeleton), b.world(&e.rig.skeleton));
+        for (x, y) in wa.iter().zip(&wb) {
+            assert!(x.translation.abs_diff_eq(y.translation, 2e-3));
+        }
+    }
+}
+
+#[test]
+fn builtin_library_is_listed_cheaply() {
+    let all = builtin();
+    assert!(all.len() >= 40);
+    for section in crate::presets::Section::ALL {
+        let count = all.iter().filter(|p| section.contains(&p.info)).count();
+        if matches!(section, crate::presets::Section::Category(_)) {
+            assert!(count >= 5, "{section:?}");
+        }
+    }
+    let ids: std::collections::HashSet<_> = all.iter().map(|p| &p.info.id).collect();
+    assert_eq!(ids.len(), all.len());
+    assert!(all.iter().all(|p| p.info.license == "CC0-1.0"));
+}
+
+#[test]
+fn previews_draw_every_builtin_preset() {
+    let mut segments = Vec::new();
+    for preset in builtin().iter().take(48) {
+        let preview = crate::presets::Preview::new(preset).unwrap();
+        preview.segments(preview.duration() * 0.5, &mut segments);
+        assert_eq!(segments.len(), preview.skeleton().len());
+        assert!(segments.iter().all(|[a, b]| a.is_finite() && b.is_finite()));
+    }
+}
diff --git a/crates/bones-core/src/presets/create.rs b/crates/bones-core/src/presets/create.rs
new file mode 100644
index 0000000..1a5d6d6
--- /dev/null
+++ b/crates/bones-core/src/presets/create.rs
@@ -0,0 +1,161 @@
+//! Création de préréglages utilisateur : à partir de l'animation du projet
+//! (intervalle d'images, éventuellement une partie des os), enregistrée
+//! avec son squelette pour être reciblée plus tard ; ou générateur
+//! procédural avec des paramètres personnalisés.
+
+use super::error::PresetError;
+use super::model::{Category, KeyframeData, Preset, PresetInfo, PresetKind, PresetSource, Procedural, new_id};
+use super::params::Params;
+use super::procedural::Generator;
+use super::roles::{RoleMap, detect};
+use crate::project::unix_now;
+use crate::{BoneId, Clip, Pose, Skeleton};
+
+/// Description d'un préréglage à créer.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CreateOptions {
+    pub name: String,
+    pub category: Category,
+    pub group: String,
+    pub tags: Vec<String>,
+    pub description: String,
+    pub author: String,
+    pub license: String,
+    /// Intervalle d'images [first, last] de l'animation.
+    pub first: u32,
+    pub last: u32,
+    /// Os à enregistrer (vide : tous).
+    pub bones: Vec<BoneId>,
+    pub looping: bool,
+    /// Rôles corrigés à la main (sinon détection automatique).
+    pub roles: Option<RoleMap>,
+}
+
+impl Default for CreateOptions {
+    fn default() -> Self {
+        Self {
+            name: "My Preset".into(),
+            category: Category::Human,
+            group: String::new(),
+            tags: Vec::new(),
+            description: String::new(),
+            author: String::new(),
+            license: "CC0-1.0".into(),
+            first: 0,
+            last: u32::MAX,
+            bones: Vec::new(),
+            looping: false,
+            roles: None,
+        }
+    }
+}
+
+fn info(options: &CreateOptions, roles: &RoleMap) -> PresetInfo {
+    let now = unix_now();
+    PresetInfo {
+        id: new_id("user"),
+        name: crate::project::store::sanitize_name(&options.name),
+        category: options.category,
+        group: options.group.trim().to_owned(),
+        tags: options.tags.iter().map(|t| t.trim().to_owned()).filter(|t| !t.is_empty()).collect(),
+        description: options.description.clone(),
+        author: options.author.clone(),
+        license: options.license.clone(),
+        source: PresetSource::User,
+        rig_type: roles.rig_type,
+        looping: options.looping,
+        created: now,
+        modified: now,
+        ..PresetInfo::default()
+    }
+}
+
+/// Préréglage à clés tiré de l'animation `clip` du squelette `skeleton`.
+pub fn from_animation(skeleton: &Skeleton, clip: &Clip, options: &CreateOptions) -> Result<Preset, PresetError> {
+    if skeleton.is_empty() {
+        return Err(PresetError::Empty("the model has no skeleton".into()));
+    }
+    if clip.is_empty() {
+        return Err(PresetError::Empty("the animation has no keys".into()));
+    }
+    let last = options.last.min(clip.frame_count.saturating_sub(1));
+    let first = options.first.min(last);
+    if last <= first {
+        return Err(PresetError::Empty("choose at least two frames".into()));
+    }
+    // Clés de l'intervalle, plus les bornes échantillonnées : le clip est
+    // autonome et commence à l'image 0.
+    let mut out = Clip::new(clip.fps, last - first + 1);
+    for f in [first, last] {
+        let mut pose = Pose::rest(skeleton);
+        clip.sample_into(f as f32, &mut pose);
+        out.set_key(f - first, pose);
+    }
+    for key in clip.keys().iter().filter(|k| k.frame > first && k.frame < last) {
+        out.set_key(key.frame - first, key.pose.clone());
+    }
+    for key in clip.keys() {
+        if key.frame >= first
+            && key.frame <= last
+            && let Some(k) = out.key_at_mut(key.frame - first)
+        {
+            k.interpolation = key.interpolation;
+        }
+    }
+    out.sync_len(skeleton);
+    let roles = options.roles.clone().filter(|r| r.fits(skeleton)).unwrap_or_else(|| detect(skeleton));
+    let mut info = info(options, &roles);
+    info.fps = clip.fps;
+    info.frames = last - first;
+    info.bones = skeleton.len() as u32;
+    let bones: Vec<BoneId> = options.bones.iter().copied().filter(|b| skeleton.contains(*b)).collect();
+    let data = KeyframeData {
+        skeleton: skeleton.clone(),
+        roles,
+        clip: out,
+        bones,
+    };
+    info.root_motion = travel(&data) > 0.01 * data.roles.frame.size.max(1e-3);
+    Ok(Preset {
+        info,
+        kind: PresetKind::Keyframes(Box::new(data)),
+    })
+}
+
+/// Déplacement horizontal du bassin entre la première et la dernière clé.
+pub(crate) fn travel(data: &KeyframeData) -> f32 {
+    let s = &data.skeleton;
+    let root = data.roles.root().unwrap_or(BoneId(0));
+    let at = |frame: f32| {
+        let mut pose = Pose::rest(s);
+        data.clip.sample_into(frame, &mut pose);
+        pose.world(s)[root.index()].translation
+    };
+    let last = data.clip.keys().last().map_or(0, |k| k.frame) as f32;
+    let d = at(last) - at(0.0);
+    let up = data.roles.frame.up;
+    (d - up * d.dot(up)).length()
+}
+
+/// Préréglage procédural aux paramètres personnalisés.
+pub fn procedural(generator: Generator, params: Params, options: &CreateOptions) -> Preset {
+    let p = Procedural {
+        generator,
+        params,
+        reference: None,
+    };
+    let skeleton = p.reference().skeleton();
+    let roles = detect(&skeleton);
+    let mut info = info(options, &roles);
+    let (frames, root_motion) = super::library::measure(&p);
+    info.rig_type = generator.rig_type();
+    info.fps = 30.0;
+    info.frames = frames;
+    info.root_motion = root_motion;
+    info.looping = generator.looping();
+    info.procedural = true;
+    Preset {
+        info,
+        kind: PresetKind::Procedural(p),
+    }
+}
