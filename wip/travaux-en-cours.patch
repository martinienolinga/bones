 }
+
+#[test]
+fn unrecognized_parts_keep_the_generic_layout() {
+    // Une « pilule » sans bras ni jambes : seul le tronc peut être recentré.
+    let blob = Mesh::capsule(Vec3::new(0.0, 0.3, 0.0), Vec3::new(0.0, 1.5, 0.0), 0.3, 24, 24);
