diff --git a/crates/bones-core/src/presets/model.rs b/crates/bones-core/src/presets/model.rs
new file mode 100644
index 0000000..dd8b4e5
--- /dev/null
+++ b/crates/bones-core/src/presets/model.rs
@@ -0,0 +1,225 @@
+//! Modèle de données d'un préréglage : fiche descriptive (lisible seule,
+//! pour la galerie) et contenu (clés sur un squelette source, ou générateur
+//! procédural et ses paramètres).
+
+use serde::{Deserialize, Serialize};
+
+use super::Generator;
+use super::params::Params;
+use super::reference::RefRig;
+use super::roles::{RigType, RoleMap};
+use crate::{BoneId, Clip, Skeleton};
+
+/// Catégorie de contenu (rayon de la galerie).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum Category {
+    Human,
+    Animals,
+    Vegetation,
+    /// Créatures et objets : queues, tentacules, cordes, pendules, machines.
+    Misc,
+}
+
+impl Category {
+    pub const ALL: [Category; 4] = [Category::Human, Category::Animals, Category::Vegetation, Category::Misc];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Category::Human => "Human",
+            Category::Animals => "Animals",
+            Category::Vegetation => "Vegetation",
+            Category::Misc => "Creatures & Misc",
+        }
+    }
+
+    /// Catégorie par défaut d'un type de rig (préréglages importés).
+    pub fn for_rig(rig: RigType) -> Category {
+        match rig {
+            RigType::Humanoid => Category::Human,
+            RigType::Quadruped | RigType::Bird | RigType::Fish | RigType::Serpent | RigType::MultiLegged => {
+                Category::Animals
+            }
+            RigType::Plant => Category::Vegetation,
+            RigType::Chain | RigType::Any => Category::Misc,
+        }
+    }
+}
+
+/// Provenance d'un préréglage.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "type")]
+pub enum PresetSource {
+    /// Livré avec l'application.
+    Builtin,
+    /// Créé par l'utilisateur.
+    User,
+    /// Importé d'un autre logiciel ; `format` : « BVH », « glTF », « FBX »…
+    Imported { format: String },
+}
+
+/// Fiche d'un préréglage : tout ce que la galerie affiche, sans le contenu.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct PresetInfo {
+    /// Identifiant stable (`builtin.human.walk`, `user.…`).
+    pub id: String,
+    pub name: String,
+    pub category: Category,
+    /// Sous-catégorie libre : « Locomotion », « Quadrupeds », « Trees »…
+    pub group: String,
+    pub tags: Vec<String>,
+    pub description: String,
+    pub author: String,
+    /// Licence (identifiant SPDX quand il existe : `CC0-1.0`, `CC-BY-4.0`…).
+    pub license: String,
+    pub source: PresetSource,
+    /// Famille de squelette visée.
+    pub rig_type: RigType,
+    pub fps: f32,
+    /// Durée en images (d'un cycle pour une boucle).
+    pub frames: u32,
+    pub looping: bool,
+    /// Le mouvement déplace le personnage (marche, saut en longueur…).
+    pub root_motion: bool,
+    pub procedural: bool,
+    /// Os du squelette source (0 pour un préréglage procédural).
+    pub bones: u32,
+    /// Secondes Unix (UTC).
+    pub created: u64,
+    pub modified: u64,
+}
+
+impl Default for PresetInfo {
+    fn default() -> Self {
+        Self {
+            id: String::new(),
+            name: "Untitled".into(),
+            category: Category::Misc,
+            group: String::new(),
+            tags: Vec::new(),
+            description: String::new(),
+            author: String::new(),
+            license: String::new(),
+            source: PresetSource::User,
+            rig_type: RigType::Any,
+            fps: 30.0,
+            frames: 0,
+            looping: false,
+            root_motion: false,
+            procedural: false,
+            bones: 0,
+            created: 0,
+            modified: 0,
+        }
+    }
+}
+
+impl PresetInfo {
+    /// Durée en secondes.
+    pub fn duration(&self) -> f32 {
+        self.frames as f32 / self.fps.max(1.0)
+    }
+
+    /// Le texte apparaît dans le nom, le groupe, les étiquettes ou la description.
+    pub fn matches(&self, query: &str) -> bool {
+        let q = query.trim().to_lowercase();
+        q.is_empty()
+            || [&self.name, &self.group, &self.description]
+                .iter()
+                .any(|s| s.to_lowercase().contains(&q))
+            || self.tags.iter().any(|t| t.to_lowercase().contains(&q))
+    }
+}
+
+/// Animation par clés, conçue sur un squelette source.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct KeyframeData {
+    pub skeleton: Skeleton,
+    /// Rôles des os source (détectés, éventuellement corrigés).
+    pub roles: RoleMap,
+    pub clip: Clip,
+    /// Os animés ; vide : tous. Les autres gardent leur pose à l'application.
+    #[serde(default)]
+    pub bones: Vec<BoneId>,
+}
+
+/// Générateur et paramètres.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Procedural {
+    pub generator: Generator,
+    #[serde(default)]
+    pub params: Params,
+    /// Squelette d'aperçu (par défaut celui du générateur).
+    #[serde(default)]
+    pub reference: Option<RefRig>,
+}
+
+impl Procedural {
+    pub fn reference(&self) -> RefRig {
+        self.reference.unwrap_or(self.generator.reference())
+    }
+}
+
+/// Contenu d'un préréglage.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub enum PresetKind {
+    Keyframes(Box<KeyframeData>),
+    Procedural(Procedural),
+}
+
+/// Préréglage complet.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Preset {
+    pub info: PresetInfo,
+    pub kind: PresetKind,
+}
+
+/// Section de la galerie.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Section {
+    Category(Category),
+    /// Préréglages créés par l'utilisateur.
+    MyPresets,
+    /// Préréglages importés d'autres logiciels.
+    Imported,
+}
+
+impl Section {
+    pub const ALL: [Section; 6] = [
+        Section::Category(Category::Human),
+        Section::Category(Category::Animals),
+        Section::Category(Category::Vegetation),
+        Section::Category(Category::Misc),
+        Section::MyPresets,
+        Section::Imported,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Section::Category(c) => c.label(),
+            Section::MyPresets => "My Presets",
+            Section::Imported => "Imported",
+        }
+    }
+
+    /// Le préréglage apparaît dans cette section (un préréglage utilisateur
+    /// apparaît aussi dans sa catégorie).
+    pub fn contains(self, info: &PresetInfo) -> bool {
+        match self {
+            Section::Category(c) => info.category == c && !matches!(info.source, PresetSource::Imported { .. }),
+            Section::MyPresets => info.source == PresetSource::User,
+            Section::Imported => matches!(info.source, PresetSource::Imported { .. }),
+        }
+    }
+}
+
+/// Identifiant unique pour un nouveau préréglage (heure et compteur).
+pub fn new_id(prefix: &str) -> String {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static COUNTER: AtomicU32 = AtomicU32::new(0);
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_nanos());
+    let n = COUNTER.fetch_add(1, Ordering::Relaxed);
+    format!("{prefix}.{nanos:x}{n:04x}")
+}
diff --git a/crates/bones-core/src/presets/params.rs b/crates/bones-core/src/presets/params.rs
new file mode 100644
index 0000000..dc6b029
--- /dev/null
+++ b/crates/bones-core/src/presets/params.rs
@@ -0,0 +1,94 @@
+//! Paramètres des générateurs procéduraux : valeurs nommées, bornées par
+//! leur description ([`ParamSpec`]) pour que l'interface affiche des
+//! curseurs et qu'un fichier reçu ne puisse pas imposer de valeur absurde.
+
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Serialize};
+
+/// Description d'un paramètre (curseur de l'interface).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ParamSpec {
+    pub key: &'static str,
+    /// Nom affiché (anglais).
+    pub label: &'static str,
+    pub min: f32,
+    pub max: f32,
+    pub default: f32,
+    /// Pas du curseur (1 pour un entier ou une bascule 0/1, 0 si continu).
+    pub step: f32,
+}
+
+impl ParamSpec {
+    pub const fn new(key: &'static str, label: &'static str, min: f32, max: f32, default: f32) -> Self {
+        Self {
+            key,
+            label,
+            min,
+            max,
+            default,
+            step: 0.0,
+        }
+    }
+
+    /// Bascule 0/1.
+    pub const fn toggle(key: &'static str, label: &'static str, default: bool) -> Self {
+        Self {
+            key,
+            label,
+            min: 0.0,
+            max: 1.0,
+            default: if default { 1.0 } else { 0.0 },
+            step: 1.0,
+        }
+    }
+
+    /// Valeur ramenée dans les bornes (valeur par défaut si non finie).
+    pub fn clamp(&self, v: f32) -> f32 {
+        if !v.is_finite() {
+            return self.default;
+        }
+        let v = v.clamp(self.min, self.max);
+        if self.step > 0.0 { (v / self.step).round() * self.step } else { v }
+    }
+}
+
+/// Valeurs choisies ; un paramètre absent prend sa valeur par défaut.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(transparent)]
+pub struct Params(pub BTreeMap<String, f32>);
+
+impl Params {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Construit à partir de paires (clé, valeur).
+    pub fn of(values: &[(&str, f32)]) -> Self {
+        Self(values.iter().map(|(k, v)| ((*k).to_owned(), *v)).collect())
+    }
+
+    pub fn set(&mut self, key: &str, value: f32) {
+        self.0.insert(key.to_owned(), value);
+    }
+
+    /// Recouvre ces valeurs par celles de `other`.
+    pub fn merged(&self, other: &Params) -> Params {
+        let mut out = self.clone();
+        out.0.extend(other.0.iter().map(|(k, v)| (k.clone(), *v)));
+        out
+    }
+
+    /// Valeur d'un paramètre décrit dans `specs` (bornée).
+    pub fn get(&self, specs: &[ParamSpec], key: &str) -> f32 {
+        let Some(spec) = specs.iter().find(|s| s.key == key) else {
+            debug_assert!(false, "paramètre inconnu : {key}");
+            return 0.0;
+        };
+        self.0.get(key).map_or(spec.default, |v| spec.clamp(*v))
+    }
+
+    pub fn flag(&self, specs: &[ParamSpec], key: &str) -> bool {
+        self.get(specs, key) >= 0.5
+    }
+}
diff --git a/crates/bones-core/src/presets/preview.rs b/crates/bones-core/src/presets/preview.rs
new file mode 100644
index 0000000..5086b8b
--- /dev/null
+++ b/crates/bones-core/src/presets/preview.rs
@@ -0,0 +1,98 @@
+//! Aperçu animé pour la galerie : le préréglage est cuit une fois sur son
+//! squelette (référence pour un générateur, squelette source pour des
+//! clés), sur place ; l'interface dessine ensuite les os en bâtons à
+//! n'importe quel instant, sans toucher au projet.
+
+use glam::Vec3;
+
+use super::apply::{ApplyOptions, bake_preset};
+use super::error::PresetError;
+use super::model::{Preset, PresetKind};
+use super::roles::{Lr, RoleMap, detect};
+use crate::{Clip, Pose, Skeleton, head_tail};
+
+/// Aperçu d'un préréglage (léger : quelques centaines de poses au plus).
+pub struct Preview {
+    skeleton: Skeleton,
+    roles: RoleMap,
+    clip: Clip,
+    looping: bool,
+    lo: Vec3,
+    hi: Vec3,
+}
+
+impl Preview {
+    /// Cuisson à 30 images/s, déplacement du corps retiré.
+    pub fn new(preset: &Preset) -> Result<Self, PresetError> {
+        let (skeleton, roles) = match &preset.kind {
+            PresetKind::Procedural(p) => {
+                let s = p.reference().skeleton();
+                let r = detect(&s);
+                (s, r)
+            }
+            PresetKind::Keyframes(data) => (data.skeleton.clone(), data.roles.clone()),
+        };
+        let options = ApplyOptions {
+            in_place: true,
+            ..ApplyOptions::default()
+        };
+        let base = Pose::rest(&skeleton);
+        let (poses, _) = bake_preset(preset, &skeleton, &roles, &base, &options, 30.0)?;
+        let mut clip = Clip::new(30.0, poses.len().max(2) as u32);
+        let (mut lo, mut hi) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
+        for (f, pose) in poses.into_iter().enumerate() {
+            for (w, b) in pose.world(&skeleton).iter().zip(skeleton.bones()) {
+                let (h, t) = head_tail(w, b.length);
+                lo = lo.min(h.min(t));
+                hi = hi.max(h.max(t));
+            }
+            clip.set_key(f as u32, pose);
+        }
+        Ok(Self {
+            skeleton,
+            roles,
+            clip,
+            looping: preset.info.looping,
+            lo,
+            hi,
+        })
+    }
+
+    /// Durée d'un cycle (ou de l'action), en secondes.
+    pub fn duration(&self) -> f32 {
+        self.clip.frame_count.saturating_sub(1) as f32 / self.clip.fps
+    }
+
+    pub fn skeleton(&self) -> &Skeleton {
+        &self.skeleton
+    }
+
+    /// Boîte englobant tout le mouvement (cadrage de la vignette).
+    pub fn bounds(&self) -> (Vec3, Vec3) {
+        (self.lo, self.hi)
+    }
+
+    /// Côté de chaque os (couleurs gauche/droite du dessin).
+    pub fn sides(&self) -> Vec<Option<Lr>> {
+        self.roles.roles.iter().map(|r| r.and_then(|r| r.chain.side())).collect()
+    }
+
+    /// Segments (tête, queue) monde de chaque os à l'instant `time`
+    /// (secondes ; boucle si le préréglage boucle, sinon reste sur la fin).
+    pub fn segments(&self, time: f32, out: &mut Vec<[Vec3; 2]>) {
+        let d = self.duration().max(1e-3);
+        let t = if self.looping { time.rem_euclid(d) } else { time.clamp(0.0, d) };
+        let mut pose = Pose::rest(&self.skeleton);
+        self.clip.sample_into(t * self.clip.fps, &mut pose);
+        out.clear();
+        out.extend(
+            pose.world(&self.skeleton)
+                .iter()
+                .zip(self.skeleton.bones())
+                .map(|(w, b)| {
+                    let (h, t) = head_tail(w, b.length);
+                    [h, t]
+                }),
+        );
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/bird.rs b/crates/bones-core/src/presets/procedural/animal/bird.rs
new file mode 100644
index 0000000..48c91bf
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/bird.rs
@@ -0,0 +1,240 @@
+//! Oiseaux : battement d'ailes (l'aile se replie à la remontée, le corps
+//! monte à chaque abaissée), vol plané (inclinaison en virage), sautillement,
+//! picorage. La tête reste stabilisée comme chez les vrais oiseaux.
+
+use glam::Vec3;
+
+use super::quadruped::Quad;
+use crate::BoneId;
+use crate::anim::physics::GRAVITY;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, bump, cwave, hermite, minjerk, noise, smooth, wave};
+use crate::presets::roles::{Chain, Lr};
+
+pub(crate) const FLAP: &[ParamSpec] = &[
+    ParamSpec::new("rate", "Wingbeats per second", 0.5, 12.0, 3.0),
+    ParamSpec::new("amplitude", "Amplitude", 0.2, 1.5, 1.0),
+    ParamSpec::new("speed", "Flight speed (m/s)", 0.0, 20.0, 0.0),
+];
+
+pub(crate) const GLIDE: &[ParamSpec] = &[
+    ParamSpec::new("bank", "Banking", 0.0, 2.0, 1.0),
+    ParamSpec::new("speed", "Flight speed (m/s)", 0.0, 20.0, 0.0),
+];
+
+pub(crate) const HOP: &[ParamSpec] = &[
+    ParamSpec::new("height", "Hop height (m)", 0.01, 0.3, 0.05),
+    ParamSpec::new("distance", "Hop distance (m)", 0.0, 0.5, 0.1),
+];
+
+pub(crate) const PECK: &[ParamSpec] = &[ParamSpec::new("rate", "Pecks per second", 0.5, 4.0, 1.5)];
+
+/// Ailes : chaînes des membres antérieurs.
+fn wings(rig: &Rigging) -> Result<[Vec<BoneId>; 2], PresetError> {
+    let w = [rig.chain(Chain::Arm(Lr::Left)), rig.chain(Chain::Arm(Lr::Right))];
+    if w.iter().any(|c| c.is_empty()) {
+        return Err(incompatible("wings not found"));
+    }
+    Ok(w)
+}
+
+/// Pose une aile : élévation (vers le haut), balayage vers l'arrière et
+/// repli en Z (0 : déployée, 1 : repliée le long du corps — humérus vers
+/// l'arrière, avant-bras vers l'avant, main vers l'arrière).
+fn wing(body: &mut Body, bones: &[BoneId], side: Lr, elevation: f32, sweep: f32, fold: f32) {
+    let s = side.sign();
+    for (i, b) in bones.iter().enumerate() {
+        let (e, f) = match i {
+            0 => (elevation, sweep + fold),
+            1 => (-0.35 * elevation, -2.6 * fold),
+            _ => (-0.25 * elevation, 2.7 * fold),
+        };
+        body.turn(Some(*b), Vec3::Z, s * e);
+        body.turn(Some(*b), Vec3::Y, s * f);
+    }
+}
+
+/// Pattes ramenées vers l'arrière sous la queue (en vol).
+fn tuck_legs(body: &mut Body, q: &Quad) {
+    for limb in q.limbs.iter().filter(|l| !l.front) {
+        let angles = [0.5, 1.2, 0.3, 0.5];
+        for (b, a) in limb.chain.iter().zip(angles) {
+            body.turn(Some(*b), Vec3::X, a);
+        }
+    }
+}
+
+pub(crate) struct Flap<'r, 'a> {
+    q: Quad<'r, 'a>,
+    wings: [Vec<BoneId>; 2],
+    rate: f32,
+    amplitude: f32,
+    speed: f32,
+    glide: bool,
+    bank: f32,
+}
+
+impl<'r, 'a> Flap<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params, glide: bool) -> Result<Self, PresetError> {
+        let specs = if glide { GLIDE } else { FLAP };
+        Ok(Self {
+            q: Quad::new(rig, 0)?,
+            wings: wings(rig)?,
+            rate: if glide { 0.25 } else { p.get(FLAP, "rate") },
+            amplitude: if glide { 0.0 } else { p.get(FLAP, "amplitude") },
+            speed: p.get(specs, "speed"),
+            glide,
+            bank: if glide { p.get(GLIDE, "bank") } else { 0.0 },
+        })
+    }
+}
+
+impl Motion for Flap<'_, '_> {
+    fn duration(&self) -> f32 {
+        1.0 / self.rate
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        let h = q.height;
+        body.reset();
+        let travel = self.speed * self.duration() * u;
+        if self.glide {
+            // Virage incliné lent, ailes tendues qui frémissent.
+            let roll = 0.35 * self.bank * wave(u);
+            body.pelvis(q.root, Vec3::new(0.0, 0.03 * h * cwave(2.0 * u), travel), 0.1 * roll, -0.05, roll);
+            for (bones, side) in self.wings.iter().zip(Lr::BOTH) {
+                let lift = 0.12 + 0.04 * noise(u, side as u32, &[3, 5]) + 0.08 * side.sign() * roll;
+                wing(body, bones, side, lift, 0.05, 0.0);
+            }
+            body.ripple(&q.tail, Vec3::Y, 0.15 * roll, 0.25, 0.0);
+        } else {
+            // Abaissée sur la première moitié, remontée aile repliée.
+            let a = self.amplitude;
+            let elevation = a * (0.25 + 0.75 * cwave(u));
+            let fold = a * 0.35 * bump((u.rem_euclid(1.0) - 0.5).max(0.0) * 2.0, 0.5);
+            let lift = 0.06 * h * a * wave(u - 0.1);
+            body.pelvis(q.root, Vec3::new(0.0, lift, travel), 0.0, -0.1 - 0.05 * wave(u), 0.0);
+            for (bones, side) in self.wings.iter().zip(Lr::BOTH) {
+                wing(body, bones, side, elevation, 0.2 * a * wave(u), fold);
+            }
+            body.ripple(&q.tail, Vec3::X, 0.1 * a, u, 0.2);
+        }
+        tuck_legs(body, q);
+        body.fk();
+        body.look(&q.neck, q.head, 0.0, 0.0, 0.0);
+    }
+}
+
+pub(crate) struct Hop<'r, 'a> {
+    q: Quad<'r, 'a>,
+    wings: Vec<Vec<BoneId>>,
+    height: f32,
+    distance: f32,
+}
+
+impl<'r, 'a> Hop<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            q: Quad::new(rig, 2)?,
+            wings: wings(rig).map(Vec::from).unwrap_or_default(),
+            height: p.get(HOP, "height"),
+            distance: p.get(HOP, "distance"),
+        })
+    }
+
+    fn flight(&self) -> f32 {
+        2.0 * (2.0 * self.height / GRAVITY).sqrt()
+    }
+}
+
+impl Motion for Hop<'_, '_> {
+    /// Accroupi 0,2 s, vol balistique, réception 0,25 s.
+    fn duration(&self) -> f32 {
+        0.45 + self.flight()
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        let h = q.height;
+        let t = u.rem_euclid(1.0) * self.duration();
+        let k = u.floor();
+        let fl = self.flight();
+        let v0 = GRAVITY * fl * 0.5;
+        let crouch = 0.25 * h;
+        let (y, x) = if t < 0.2 {
+            (hermite(0.0, 0.0, -crouch, 0.0, t, 0.2), 0.0)
+        } else if t < 0.2 + fl {
+            let s = t - 0.2;
+            let p = s / fl;
+            (-crouch * (1.0 - smooth(p * 4.0)) + v0 * s - 0.5 * GRAVITY * s * s, self.distance * minjerk(p))
+        } else {
+            let s = t - 0.2 - fl;
+            (-crouch * 0.6 * bump(s / 0.25, 0.4), self.distance)
+        };
+        let travel = self.distance * k + x;
+        body.reset();
+        body.pelvis(q.root, Vec3::new(0.0, y, travel), 0.0, 0.15 * bump(t / (0.4 + fl), 0.3), 0.0);
+        let open = if t > 0.15 && t < 0.25 + fl { bump((t - 0.15) / (0.1 + fl), 0.5) } else { 0.0 };
+        for (bones, side) in self.wings.iter().zip(Lr::BOTH) {
+            wing(body, bones, side, -0.2 + 0.8 * open, 0.4 * (1.0 - open), 1.0 - 0.8 * open);
+        }
+        body.fk();
+        let lift = if t > 0.2 && t < 0.2 + fl { (y + crouch).max(0.0) * 0.8 } else { 0.0 };
+        for limb in q.limbs.iter().filter(|l| !l.front) {
+            let step = self.distance * k + if t < 0.2 { 0.0 } else { x };
+            let paw = limb.contact + q.rig.w(Vec3::new(0.0, 0.0, step)) + q.rig.frame.up * lift;
+            limb.place(body, paw, q.flex(0.0), 1.0);
+        }
+        body.look(&q.neck, q.head, 0.0, 0.0, 0.0);
+    }
+}
+
+pub(crate) struct Peck<'r, 'a> {
+    q: Quad<'r, 'a>,
+    wings: Vec<Vec<BoneId>>,
+    rate: f32,
+    dip: Curve,
+}
+
+impl<'r, 'a> Peck<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            q: Quad::new(rig, 2)?,
+            wings: wings(rig).map(Vec::from).unwrap_or_default(),
+            rate: p.get(PECK, "rate"),
+            // Deux coups rapides puis la tête se relève et observe.
+            dip: Curve::new(&[(0.0, 0.0), (0.12, 1.0), (0.2, 0.75), (0.3, 1.0), (0.42, 0.0), (1.0, 0.0)]),
+        })
+    }
+}
+
+impl Motion for Peck<'_, '_> {
+    fn duration(&self) -> f32 {
+        2.0 / self.rate
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        let d = self.dip.at(u.rem_euclid(1.0));
+        let h = q.height;
+        body.reset();
+        body.pelvis(q.root, Vec3::new(0.0, -0.15 * h * d, 0.0), 0.0, 0.5 * d, 0.0);
+        body.spread(&q.spine, 0.3 * d, 0.0, 0.0);
+        body.spread(&q.neck, 2.1 * d, 0.0, 0.0);
+        for (bones, side) in self.wings.iter().zip(Lr::BOTH) {
+            wing(body, bones, side, -0.2, 0.4, 1.0);
+        }
+        body.ripple(&q.tail, Vec3::X, -0.3 * d, 0.25, 0.0);
+        body.fk();
+        for limb in q.limbs.iter().filter(|l| !l.front) {
+            limb.place(body, limb.contact, q.flex(0.0), 1.0);
+        }
+        // Entre deux coups, la tête tourne pour regarder d'un œil.
+        let glance = 0.4 * noise(u, 4, &[1]) * (1.0 - d);
+        body.look(&[], q.head, 1.3 * d, glance, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/crawl.rs b/crates/bones-core/src/presets/procedural/animal/crawl.rs
new file mode 100644
index 0000000..a75e93a
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/crawl.rs
@@ -0,0 +1,137 @@
+//! Marche des animaux à plus de quatre pattes (insectes, araignées) :
+//! tripode alterné à six pattes, tétrapode alterné à huit (Wilson 1966).
+//! Chaque patte : rotation de la hanche autour de la verticale vers l'appui,
+//! IK à deux os fémur–tibia genou en haut, segments distaux gardant leur
+//! orientation de repos.
+
+use glam::{Quat, Vec3};
+
+use crate::BoneId;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{bump, cwave, minjerk, wave};
+use crate::presets::roles::{Chain, Lr};
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed (m/s)", 0.01, 3.0, 0.12),
+    ParamSpec::new("stride", "Stride length", 0.5, 1.5, 1.0),
+    ParamSpec::new("lift", "Leg lift", 0.0, 2.0, 1.0),
+];
+
+struct Leg {
+    bones: Vec<BoneId>,
+    phase: f32,
+    contact: Vec3,
+    reach: f32,
+}
+
+pub(crate) struct Crawl<'r, 'a> {
+    rig: &'r Rigging<'a>,
+    root: BoneId,
+    abdomen: Vec<BoneId>,
+    head: Option<BoneId>,
+    legs: Vec<Leg>,
+    stride: f32,
+    period: f32,
+    duty: f32,
+    lift: f32,
+}
+
+impl<'r, 'a> Crawl<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let root = rig.bone(Chain::Root, 0).ok_or_else(|| incompatible("no body bone"))?;
+        let mut legs = Vec::new();
+        for chain in rig.roles.chains() {
+            if let Chain::LegPair(pair, side) = chain {
+                let bones = rig.chain(chain);
+                let Some(&last) = bones.last() else { continue };
+                let contact = rig.tail(last);
+                let flat = |v: Vec3| v - rig.frame.up * v.dot(rig.frame.up);
+                let reach = flat(contact - rig.head(bones[0])).length().max(1e-3);
+                let phase = ((pair as usize + (side == Lr::Right) as usize) % 2) as f32 * 0.5;
+                legs.push(Leg { bones, phase, contact, reach });
+            }
+        }
+        if legs.len() < 6 {
+            return Err(incompatible("at least six legs needed"));
+        }
+        let reach = legs.iter().map(|l| l.reach).sum::<f32>() / legs.len() as f32;
+        let stride = 0.7 * reach * p.get(PARAMS, "stride");
+        Ok(Self {
+            rig,
+            root,
+            abdomen: rig.chain(Chain::Spine),
+            head: rig.bone(Chain::Head, 0),
+            stride,
+            period: stride / p.get(PARAMS, "speed"),
+            duty: 0.55,
+            lift: 0.35 * reach * p.get(PARAMS, "lift"),
+            legs,
+        })
+    }
+
+    fn foot(&self, leg: &Leg, u: f32) -> Vec3 {
+        let q = u - leg.phase;
+        let k = q.floor();
+        let phi = q - k;
+        let forward = self.rig.w(Vec3::Z);
+        let at = |k: f32| leg.contact + forward * self.stride * (k + self.duty * 0.5 + leg.phase);
+        if phi < self.duty {
+            at(k)
+        } else {
+            let w = (phi - self.duty) / (1.0 - self.duty);
+            at(k).lerp(at(k + 1.0), minjerk(w)) + self.rig.frame.up * self.lift * bump(w, 0.45)
+        }
+    }
+
+    fn place(&self, body: &mut Body, leg: &Leg, target: Vec3) {
+        let rig = self.rig;
+        let up = rig.frame.up;
+        let b = &leg.bones;
+        let flat = |v: Vec3| (v - up * v.dot(up)).normalize_or(Vec3::Z);
+        let carried = body.rotation(self.root) * rig.rest[self.root.index()].rotation.inverse();
+        match b.len() {
+            1 => body.aim(b[0], target - body.head(b[0])),
+            2 => {
+                let pole = body.head(b[0]) + up * leg.reach;
+                body.two_bone(b[0], b[1], target, pole);
+            }
+            _ => {
+                // Hanche : tournée vers l'appui autour de la verticale.
+                let now = flat(body.tail(b[0]) - body.head(b[0]));
+                let want = flat(target - body.head(b[0]));
+                let angle = now.cross(want).dot(up).atan2(now.dot(want));
+                body.rotate(b[0], Quat::from_axis_angle(up, angle));
+                // Segments distaux : orientation de repos (suivant le corps).
+                let distal: Vec3 = b[3..].iter().map(|d| carried * (rig.tail(*d) - rig.head(*d))).sum();
+                let knee = target - distal;
+                let pole = (body.head(b[1]) + knee) * 0.5 + up * leg.reach;
+                body.two_bone(b[1], b[2], knee, pole);
+                for d in &b[3..] {
+                    body.set_rotation(*d, carried * rig.rest[d.index()].rotation);
+                }
+            }
+        }
+    }
+}
+
+impl Motion for Crawl<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.period
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        body.reset();
+        let bob = 0.04 * self.lift * cwave(2.0 * u);
+        body.pelvis(self.root, Vec3::new(0.0, bob, self.stride * u), 0.03 * wave(u), 0.0, 0.02 * wave(u));
+        body.spread(&self.abdomen, 0.03 * cwave(2.0 * u), -0.06 * wave(u), 0.0);
+        body.fk();
+        for leg in &self.legs {
+            let target = self.foot(leg, u);
+            self.place(body, leg, target);
+        }
+        body.look(&[], self.head, 0.0, 0.0, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/limb.rs b/crates/bones-core/src/presets/procedural/animal/limb.rs
new file mode 100644
index 0000000..4d0f135
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/limb.rs
@@ -0,0 +1,77 @@
+//! Patte d'animal (membre digitigrade) : point d'appui au sol, IK à deux
+//! os sur les segments proximaux, segments distaux (métatarse, doigts)
+//! orientés autour de l'appui.
+
+use glam::{Quat, Vec3};
+
+use crate::BoneId;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::roles::{Chain, Lr};
+
+pub(crate) struct Limb {
+    pub chain: Vec<BoneId>,
+    pub side: Lr,
+    /// Patte avant (bras) ou arrière (jambe).
+    pub front: bool,
+    /// Point d'appui au repos (monde) : bout du troisième segment, ou du
+    /// deuxième pour une patte à deux segments.
+    pub contact: Vec3,
+    /// Sens de flexion de l'articulation intermédiaire au repos (monde).
+    pub bend: Vec3,
+    /// Longueur des deux premiers segments.
+    pub reach: f32,
+}
+
+impl Limb {
+    pub fn new(rig: &Rigging, chain: Chain, side: Lr, front: bool) -> Option<Self> {
+        let bones = rig.chain(chain);
+        if bones.len() < 2 {
+            return None;
+        }
+        let end = bones[2.min(bones.len() - 1)];
+        let contact = rig.tail(end);
+        let (a, b) = (rig.head(bones[0]), rig.head(bones[1]));
+        let c = rig.tail(bones[1]);
+        let axis = (c - a).normalize_or(-rig.frame.up);
+        let off = b - a;
+        let fallback = rig.w(if front { -Vec3::Z } else { Vec3::Z });
+        let bend = (off - axis * off.dot(axis)).try_normalize().unwrap_or(fallback);
+        Some(Self {
+            reach: rig.len(bones[0]) + rig.len(bones[1]),
+            chain: bones,
+            side,
+            front,
+            contact,
+            bend,
+        })
+    }
+
+    /// Repos du point d'attache (tête du premier segment).
+    pub fn attach(&self, rig: &Rigging) -> Vec3 {
+        rig.head(self.chain[0])
+    }
+
+    /// Pose la patte : appui en `paw` (monde), segments distaux tournés de
+    /// `q` (monde) autour de l'appui, doigts à plat selon `toe_flat`.
+    pub fn place(&self, body: &mut Body, paw: Vec3, q: Quat, toe_flat: f32) {
+        let rig = body.rig;
+        let c = &self.chain;
+        let parent = rig.skeleton.bone(c[0]).parent();
+        let carried = parent.map_or(Quat::IDENTITY, |p| body.rotation(p) * rig.rest[p.index()].rotation.inverse());
+        let attach = body.head(c[0]);
+        if c.len() == 2 {
+            let pole = (attach + paw) * 0.5 + carried * self.bend * self.reach;
+            body.two_bone(c[0], c[1], paw, pole);
+            return;
+        }
+        let hock = paw - q * (self.contact - rig.head(c[2]));
+        let pole = (attach + hock) * 0.5 + carried * self.bend * self.reach;
+        body.two_bone(c[0], c[1], hock, pole);
+        body.set_rotation(c[2], q * rig.rest[c[2].index()].rotation);
+        for &toe in &c[3..] {
+            let follow = body.rotation(toe);
+            let flat = rig.rest[toe.index()].rotation;
+            body.set_rotation(toe, follow.slerp(flat, toe_flat.clamp(0.0, 1.0)));
+        }
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/mod.rs b/crates/bones-core/src/presets/procedural/animal/mod.rs
