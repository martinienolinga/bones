+    assert_eq!(by_name(Chain::Leg(Lr::Right)), ["thigh.r", "leg.r", "foot.r", "toes.r"]);
+    assert_eq!(by_name(Chain::Root), ["root.x"]);
+    assert_eq!(by_name(Chain::Head), ["head.x"]);
