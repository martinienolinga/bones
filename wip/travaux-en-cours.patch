+    assert_eq!(by_name(Chain::Leg(Lr::Left)), ["thigh.l", "leg.l", "foot.l", "toes.l"]);
+    assert_eq!(by_name(Chain::Arm(Lr::Right))[..3], ["arm.r", "forearm.r", "hand.r"]);
+    assert_eq!(by_name(Chain::Clavicle(Lr::Left)), ["shoulder.l"]);
