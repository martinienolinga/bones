@@ -0,0 +1,88 @@
+//! Danse simple : pas chassé (« step-touch ») sur quatre temps, rebond des
+//! genoux sur chaque temps, bras pliés qui balancent en alternance, tête
+//! qui marque le rythme.
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, bump, cwave};
+use crate::presets::roles::Lr;
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("bpm", "Tempo (BPM)", 70.0, 160.0, 116.0),
+    ParamSpec::new("step", "Step width (m)", 0.1, 0.5, 0.3),
+    ParamSpec::new("energy", "Energy", 0.2, 1.5, 1.0),
+];
+
+pub(crate) struct Dance<'r, 'a> {
+    h: Human<'r, 'a>,
+    bpm: f32,
+    step: f32,
+    energy: f32,
+    /// Décalage latéral (en largeurs de pas) des pieds gauche et droit, par temps.
+    feet: [Curve; 2],
+    /// Pas en cours : (début, fin) en temps, pour lever le pied.
+    moves: [[(f32, f32); 2]; 2],
+}
+
+impl<'r, 'a> Dance<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        // Droit dehors (temps 0), gauche rejoint (1), gauche revient (2),
+        // droit revient (3) ; les pas se posent sur les temps.
+        let left = Curve::new(&[(0.0, 0.0), (0.5, 0.0), (1.0, -1.0), (1.5, -1.0), (2.0, 0.0), (4.0, 0.0)]);
+        let right = Curve::new(&[(0.0, -1.0), (2.5, -1.0), (3.0, 0.0), (3.5, 0.0), (4.0, -1.0)]);
+        Ok(Self {
+            h: Human::new(rig)?,
+            bpm: p.get(PARAMS, "bpm"),
+            step: p.get(PARAMS, "step"),
+            energy: p.get(PARAMS, "energy"),
+            feet: [left, right],
+            moves: [[(0.5, 1.0), (1.5, 2.0)], [(2.5, 3.0), (3.5, 4.0)]],
+        })
+    }
+}
+
+impl Motion for Dance<'_, '_> {
+    fn duration(&self) -> f32 {
+        4.0 * 60.0 / self.bpm
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let b = u.rem_euclid(1.0) * 4.0;
+        let e = self.energy;
+        let leg = h.legs[0].length;
+        let x = |i: usize| self.feet[i].at(b) * self.step;
+        let center = (x(0) + x(1)) * 0.5;
+        let bounce = -0.035 * leg * e * (0.5 + 0.5 * cwave(b));
+        let lean = 0.06 * e * cwave(b * 0.5);
+        body.reset();
+        h.pelvis(body, Vec3::new(center, bounce - 0.02 * leg, 0.0), 0.1 * e * cwave(b * 0.5 + 0.25), 0.04, lean);
+        h.bend_spine(body, 0.05, -0.2 * e * cwave(b * 0.5 + 0.25), -0.8 * lean);
+        for side in Lr::BOTH {
+            h.shrug(body, side, 0.06 * e * (0.5 - 0.5 * cwave(b)), 0.0);
+            h.curl(body, side, 0.6);
+        }
+        body.fk();
+        let mut feet = [Foot::default(); 2];
+        for (i, foot) in feet.iter_mut().enumerate() {
+            foot.offset = Vec3::new(x(i), 0.0, 0.0);
+            for (start, end) in self.moves[i] {
+                if b > start && b < end {
+                    foot.lift = 0.07 * leg * bump((b - start) / (end - start), 0.4);
+                }
+            }
+        }
+        h.stand(body, feet);
+        let swing = 0.45 * e * cwave(b * 0.5);
+        for (side, s) in [(Lr::Left, swing), (Lr::Right, -swing)] {
+            h.swing_arm(body, side, 0.35, 0.4 + s, 1.5 - 0.2 * s, 0.2);
+        }
+        h.look(body, 0.07 * e * cwave(b), 0.1 * e * cwave(b * 0.5 + 0.25), -0.5 * lean);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/fight.rs b/crates/bones-core/src/presets/procedural/human/fight.rs
new file mode 100644
index 0000000..0b109ab
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/fight.rs
@@ -0,0 +1,160 @@
+//! Combat : garde de boxe, enchaînement direct du bras avant + direct du
+//! bras arrière, coup de pied de face. La rotation des hanches et du buste
+//! précède celle du bras (chaîne cinétique), le pied arrière pivote.
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, cwave};
+use crate::presets::roles::Lr;
+
+pub(crate) const PUNCH: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed", 0.5, 2.0, 1.0),
+    ParamSpec::new("reach", "Reach", 0.6, 1.0, 0.92),
+];
+
+pub(crate) const KICK: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed", 0.5, 2.0, 1.0),
+    ParamSpec::new("height", "Kick height", 0.3, 1.2, 0.85),
+];
+
+/// Garde : pied gauche devant, bassin tourné, genoux fléchis.
+fn stance(lift: f32) -> [Foot; 2] {
+    [
+        Foot {
+            offset: Vec3::new(0.03, 0.0, 0.17),
+            yaw: -0.35,
+            ..Foot::default()
+        },
+        Foot {
+            offset: Vec3::new(-0.05, 0.0, -0.17),
+            yaw: -0.6,
+            pitch: -lift,
+            lift: 0.0,
+        },
+    ]
+}
+
+/// Impulsion 0 → 1 → 0 : sortie rapide, maintien bref, retour plus lent.
+fn pulse(start: f32, out: f32, hold: f32, back: f32) -> Curve {
+    Curve::new(&[(0.0, 0.0), (start, 0.0), (start + out, 1.0), (start + out + hold, 1.0), (start + out + hold + back, 0.0), (10.0, 0.0)])
+}
+
+pub(crate) struct Punch<'r, 'a> {
+    h: Human<'r, 'a>,
+    speed: f32,
+    reach: f32,
+    jab: Curve,
+    cross: Curve,
+}
+
+impl<'r, 'a> Punch<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            speed: p.get(PUNCH, "speed"),
+            reach: p.get(PUNCH, "reach"),
+            jab: pulse(0.3, 0.12, 0.05, 0.2),
+            cross: pulse(0.95, 0.16, 0.06, 0.28),
+        })
+    }
+}
+
+impl Motion for Punch<'_, '_> {
+    fn duration(&self) -> f32 {
+        2.4 / self.speed
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let t = u.rem_euclid(1.0) * 2.4;
+        let (jab, cross) = (self.jab.at(t), self.cross.at(t));
+        // Les hanches tournent juste avant le bras.
+        let hips = self.cross.at(t + 0.05);
+        let leg = h.legs[0].length;
+        let bounce = 0.008 * leg * cwave(2.0 * u);
+        body.reset();
+        let yaw = -0.4 + 0.65 * hips - 0.08 * jab;
+        h.pelvis(body, Vec3::new(0.0, -0.06 * leg + bounce, 0.03 * leg * hips), yaw, 0.08, 0.0);
+        h.bend_spine(body, 0.08 + 0.05 * hips, 0.25 + 0.3 * hips - 0.15 * jab, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 1.0);
+        }
+        body.fk();
+        let mut feet = stance(0.35 * hips);
+        feet[1].yaw += 0.35 * hips;
+        h.stand(body, feet);
+        for (side, punch) in [(Lr::Left, jab), (Lr::Right, cross)] {
+            let arm = h.arm_of(side).map_or(0.6, |a| a.length);
+            let s = side.sign();
+            h.guard(body, side, Vec3::new(-s * 0.12, 0.02, self.reach) * arm, punch);
+            // Paume vers l'intérieur en garde, poing horizontal à l'impact.
+            let palm = h.rig.w(Vec3::new(-s, 0.0, 0.0)).lerp(-h.rig.frame.up, punch);
+            h.palm_towards(body, side, palm);
+        }
+        h.look(body, 0.12, 0.0, 0.0);
+    }
+}
+
+pub(crate) struct Kick<'r, 'a> {
+    h: Human<'r, 'a>,
+    speed: f32,
+    height: f32,
+    chamber: Curve,
+    extend: Curve,
+}
+
+impl<'r, 'a> Kick<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            speed: p.get(KICK, "speed"),
+            height: p.get(KICK, "height"),
+            chamber: pulse(0.35, 0.3, 0.55, 0.35),
+            extend: pulse(0.68, 0.14, 0.08, 0.2),
+        })
+    }
+}
+
+impl Motion for Kick<'_, '_> {
+    fn duration(&self) -> f32 {
+        2.4 / self.speed
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let t = u.rem_euclid(1.0) * 2.4;
+        let (chamber, extend) = (self.chamber.at(t), self.extend.at(t));
+        let leg = h.legs[0].length;
+        body.reset();
+        let rise = 0.04 * leg * chamber;
+        h.pelvis(body, Vec3::new(0.03 * leg * chamber, -0.06 * leg + rise, 0.0), -0.4 + 0.3 * chamber, 0.08 - 0.15 * extend, 0.0);
+        h.bend_spine(body, 0.08 - 0.25 * extend, 0.25 - 0.15 * chamber, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 1.0);
+        }
+        body.fk();
+        let feet = stance(0.0);
+        h.stand(body, feet);
+        if chamber > 1e-3 {
+            // Pied droit : genou monté (armé), puis jambe tendue vers l'avant.
+            let kick = h.leg_of(Lr::Right);
+            let hip = body.head(kick.thigh);
+            let rest = kick.ankle + h.rig.w(feet[1].offset);
+            let armed = hip + h.rig.w(Vec3::new(0.0, -0.55, 0.3) * leg);
+            let out = hip + h.rig.w(Vec3::new(0.0, -0.95 + self.height, 0.95) * leg);
+            let target = rest.lerp(armed, chamber).lerp(out, extend);
+            h.place_foot(body, Lr::Right, target, -0.5 * chamber, -0.6 * (1.0 - chamber), 0.0);
+        }
+        // Bras droit lancé en arrière pour l'équilibre pendant le coup.
+        let arm = h.arm_of(Lr::Right).map_or(0.6, |a| a.length);
+        h.guard(body, Lr::Left, Vec3::ZERO, 0.0);
+        h.guard(body, Lr::Right, Vec3::new(-0.25, -0.75, -0.2) * arm, extend);
+        h.look(body, 0.1, 0.0, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/gestures.rs b/crates/bones-core/src/presets/procedural/human/gestures.rs
new file mode 100644
index 0000000..68302a3
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/gestures.rs
@@ -0,0 +1,128 @@
+//! Gestes humains : salut de la main, gestes de conversation.
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{noise, wave};
+use crate::presets::roles::Lr;
+
+pub(crate) const WAVE: &[ParamSpec] = &[
+    ParamSpec::new("waves", "Waves per second", 0.5, 3.0, 1.5),
+    ParamSpec::new("amplitude", "Amplitude", 0.2, 2.0, 1.0),
+    ParamSpec::toggle("left", "Left hand", false),
+];
+
+/// Salut : main levée à hauteur de tête, l'avant-bras balance de côté,
+/// paume vers l'avant ; le corps se penche légèrement à l'opposé.
+pub(crate) struct Wave<'r, 'a> {
+    h: Human<'r, 'a>,
+    rate: f32,
+    amplitude: f32,
+    side: Lr,
+}
+
+impl<'r, 'a> Wave<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            rate: p.get(WAVE, "waves"),
+            amplitude: p.get(WAVE, "amplitude"),
+            side: if p.flag(WAVE, "left") { Lr::Left } else { Lr::Right },
+        })
+    }
+}
+
+impl Motion for Wave<'_, '_> {
+    /// Deux allers-retours de la main par cycle.
+    fn duration(&self) -> f32 {
+        2.0 / self.rate
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let (side, other) = (self.side, self.side.mirror());
+        let s = side.sign();
+        body.reset();
+        let size = h.hip_height;
+        let beat = wave(2.0 * u);
+        h.pelvis(body, Vec3::new(-s * 0.02 * size, -0.012 * size, 0.0), 0.0, 0.0, -s * 0.03);
+        h.bend_spine(body, 0.0, s * 0.05, s * 0.06 + 0.01 * beat);
+        h.shrug(body, side, 0.12, 0.05);
+        h.curl(body, side, 0.05);
+        h.curl(body, other, 0.3);
+        body.fk();
+        h.stand(body, [Foot::at(0.0, 0.0), Foot::at(0.0, 0.0)]);
+        let arm = h.arm_of(side).map_or(0.6, |a| a.length);
+        // Main au-dessus de l'épaule, sur le côté ; elle balance latéralement.
+        let hand = Vec3::new(s * (0.22 + 0.28 * self.amplitude * beat), 0.62, 0.12) * arm;
+        let elbow = Vec3::new(s * 0.9, -0.5, 0.0);
+        h.swing_arm(body, other, 0.1, 0.02 * beat, 0.2, 0.1);
+        h.reach_from_shoulder(body, side, hand, elbow, -0.15);
+        h.palm_towards(body, side, h.rig.w(Vec3::Z));
+        h.look(body, -0.05, s * 0.15, -s * 0.08 + 0.02 * beat);
+    }
+}
+
+pub(crate) const TALK: &[ParamSpec] = &[
+    ParamSpec::new("energy", "Energy", 0.2, 2.0, 1.0),
+    ParamSpec::new("duration", "Duration (s)", 2.0, 10.0, 4.0),
+];
+
+/// Conversation : gestes rythmés des deux mains devant le ventre (bruit
+/// périodique), hochements de tête sur les temps forts.
+pub(crate) struct Talk<'r, 'a> {
+    h: Human<'r, 'a>,
+    energy: f32,
+    duration: f32,
+}
+
+impl<'r, 'a> Talk<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            energy: p.get(TALK, "energy"),
+            duration: p.get(TALK, "duration"),
+        })
+    }
+}
+
+impl Motion for Talk<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.duration
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let e = self.energy;
+        body.reset();
+        let size = h.hip_height;
+        let shift = noise(u, 3, &[1, 2]);
+        h.pelvis(body, Vec3::new(0.015 * size * shift, -0.012 * size, 0.0), 0.04 * shift, 0.0, 0.02 * shift);
+        h.bend_spine(body, 0.03 + 0.03 * e * noise(u, 5, &[2, 3]), 0.08 * e * noise(u, 9, &[1, 3]), -0.01 * shift);
+        for side in Lr::BOTH {
+            h.curl(body, side, 0.25);
+        }
+        body.fk();
+        h.stand(body, [Foot::at(0.0, 0.0), Foot::at(0.0, 0.0)]);
+        for (i, side) in Lr::BOTH.into_iter().enumerate() {
+            let s = side.sign();
+            let arm = h.arm_of(side).map_or(0.6, |a| a.length);
+            let seed = 20 + i as u32 * 7;
+            let g = |k: u32, harm: &[u32]| e * noise(u, seed + k, harm);
+            let hand = Vec3::new(
+                s * (0.1 + 0.08 * g(0, &[2, 3])),
+                -0.62 + 0.12 * g(1, &[3, 4, 5]).max(-0.4),
+                0.42 + 0.1 * g(2, &[2, 5]),
+            ) * arm;
+            h.reach_from_shoulder(body, side, hand, Vec3::new(s * 0.5, -1.0, -0.2), 0.1 * g(3, &[3, 4]));
+            h.palm_towards(body, side, h.rig.w(Vec3::new(-s * 0.6, 0.8, 0.2)));
+        }
+        let nod = 0.07 * e * noise(u, 31, &[4, 6, 8]);
+        h.look(body, nod, 0.15 * e * noise(u, 37, &[1, 2]), 0.04 * noise(u, 41, &[2, 3]));
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/idle.rs b/crates/bones-core/src/presets/procedural/human/idle.rs
new file mode 100644
index 0000000..8e8f39b
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/idle.rs
@@ -0,0 +1,139 @@
+//! Attente humaine : respiration et transferts de poids ; regard alentour.
+
+use std::f32::consts::TAU;
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, noise, wave};
+use crate::presets::roles::Lr;
+
+pub(crate) const IDLE: &[ParamSpec] = &[
+    ParamSpec::new("breath", "Breathing", 0.0, 2.0, 1.0),
+    ParamSpec::new("sway", "Weight shift", 0.0, 2.0, 1.0),
+    ParamSpec::new("duration", "Duration (s)", 4.0, 16.0, 8.0),
+];
+
+/// Attente : deux respirations, un transfert de poids d'une jambe sur
+/// l'autre (la jambe libre se relâche), micro-mouvements de la tête.
+pub(crate) struct Idle<'r, 'a> {
+    h: Human<'r, 'a>,
+    breath: f32,
+    sway: f32,
+    duration: f32,
+}
+
+impl<'r, 'a> Idle<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            breath: p.get(IDLE, "breath"),
+            sway: p.get(IDLE, "sway"),
+            duration: p.get(IDLE, "duration"),
+        })
+    }
+}
+
+impl Motion for Idle<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.duration
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        body.reset();
+        let size = h.hip_height;
+        // Le poids passe d'une jambe à l'autre (le bassin se décale et
+        // bascule du côté de la jambe d'appui) ; deux respirations.
+        let shift = wave(u) * self.sway;
+        let breath = (0.5 - 0.5 * (TAU * 2.0 * u).cos()) * self.breath;
+        let offset = Vec3::new(0.035 * size * shift, -0.012 * size - 0.006 * size * shift.abs(), 0.0);
+        let roll = 0.045 * shift;
+        h.pelvis(body, offset, 0.03 * noise(u, 1, &[1, 2]), 0.0, roll);
+        h.bend_spine(body, -0.03 * breath, -0.02 * shift, -0.7 * roll);
+        for side in Lr::BOTH {
+            h.shrug(body, side, 0.03 * breath, 0.0);
+            h.curl(body, side, 0.3);
+        }
+        body.fk();
+        h.stand(body, [Foot::at(0.0, 0.0), Foot::at(0.0, 0.0)]);
+        let lag = wave(u - 0.06) * self.sway;
+        h.relax_arms(body, [0.03 * lag, -0.03 * lag], 0.12 + 0.02 * breath, 0.15);
+        h.look(
+            body,
+            0.05 * noise(u, 7, &[1, 3, 4]),
+            0.12 * noise(u, 11, &[1, 2, 3]),
+            0.04 * noise(u, 13, &[1, 2]) - 0.3 * roll,
+        );
+    }
+}
+
+pub(crate) const LOOK: &[ParamSpec] = &[
+    ParamSpec::new("angle", "Turn angle (deg)", 10.0, 90.0, 65.0),
+    ParamSpec::new("duration", "Duration (s)", 3.0, 12.0, 6.0),
+];
+
+/// Regard alentour : la tête mène, le buste suit avec retard ; à gauche,
+/// au centre, à droite, au centre, avec des temps d'arrêt.
+pub(crate) struct LookAround<'r, 'a> {
+    h: Human<'r, 'a>,
+    angle: f32,
+    duration: f32,
+    yaw: Curve,
+    pitch: Curve,
+}
+
+impl<'r, 'a> LookAround<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let keys = [
+            (0.0, 0.0),
+            (0.06, 0.0),
+            (0.2, 1.0),
+            (0.36, 1.0),
+            (0.48, 0.0),
+            (0.56, 0.0),
+            (0.7, -1.0),
+            (0.86, -1.0),
+            (0.98, 0.0),
+            (1.0, 0.0),
+        ];
+        let pitch = [(0.0, 0.0), (0.2, -0.15), (0.36, 0.1), (0.48, 0.0), (0.7, 0.05), (0.86, -0.1), (1.0, 0.0)];
+        Ok(Self {
+            h: Human::new(rig)?,
+            angle: p.get(LOOK, "angle").to_radians(),
+            duration: p.get(LOOK, "duration"),
+            yaw: Curve::new(&keys),
+            pitch: Curve::new(&pitch),
+        })
+    }
+}
+
+impl Motion for LookAround<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.duration
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let u = u.rem_euclid(1.0);
+        body.reset();
+        // Le buste suit la tête avec 0,25 s de retard.
+        let lag = 0.25 / self.duration;
+        let chest = self.yaw.at(u - lag) * self.angle * 0.3;
+        let size = h.hip_height;
+        h.pelvis(body, Vec3::new(-0.01 * size * chest.signum() * chest.abs().min(0.3), -0.012 * size, 0.0), 0.2 * chest, 0.0, 0.0);
+        h.bend_spine(body, 0.0, 0.8 * chest, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 0.3);
+        }
+        body.fk();
+        h.stand(body, [Foot::at(0.0, 0.0), Foot::at(0.0, 0.0)]);
+        h.relax_arms(body, [0.02 * chest, -0.02 * chest], 0.12, 0.15);
+        h.look(body, self.pitch.at(u) * 0.5, self.yaw.at(u) * self.angle, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/jump.rs b/crates/bones-core/src/presets/procedural/human/jump.rs
new file mode 100644
index 0000000..528b9fc
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/jump.rs
@@ -0,0 +1,148 @@
+//! Saut humain : préparation (flexion, bras en arrière), impulsion (talons
+//! levés, bras lancés vers le haut), vol balistique exact du bassin
+//! (parabole sous la gravité, comme la correction balistique de Cascadeur),
+//! réception amortie puis redressement.
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::anim::physics::GRAVITY;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, bump, hermite, minjerk, smooth};
+use crate::presets::roles::Lr;
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("height", "Jump height (m)", 0.05, 1.0, 0.35),
+    ParamSpec::new("distance", "Distance (m)", 0.0, 2.5, 0.6),
+];
+
+pub(crate) struct Jump<'r, 'a> {
+    h: Human<'r, 'a>,
+    /// Instants : fin de la préparation, décollage, atterrissage, fin de
+    /// l'amorti, fin.
+    times: [f32; 5],
+    v0: f32,
+    crouch: f32,
+    distance: f32,
+    arms: Curve,
+    lean: Curve,
+}
+
+impl<'r, 'a> Jump<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let h = Human::new(rig)?;
+        let height = p.get(PARAMS, "height");
+        let v0 = (2.0 * GRAVITY * height).sqrt();
+        let flight = 2.0 * v0 / GRAVITY;
+        let leg = h.legs[0].length;
+        let crouch = (0.14 + 0.1 * height / 0.35).min(0.32) * leg;
+        let t1 = 0.45;
+        let t2 = t1 + 0.2;
+        let t3 = t2 + flight;
+        let t4 = t3 + 0.3;
+        let t5 = t4 + 0.55;
+        let arms = Curve::new(&[
+            (0.0, 0.0),
+            (t1 - 0.05, -0.9),
+            (t2, 2.4),
+            (t2 + flight * 0.5, 2.0),
+            (t3, 1.0),
+            (t4, 0.5),
+            (t5, 0.0),
+        ]);
+        let lean = Curve::new(&[(0.0, 0.0), (t1, 0.45), (t2, -0.05), (t3, 0.1), (t4, 0.35), (t5, 0.0)]);
+        Ok(Self {
+            h,
+            times: [t1, t2, t3, t4, t5],
+            v0,
+            crouch,
+            distance: p.get(PARAMS, "distance"),
+            arms,
+            lean,
+        })
+    }
+
+    /// Bassin à l'instant `t` : (avance, hauteur relative au repos).
+    fn hips(&self, t: f32) -> (f32, f32) {
+        let [t1, t2, t3, t4, t5] = self.times;
+        let leg = self.h.legs[0].length;
+        let rise = 0.05 * leg;
+        let flight = t3 - t2;
+        let vx = self.distance / flight;
+        let (x_to, x_land) = (0.06 * leg, 0.06 * leg + self.distance);
+        let land = 0.75 * self.crouch;
+        if t < t1 {
+            (hermite(0.0, 0.0, -0.04 * leg, 0.0, t, t1), hermite(0.0, 0.0, -self.crouch, 0.0, t, t1))
+        } else if t < t2 {
+            let s = t - t1;
+            (hermite(-0.04 * leg, 0.0, x_to, vx, s, t2 - t1), hermite(-self.crouch, 0.0, rise, self.v0, s, t2 - t1))
+        } else if t < t3 {
+            let s = t - t2;
+            (x_to + vx * s, rise + self.v0 * s - 0.5 * GRAVITY * s * s)
+        } else if t < t4 {
+            let s = t - t3;
+            // Le bassin revient au-dessus des pieds en amortissant.
+            let end = self.distance + 0.02 * leg;
+            (hermite(x_land, vx, end, 0.0, s, t4 - t3), hermite(rise, -self.v0, -land, 0.0, s, t4 - t3))
+        } else {
+            let s = t - t4;
+            (self.distance + 0.02 * leg, hermite(-land, 0.0, -0.01 * leg, 0.0, s, t5 - t4))
+        }
+    }
+}
+
+impl Motion for Jump<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.times[4]
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let [t1, t2, t3, _, _] = self.times;
+        let t = u.clamp(0.0, 1.0) * self.times[4];
+        body.reset();
+        let (x, y) = self.hips(t);
+        let lean = self.lean.at(t);
+        h.pelvis(body, Vec3::new(0.0, y, x), 0.0, 0.5 * lean, 0.0);
+        h.bend_spine(body, 0.5 * lean, 0.0, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 0.35);
+        }
+        body.fk();
+        // Pieds : au départ jusqu'au décollage (talons levés pendant
+        // l'impulsion), repliés en vol, posés à l'arrivée pointe d'abord.
+        let landed = self.distance;
+        let foot = if t < t1 {
+            Foot::default()
+        } else if t < t2 {
+            Foot {
+                pitch: -0.7 * smooth((t - t1) / (t2 - t1)),
+                ..Foot::default()
+            }
+        } else if t < t3 {
+            let s = (t - t2) / (t3 - t2);
+            let tuck = 0.18 * h.legs[0].length * bump(s, 0.5);
+            Foot {
+                offset: Vec3::new(0.0, 0.0, landed * minjerk(s)),
+                pitch: -0.7 + 0.5 * smooth(s),
+                lift: (y - self.hips(t2).1).max(0.0) * 0.9 + tuck,
+                yaw: 0.0,
+            }
+        } else {
+            let s = ((t - t3) / 0.1).min(1.0);
+            Foot {
+                offset: Vec3::new(0.0, 0.0, landed),
+                pitch: -0.2 * (1.0 - smooth(s)),
+                ..Foot::default()
+            }
+        };
+        h.stand(body, [foot, foot]);
+        let swing = self.arms.at(t);
+        h.relax_arms(body, [swing, swing], 0.15 + 0.1 * swing.max(0.0), 0.25);
+        h.look(body, -0.3 * lean, 0.0, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/limbs.rs b/crates/bones-core/src/presets/procedural/human/limbs.rs
new file mode 100644
index 0000000..cd3b774
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/limbs.rs
@@ -0,0 +1,129 @@
+//! Gestes des membres humains : pied posé en IK (tangage, orteils à plat),
+//! bras en cinématique directe ou en IK, épaules, mains et doigts.
+
+use glam::{Quat, Vec3};
+
+use super::rig::Human;
+use crate::presets::procedural::ctx::Body;
+use crate::presets::roles::Lr;
+
+impl Human<'_, '_> {
+    /// Rotation monde de repos.
+    fn rest_rot(&self, b: crate::BoneId) -> Quat {
+        self.rig.rest[b.index()].rotation
+    }
+
+    /// Transporte un vecteur de repos lié à l'os `b` dans sa pose actuelle.
+    fn carried(&self, body: &Body, b: crate::BoneId, v: Vec3) -> Vec3 {
+        body.rotation(b) * (self.rest_rot(b).inverse() * v)
+    }
+
+    /// Pose le pied : cheville en `ankle` (monde), tangage `pitch` (positif :
+    /// pointe relevée), lacet `yaw` autour de la verticale, orteils à plat
+    /// au sol selon `toe_flat` (0 : ils suivent le pied, 1 : à plat).
+    pub fn place_foot(&self, body: &mut Body, side: Lr, ankle: Vec3, pitch: f32, yaw: f32, toe_flat: f32) {
+        let leg = self.leg_of(side);
+        let hip = body.head(leg.thigh);
+        // Genou : sens de flexion de repos, tourné avec le bassin.
+        let bend = self.carried(body, self.root, leg.bend);
+        let pole = (hip + ankle) * 0.5 + bend * leg.length;
+        body.two_bone(leg.thigh, leg.shin, ankle, pole);
+        let rig = self.rig;
+        let heading = Quat::from_axis_angle(rig.frame.up, yaw);
+        let left = heading * rig.w(Vec3::X);
+        let q = Quat::from_axis_angle(left, -pitch) * heading;
+        if let Some(f) = leg.foot {
+            body.set_rotation(f, q * self.rest_rot(f));
+        }
+        if let Some(t) = leg.toe {
+            let follow = body.rotation(t);
+            let flat = heading * self.rest_rot(t);
+            body.set_rotation(t, follow.slerp(flat, toe_flat.clamp(0.0, 1.0)));
+        }
+    }
+
+    /// Point du pied (cheville) quand il pivote d'un tangage `pitch` autour
+    /// du talon (pointe relevée) ou de la plante (talon levé), le pied étant
+    /// à plat avec sa cheville en `flat_ankle`.
+    pub fn rolled_ankle(&self, side: Lr, flat_ankle: Vec3, pitch: f32, yaw: f32) -> Vec3 {
+        let leg = self.leg_of(side);
+        let rig = self.rig;
+        let heading = Quat::from_axis_angle(rig.frame.up, yaw);
+        let offset = flat_ankle - leg.ankle;
+        let pivot = if pitch >= 0.0 { leg.heel } else { leg.ball };
+        let pivot = offset + leg.ankle + heading * (pivot - leg.ankle);
+        let left = heading * rig.w(Vec3::X);
+        let q = Quat::from_axis_angle(left, -pitch);
+        pivot + q * (flat_ankle - pivot)
+    }
+
+    /// Bras en cinématique directe : écarté de `abduct` sur le côté (radians,
+    /// depuis la verticale), balancé de `swing` vers l'avant autour de l'axe
+    /// des épaules, coude et poignet fléchis vers l'avant de l'articulation.
+    /// Le bras est d'abord abaissé dans le plan frontal puis balancé : la
+    /// torsion reste anatomique quelle que soit la pose de repos (T ou A).
+    pub fn swing_arm(&self, body: &mut Body, side: Lr, abduct: f32, swing: f32, elbow: f32, wrist: f32) {
+        let Some(arm) = self.arm_of(side) else { return };
+        let rig = self.rig;
+        let hang = Quat::from_rotation_z(side.sign() * abduct) * -Vec3::Y;
+        body.aim(arm.upper, rig.w(hang));
+        body.rotate(arm.upper, Quat::from_axis_angle(rig.w(Vec3::X), -swing));
+        let up = (body.tail(arm.upper) - body.head(arm.upper)).normalize_or(-rig.frame.up);
+        let flex = self.carried(body, arm.upper, arm.flex);
+        let fore = up * elbow.cos() + flex * elbow.sin();
+        body.aim(arm.fore, fore);
+        if let Some(h) = arm.hand {
+            let flex = self.carried(body, arm.fore, arm.flex);
+            body.aim(h, fore * wrist.cos() + flex * wrist.sin());
+        }
+    }
+
+    /// Main vers `target` (monde) par IK, coude vers `pole` ; la main
+    /// prolonge l'avant-bras, fléchie de `wrist`.
+    pub fn reach(&self, body: &mut Body, side: Lr, target: Vec3, pole: Vec3, wrist: f32) {
+        let Some(arm) = self.arm_of(side) else { return };
+        body.two_bone(arm.upper, arm.fore, target, pole);
+        if let Some(h) = arm.hand {
+            let fore = (body.tail(arm.fore) - body.head(arm.fore)).normalize_or(Vec3::Y);
+            let flex = self.carried(body, arm.fore, arm.flex);
+            body.aim(h, fore * wrist.cos() + flex * wrist.sin());
+        }
+    }
+
+    /// Tourne la main autour de son axe pour que la paume regarde `normal`.
+    pub fn palm_towards(&self, body: &mut Body, side: Lr, normal: Vec3) {
+        let Some(arm) = self.arm_of(side) else { return };
+        let Some(h) = arm.hand else { return };
+        let axis = (body.tail(h) - body.head(h)).normalize_or(Vec3::Y);
+        let flat = |v: Vec3| (v - axis * v.dot(axis)).try_normalize();
+        let (Some(now), Some(want)) = (flat(self.carried(body, h, arm.palm)), flat(normal)) else {
+            return;
+        };
+        let angle = now.cross(want).dot(axis).atan2(now.dot(want));
+        // La torsion est partagée entre l'avant-bras et la main.
+        body.twist(arm.fore, angle * 0.5);
+        body.twist(h, angle * 0.5);
+    }
+
+    /// Épaule : élévation et avancée de la clavicule (radians).
+    pub fn shrug(&self, body: &mut Body, side: Lr, raise: f32, forward: f32) {
+        let Some(c) = self.arm_of(side).and_then(|a| a.clavicle) else { return };
+        body.turn(Some(c), Vec3::Z, side.sign() * raise);
+        body.turn(Some(c), Vec3::Y, -side.sign() * forward);
+    }
+
+    /// Flexion des doigts vers la paume (0 : ouverts, 1 : poing serré).
+    /// À appeler avant la cinématique directe.
+    pub fn curl(&self, body: &mut Body, side: Lr, amount: f32) {
+        let Some(arm) = self.arm_of(side) else { return };
+        for (i, finger) in arm.fingers.iter().enumerate() {
+            let thumb = i == 0 && arm.fingers.len() == 5;
+            let weight = if thumb { 0.45 } else { 1.0 };
+            for (k, b) in finger.iter().enumerate() {
+                let hinge = self.rig.dir(*b).cross(arm.palm).normalize_or(Vec3::X);
+                let angle = amount * weight * if k == 0 { 1.2 } else { 1.5 };
+                body.turn_world(*b, Quat::from_axis_angle(hinge, angle));
+            }
+        }
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/locomotion.rs b/crates/bones-core/src/presets/procedural/human/locomotion.rs
new file mode 100644
index 0000000..16c6188
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/locomotion.rs
@@ -0,0 +1,257 @@
+//! Marche et course humaines (marche, jogging, course, sprint, pas de
+//! loup). Les pieds suivent des trajectoires planifiées et restent plantés
+//! au sol pendant l'appui (déroulé talon → plante → pointe), les jambes
+//! sont résolues en IK à deux os, le bassin oscille (pendule inversé à la
+//! marche, ressort à la course : Cavagna 1977), la colonne contre-tourne,
+//! les bras balancent en opposition avec un léger retard.
+//!
+//! Longueur de foulée et cadence suivent la vitesse adimensionnée
+//! v̂ = v / √(g·L) (nombre de Froude, Alexander 1984) : S ≈ 2,4·L·√v̂.
+
+use std::f32::consts::PI;
+
+use glam::{Quat, Vec3};
+
+use super::rig::Human;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{bump, cwave, envelope, minjerk, periodic, smooth};
+use crate::presets::roles::Lr;
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed (m/s)", 0.3, 9.0, 1.4),
+    ParamSpec::new("stride", "Stride length", 0.6, 1.5, 1.0),
+    ParamSpec::new("bounce", "Bounce", 0.0, 2.0, 1.0),
+    ParamSpec::new("arms", "Arm swing", 0.0, 2.0, 1.0),
+    ParamSpec::new("lean", "Lean", -1.0, 1.0, 0.0),
+    ParamSpec::new("crouch", "Crouch", 0.0, 1.0, 0.0),
+    ParamSpec::toggle("run", "Run (flight phase)", false),
+];
+
+pub(crate) struct Locomotion<'r, 'a> {
+    h: Human<'r, 'a>,
+    run: bool,
+    /// Distance parcourue par cycle (deux pas), en mètres.
+    stride: f32,
+    period: f32,
+    duty: f32,
+    strike: f32,
+    toe_off: f32,
+    heel_flat: f32,
+    heel_off: f32,
+    lift: f32,
+    bob: f32,
+    sway: f32,
+    yaw: f32,
+    list: f32,
+    lean: f32,
+    crouch: f32,
+    arm_swing: f32,
+    elbow: f32,
+    elbow_swing: f32,
+    width: f32,
+    /// Abaissement minimal du bassin.
+    base_drop: f32,
+    /// Abaissement du bassin sur un cycle (voir [`Self::drop_curve`]).
+    drops: Vec<f32>,
+}
+
+impl<'r, 'a> Locomotion<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let h = Human::new(rig)?;
+        let get = |k| p.get(PARAMS, k);
+        let leg = (h.legs[0].length + h.legs[1].length) * 0.5;
+        let v = get("speed");
+        let vh = v / (9.81 * leg).sqrt();
+        let run = p.flag(PARAMS, "run");
+        let stride = 2.4 * leg * vh.sqrt() * get("stride");
+        let (bounce, arms, crouch) = (get("bounce"), get("arms"), get("crouch"));
+        let mut m = if run {
+            Self {
+                h,
+                run,
+                stride,
+                period: stride / v,
+                duty: (0.47 - 0.09 * vh).clamp(0.22, 0.45),
+                strike: (0.2 - 0.08 * vh).clamp(-0.05, 0.2),
+                toe_off: 0.95,
+                heel_flat: 0.1,
+                heel_off: 0.35,
+                lift: leg * (0.18 + 0.12 * vh).min(0.6),
+                bob: 0.04 * leg * bounce,
+                sway: 0.008 * leg,
+                yaw: 0.14,
+                list: 0.05,
+                lean: 0.1 + 0.05 * vh + 0.2 * get("lean"),
+                crouch,
+                arm_swing: (0.5 + 0.12 * vh) * arms,
+                elbow: 1.45,
+                elbow_swing: 0.25,
+                width: 0.55,
+                base_drop: 0.0,
+                drops: Vec::new(),
+            }
+        } else {
+            Self {
+                h,
+                run,
+                stride,
+                period: stride / v,
+                duty: (0.68 - 0.13 * vh).clamp(0.55, 0.68),
+                strike: 0.3,
+                toe_off: 1.0,
+                heel_flat: 0.15,
+                heel_off: 0.5,
+                lift: 0.09 * leg,
+                bob: 0.022 * leg * bounce,
+                sway: 0.025 * leg,
+                yaw: 0.09,
+                list: 0.08,
+                lean: 0.03 + 0.2 * get("lean") + 0.35 * crouch,
+                crouch,
+                arm_swing: 0.3 * arms * (1.0 - 0.6 * crouch),
+                elbow: 0.2 + 0.6 * crouch,
+                elbow_swing: 0.2,
+                width: 0.85,
+                base_drop: 0.0,
+                drops: Vec::new(),
+            }
+        };
+        m.base_drop = 0.01 * m.h.hip_height + crouch * 0.25 * leg;
+        m.drops = m.drop_curve();
+        Ok(m)
+    }
+
+    /// Bassin : déplacement canonique (sans abaissement) et rotation.
+    fn pelvis(&self, u: f32) -> (Vec3, f32, f32) {
+        let mid = u - self.duty * 0.5;
+        let bob = if self.run { -self.bob } else { self.bob } * cwave(2.0 * mid);
+        let offset = Vec3::new(self.sway * cwave(mid), bob, self.stride * u);
+        (offset, -self.yaw * cwave(u), self.list * cwave(mid))
+    }
+
+    fn pelvis_rotation(&self, yaw: f32, roll: f32) -> Quat {
+        let pitch = if self.run { 0.08 } else { 0.02 };
+        let rig = self.h.rig;
+        rig.basis * Quat::from_rotation_y(yaw) * Quat::from_rotation_z(roll) * Quat::from_rotation_x(pitch) * rig.basis.inverse()
+    }
+
+    /// Cheville visée (monde), tangage du pied et orteils à plat (0..1).
+    fn foot(&self, side: Lr, u: f32) -> (Vec3, f32, f32) {
+        let offset = if side == Lr::Left { 0.0 } else { 0.5 };
+        let p = u + offset;
+        let k = p.floor();
+        let phi = p - k;
+        let flat = |k: f32| self.flat_ankle(side, k, offset);
+        if phi < self.duty {
+            let s = phi / self.duty;
+            let pitch = if s < self.heel_flat {
+                self.strike * (1.0 - smooth(s / self.heel_flat))
+            } else if s > self.heel_off {
+                -self.toe_off * smooth((s - self.heel_off) / (1.0 - self.heel_off)).powf(1.3)
+            } else {
+                0.0
+            };
+            let toe = if s < self.heel_flat { 0.0 } else { 1.0 };
+            (self.h.rolled_ankle(side, flat(k), pitch, 0.0), pitch, toe)
+        } else {
+            let w = (phi - self.duty) / (1.0 - self.duty);
+            let rig = self.h.rig;
+            let start = self.h.rolled_ankle(side, flat(k), -self.toe_off, 0.0);
+            let end = self.h.rolled_ankle(side, flat(k + 1.0), self.strike, 0.0);
+            let up = rig.frame.up;
+            let (h0, h1) = (rig.height(start), rig.height(end));
+            let along = start + (end - start) * minjerk(w);
+            let height = h0 + (h1 - h0) * smooth(w) + self.lift * bump(w, if self.run { 0.4 } else { 0.35 });
+            let ankle = along + up * (height - rig.height(along));
+            let pitch = -self.toe_off + (self.strike + self.toe_off) * smooth(w) + 0.15 * (PI * w).sin();
+            (ankle, pitch, 1.0 - smooth(w / 0.3))
+        }
+    }
+
+    /// Cheville à plat au pas `k` : sous le bassin au milieu de l'appui.
+    fn flat_ankle(&self, side: Lr, k: f32, offset: f32) -> Vec3 {
+        let h = &self.h;
+        let rig = h.rig;
+        let leg = h.leg_of(side);
+        let left = rig.w(Vec3::X);
+        let lateral = (leg.ankle - rig.head(h.root)).dot(left);
+        // Le bassin passe au-dessus de la cheville un peu avant le milieu de
+        // l'appui (le déroulé sur la pointe fait encore avancer la cheville).
+        let mid = if self.run { 0.5 } else { 0.45 };
+        leg.ankle + left * lateral * (self.width - 1.0) + rig.w(Vec3::Z) * self.stride * (k + self.duty * mid - offset)
+    }
+
+    /// Abaissement imposé par la portée à l'instant `u` : chaque cheville
+    /// doit rester atteignable (jambe tendue à 99 % au plus).
+    fn reach_drop(&self, u: f32) -> f32 {
+        let h = &self.h;
+        let rig = h.rig;
+        let up = rig.frame.up;
+        let root = rig.head(h.root);
+        let (offset, yaw, roll) = self.pelvis(u);
+        let r = self.pelvis_rotation(yaw, roll);
+        let mut drop = self.base_drop;
+        for leg in &h.legs {
+            let hip = root + rig.w(offset) + r * (rig.head(leg.thigh) - root);
+            let (ankle, _, _) = self.foot(leg.side, u);
+            let d = hip - ankle;
+            let dv = d.dot(up);
+            let dh = (d - up * dv).length();
+            let max = 0.99 * leg.length;
+            drop = drop.max(if dh < max { dv - (max * max - dh * dh).sqrt() } else { dv });
+        }
+        drop
+    }
+
+    /// Courbe d'abaissement du bassin sur un cycle : enveloppe de la portée
+    /// à accélération verticale bornée, d'où des arcs doux comme ceux du
+    /// pendule inversé.
+    fn drop_curve(&self) -> Vec<f32> {
+        let n = DROP_SAMPLES;
+        let need: Vec<f32> = (0..n).map(|i| self.reach_drop(i as f32 / n as f32) + 0.002).collect();
+        envelope(&need, self.period / n as f32, if self.run { 6.0 } else { 3.5 })
+    }
+}
+
+/// Échantillons par cycle de la courbe d'abaissement du bassin.
+const DROP_SAMPLES: usize = 128;
+
+impl Motion for Locomotion<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.period
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        body.reset();
+        let (mut offset, yaw, roll) = self.pelvis(u);
+        offset.y -= periodic(&self.drops, u);
+        let pitch = if self.run { 0.08 } else { 0.02 } + 0.15 * self.crouch;
+        h.pelvis(body, offset, yaw, pitch, roll);
+        let flex = if self.run { 0.04 * cwave(2.0 * (u - self.duty * 0.5)) } else { 0.0 };
+        h.bend_spine(body, self.lean + flex - pitch, -1.5 * yaw, -0.8 * roll);
+        let fist = if self.run { 0.55 } else { 0.25 };
+        for side in Lr::BOTH {
+            h.curl(body, side, fist);
+        }
+        body.fk();
+        for side in Lr::BOTH {
+            let (ankle, pitch, toe) = self.foot(side, u);
+            h.place_foot(body, side, ankle, pitch, 0.0, toe);
+        }
+        for side in Lr::BOTH {
+            let phase = if side == Lr::Left { 0.0 } else { 0.5 };
+            let s = -cwave(u + phase - 0.04);
+            let swing = self.arm_swing * s + 0.05;
+            let abduct = if self.run { 0.16 } else { 0.1 };
+            let elbow = self.elbow + self.elbow_swing * s.max(0.0);
+            h.shrug(body, side, 0.0, 0.04 * s);
+            body.fk();
+            h.swing_arm(body, side, abduct, swing, elbow, 0.12);
+        }
+        h.look(body, 0.0, 0.0, 0.0);
+    }
+}
