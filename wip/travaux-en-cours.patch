@@ -0,0 +1,9 @@
+//! Générateurs animaux : quadrupèdes, oiseaux, poissons, serpents,
+//! animaux à six ou huit pattes.
+
+pub(crate) mod bird;
+pub(crate) mod crawl;
+pub(crate) mod limb;
+pub(crate) mod quad_rest;
+pub(crate) mod quadruped;
+pub(crate) mod swim;
diff --git a/crates/bones-core/src/presets/procedural/animal/quad_rest.rs b/crates/bones-core/src/presets/procedural/animal/quad_rest.rs
new file mode 100644
index 0000000..7cd5308
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/quad_rest.rs
@@ -0,0 +1,116 @@
+//! Quadrupède au repos : attente (respiration, regard, queue) et
+//! s'asseoir (l'arrière-train descend, les jarrets se posent au sol, le
+//! dos se redresse, la tête reste à l'horizontale).
+
+use glam::Vec3;
+
+use super::quadruped::Quad;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{minjerk, noise, wave};
+
+pub(crate) const IDLE: &[ParamSpec] = &[
+    ParamSpec::new("breath", "Breathing", 0.0, 2.0, 1.0),
+    ParamSpec::new("look", "Look around", 0.0, 2.0, 1.0),
+    ParamSpec::new("tail", "Tail motion", 0.0, 2.0, 1.0),
+];
+
+pub(crate) struct QuadIdle<'r, 'a> {
+    q: Quad<'r, 'a>,
+    breath: f32,
+    look: f32,
+    tail: f32,
+}
+
+impl<'r, 'a> QuadIdle<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            q: Quad::new(rig, 2)?,
+            breath: p.get(IDLE, "breath"),
+            look: p.get(IDLE, "look"),
+            tail: p.get(IDLE, "tail"),
+        })
+    }
+}
+
+impl Motion for QuadIdle<'_, '_> {
+    fn duration(&self) -> f32 {
+        6.0
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        let h = q.height;
+        body.reset();
+        // Trois respirations, un léger transfert de poids.
+        let breath = wave(3.0 * u) * self.breath;
+        let shift = noise(u, 2, &[1, 2]);
+        body.pelvis(q.root, Vec3::new(0.01 * h * shift, -0.01 * h + 0.004 * h * breath, 0.0), 0.0, 0.0, 0.03 * shift);
+        body.spread(&q.spine, -0.02 * breath, 0.03 * shift, -0.02 * shift);
+        body.ripple(&q.tail, Vec3::Y, 0.18 * self.tail, 2.0 * u, 0.3);
+        body.ripple(&q.tail, Vec3::X, 0.05 * self.tail, u, 0.2);
+        body.fk();
+        for limb in &q.limbs {
+            limb.place(body, limb.contact, glam::Quat::IDENTITY, 1.0);
+        }
+        let l = self.look;
+        body.look(
+            &q.neck,
+            q.head,
+            0.08 * l * noise(u, 5, &[1, 2, 3]),
+            0.45 * l * noise(u, 9, &[1, 2]),
+            0.05 * l * noise(u, 13, &[2, 3]),
+        );
+    }
+}
+
+pub(crate) const SIT: &[ParamSpec] = &[
+    ParamSpec::new("depth", "Depth", 0.3, 1.0, 1.0),
+    ParamSpec::toggle("reverse", "Stand up instead", false),
+];
+
+pub(crate) struct QuadSit<'r, 'a> {
+    q: Quad<'r, 'a>,
+    depth: f32,
+    reverse: bool,
+}
+
+impl<'r, 'a> QuadSit<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            q: Quad::new(rig, 2)?,
+            depth: p.get(SIT, "depth"),
+            reverse: p.flag(SIT, "reverse"),
+        })
+    }
+}
+
+impl Motion for QuadSit<'_, '_> {
+    fn duration(&self) -> f32 {
+        2.4
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        let u = u.clamp(0.0, 1.0);
+        let u = if self.reverse { 1.0 - u } else { u };
+        let k = minjerk(u / 0.75) * self.depth;
+        let h = q.height;
+        body.reset();
+        // Le bassin descend et recule ; le corps se redresse autour des épaules.
+        let tilt = -0.55 * k;
+        body.pelvis(q.root, Vec3::new(0.0, -0.62 * h * k, -0.08 * h * k), 0.0, tilt, 0.0);
+        body.spread(&q.spine, 0.1 * k, 0.0, 0.0);
+        body.ripple(&q.tail, Vec3::X, 0.3 * k, 0.25, 0.0);
+        body.fk();
+        for limb in &q.limbs {
+            // Arrière : le métatarse se couche au sol (jarret posé).
+            let flex = if limb.front { 0.0 } else { -1.35 * k };
+            let paw = limb.contact + q.rig.w(Vec3::Z) * if limb.front { -0.03 * h * k } else { 0.0 };
+            limb.place(body, paw, q.flex(flex), 1.0);
+        }
+        body.look(&q.neck, q.head, 0.1 * k, 0.0, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/quadruped.rs b/crates/bones-core/src/presets/procedural/animal/quadruped.rs
new file mode 100644
index 0000000..157b0b7
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/quadruped.rs
@@ -0,0 +1,217 @@
+//! Quadrupèdes : pas, trot, galop. Chaque patte suit son cycle avec un
+//! décalage de phase propre à l'allure (Hildebrand 1965 : pas latéral,
+//! paires diagonales au trot, galop rotatoire) ; la foulée suit la loi de
+//! similitude dynamique d'Alexander & Jayes (1983) : λ = 2,3·h·(v²/gh)^0,3.
+//! Les pattes sont posées en IK, le dos ondule (latéralement au pas, en
+//! flexion-extension au galop), la tête hoche, la queue suit avec retard.
+
+use glam::{Quat, Vec3};
+
+use super::limb::Limb;
+use crate::BoneId;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{bump, cwave, envelope, minjerk, periodic, smooth, wave};
+use crate::presets::roles::{Chain, Lr};
+
+/// Quadrupède vu par les générateurs.
+pub(crate) struct Quad<'r, 'a> {
+    pub rig: &'r Rigging<'a>,
+    pub root: BoneId,
+    pub spine: Vec<BoneId>,
+    pub neck: Vec<BoneId>,
+    pub head: Option<BoneId>,
+    pub tail: Vec<BoneId>,
+    /// Pattes présentes : avant gauche, avant droite, arrière gauche, arrière droite.
+    pub limbs: Vec<Limb>,
+    /// Hauteur du bassin au-dessus du sol.
+    pub height: f32,
+}
+
+impl<'r, 'a> Quad<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, legs: usize) -> Result<Self, PresetError> {
+        let root = rig.bone(Chain::Root, 0).ok_or_else(|| incompatible("no hips bone"))?;
+        let mut limbs = Vec::new();
+        for (front, chain) in [(true, Chain::Arm as fn(Lr) -> Chain), (false, Chain::Leg)] {
+            for side in Lr::BOTH {
+                limbs.extend(Limb::new(rig, chain(side), side, front));
+            }
+        }
+        if limbs.len() < legs {
+            return Err(incompatible(format!("{legs} legs needed, {} found", limbs.len())));
+        }
+        Ok(Self {
+            rig,
+            root,
+            spine: rig.chain(Chain::Spine),
+            neck: rig.chain(Chain::Neck),
+            head: rig.bone(Chain::Head, 0),
+            tail: rig.chain(Chain::Tail),
+            limbs,
+            height: rig.height(rig.head(root)).max(0.05),
+        })
+    }
+
+    /// Rotation du point d'appui autour de l'axe gauche (positif : le
+    /// talon ou le poignet avance par rapport à l'appui).
+    pub fn flex(&self, angle: f32) -> Quat {
+        Quat::from_axis_angle(self.rig.w(Vec3::X), angle)
+    }
+}
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed (m/s)", 0.2, 15.0, 1.0),
+    ParamSpec {
+        step: 1.0,
+        ..ParamSpec::new("gait", "Gait (0 walk, 1 trot, 2 gallop)", 0.0, 2.0, 0.0)
+    },
+    ParamSpec::new("stride", "Stride length", 0.6, 1.5, 1.0),
+    ParamSpec::new("bounce", "Bounce", 0.0, 2.0, 1.0),
+    ParamSpec::new("tail", "Tail motion", 0.0, 2.0, 1.0),
+];
+
+/// Allure : facteur d'appui, phases (AvG, AvD, ArG, ArD), lever, rebond.
+struct Style {
+    duty: f32,
+    phases: [f32; 4],
+    lift: f32,
+    bob: f32,
+}
+
+pub(crate) struct Gait<'r, 'a> {
+    q: Quad<'r, 'a>,
+    gait: u8,
+    style: Style,
+    stride: f32,
+    period: f32,
+    tail: f32,
+    drops: Vec<f32>,
+}
+
+impl<'r, 'a> Gait<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let q = Quad::new(rig, 4)?;
+        let gait = p.get(PARAMS, "gait") as u8;
+        let style = match gait {
+            0 => Style { duty: 0.65, phases: [0.25, 0.75, 0.0, 0.5], lift: 0.16, bob: 0.012 },
+            1 => Style { duty: 0.42, phases: [0.5, 0.0, 0.0, 0.5], lift: 0.25, bob: 0.03 },
+            _ => Style { duty: 0.36, phases: [0.62, 0.52, 0.0, 0.1], lift: 0.3, bob: 0.05 },
+        };
+        let v = p.get(PARAMS, "speed");
+        let h = q.height;
+        let froude = v * v / (9.81 * h);
+        // Pattes plus courtes que l'animal réel (raideur de la colonne
+        // ignorée) : foulée réduite de 20 %, 32 % au galop.
+        let scale = if gait >= 2 { 0.68 } else { 0.8 };
+        let stride = scale * 2.3 * h * froude.powf(0.3) * p.get(PARAMS, "stride");
+        let mut g = Self {
+            style: Style {
+                bob: style.bob * p.get(PARAMS, "bounce"),
+                ..style
+            },
+            q,
+            gait,
+            stride,
+            period: stride / v,
+            tail: p.get(PARAMS, "tail"),
+            drops: Vec::new(),
+        };
+        let n = 96;
+        let need: Vec<f32> = (0..n).map(|i| g.reach_drop(i as f32 / n as f32) + 0.002).collect();
+        let accel = if g.gait >= 2 { 9.0 } else { 5.0 };
+        g.drops = envelope(&need, g.period / n as f32, accel);
+        Ok(g)
+    }
+
+    /// Bassin : déplacement canonique, tangage.
+    fn body(&self, u: f32) -> (Vec3, f32) {
+        let h = self.q.height;
+        let s = &self.style;
+        let y = match self.gait {
+            0 => s.bob * h * cwave(2.0 * u),
+            1 => -s.bob * h * cwave(2.0 * (u - s.duty * 0.5)),
+            _ => s.bob * h * wave(u),
+        };
+        let pitch = if self.gait >= 2 { 0.1 * cwave(u - 0.3) } else { 0.0 };
+        let sway = if self.gait == 0 { 0.01 * h * wave(u) } else { 0.0 };
+        (Vec3::new(sway, y, self.stride * u), pitch)
+    }
+
+    /// Appui de la patte `i` à l'instant `u` : position, flexion distale,
+    /// doigts à plat.
+    fn paw(&self, i: usize, u: f32) -> (Vec3, f32, f32) {
+        let limb = &self.q.limbs[i];
+        let s = &self.style;
+        let phase = s.phases[i];
+        let q = u - phase;
+        let k = q.floor();
+        let phi = q - k;
+        let forward = self.q.rig.w(Vec3::Z);
+        let at = |k: f32| limb.contact + forward * self.stride * (k + s.duty * 0.5 + phase);
+        if phi < s.duty {
+            let lift = smooth((phi / s.duty - 0.6) / 0.4);
+            (at(k), 0.35 * lift, 1.0)
+        } else {
+            let w = (phi - s.duty) / (1.0 - s.duty);
+            let (a, b) = (at(k), at(k + 1.0));
+            let lift = s.lift * limb.reach * bump(w, 0.45);
+            let fold = if limb.front { 1.1 } else { 0.7 };
+            let flex = 0.35 * (1.0 - smooth(w / 0.3)) + fold * bump(w, 0.35);
+            (a.lerp(b, minjerk(w)) + self.q.rig.frame.up * lift, flex, 1.0 - smooth(w / 0.3))
+        }
+    }
+
+    fn reach_drop(&self, u: f32) -> f32 {
+        let rig = self.q.rig;
+        let root = rig.head(self.q.root);
+        let (offset, pitch) = self.body(u);
+        let r = Quat::from_axis_angle(rig.w(Vec3::X), pitch);
+        let up = rig.frame.up;
+        let mut drop: f32 = 0.0;
+        for (i, limb) in self.q.limbs.iter().enumerate() {
+            let attach = root + rig.w(offset) + r * (limb.attach(rig) - root);
+            let (paw, flex, _) = self.paw(i, u);
+            let c = &limb.chain;
+            let hock = if c.len() > 2 { paw - self.q.flex(flex) * (limb.contact - rig.head(c[2])) } else { paw };
+            let d = attach - hock;
+            let dv = d.dot(up);
+            let dh = (d - up * dv).length();
+            let max = 0.98 * limb.reach;
+            drop = drop.max(if dh < max { dv - (max * max - dh * dh).sqrt() } else { dv });
+        }
+        drop.max(0.01 * self.q.height)
+    }
+}
+
+impl Motion for Gait<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.period
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let q = &self.q;
+        body.reset();
+        let (mut offset, pitch) = self.body(u);
+        offset.y -= periodic(&self.drops, u);
+        let walk = self.gait == 0;
+        body.pelvis(q.root, offset, if walk { 0.04 * wave(u) } else { 0.0 }, pitch, 0.0);
+        let flexion = if self.gait >= 2 { 0.3 * wave(u - 0.15) } else { 0.0 };
+        let lateral = if walk { 0.08 * wave(u + 0.25) } else { 0.02 * wave(u) };
+        body.spread(&q.spine, flexion - 0.5 * pitch, lateral, 0.0);
+        body.ripple(&q.tail, Vec3::Y, 0.25 * self.tail, u, 0.35);
+        body.ripple(&q.tail, Vec3::X, 0.08 * self.tail, 2.0 * u, 0.3);
+        body.fk();
+        for i in 0..q.limbs.len() {
+            let (paw, flex, toe) = self.paw(i, u);
+            q.limbs[i].place(body, paw, q.flex(flex), toe);
+        }
+        let nod = match self.gait {
+            0 => 0.06 * cwave(2.0 * u),
+            1 => 0.02 * cwave(2.0 * u),
+            _ => 0.12 * cwave(u - 0.1),
+        };
+        body.look(&q.neck, q.head, nod - 0.05, -lateral * 0.3, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/animal/swim.rs b/crates/bones-core/src/presets/procedural/animal/swim.rs
new file mode 100644
index 0000000..fe42995
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/animal/swim.rs
@@ -0,0 +1,204 @@
+//! Nage du poisson et reptation du serpent.
+//!
+//! Poisson : onde de courbure qui parcourt le corps de la tête vers la
+//! queue, d'amplitude croissante (nage carangiforme, Lighthill 1960).
+//! Serpent : ondulation latérale « suivi du meneur » — chaque point du corps
+//! passe exactement par le chemin tracé par la tête, une courbe serpenoïde
+//! (Hirose 1993) : pas de glissement latéral.
+
+use glam::{Vec2, Vec3};
+
+use crate::BoneId;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::wave;
+use crate::presets::roles::{Chain, Lr};
+
+pub(crate) const SWIM: &[ParamSpec] = &[
+    ParamSpec::new("rate", "Tail beats per second", 0.3, 6.0, 1.6),
+    ParamSpec::new("amplitude", "Amplitude", 0.2, 2.0, 1.0),
+    ParamSpec::new("speed", "Speed (body lengths/s)", 0.0, 4.0, 0.0),
+];
+
+/// Os du corps (racine, colonne, cou, tête, queue), dans l'ordre de la hiérarchie.
+fn body_bones(rig: &Rigging) -> Vec<BoneId> {
+    let mut bones: Vec<BoneId> = [Chain::Root, Chain::Spine, Chain::Neck, Chain::Head, Chain::Tail]
+        .iter()
+        .flat_map(|c| rig.chain(*c))
+        .collect();
+    bones.sort();
+    bones
+}
+
+pub(crate) struct Swim {
+    root: Option<BoneId>,
+    /// (os, abscisse de la tête à la queue 0..1, longueur relative, signe).
+    segments: Vec<(BoneId, f32, f32, f32)>,
+    fins: Vec<(BoneId, f32)>,
+    length: f32,
+    rate: f32,
+    amplitude: f32,
+    speed: f32,
+}
+
+impl Swim {
+    pub fn new(rig: &Rigging, p: &Params) -> Result<Self, PresetError> {
+        let bones = body_bones(rig);
+        if bones.len() < 2 {
+            return Err(incompatible("no body chain"));
+        }
+        let fwd = rig.w(Vec3::Z);
+        let z = |v: Vec3| v.dot(fwd);
+        let front = bones.iter().map(|b| z(rig.head(*b)).max(z(rig.tail(*b)))).fold(f32::MIN, f32::max);
+        let back = bones.iter().map(|b| z(rig.head(*b)).min(z(rig.tail(*b)))).fold(f32::MAX, f32::min);
+        let length = (front - back).max(1e-3);
+        let segments = bones
+            .iter()
+            .map(|b| {
+                let (h, t) = (z(rig.head(*b)), z(rig.tail(*b)));
+                let s = (front - (h + t) * 0.5) / length;
+                let sign = if t < h { 1.0 } else { -1.0 };
+                (*b, s, rig.len(*b) / length, sign)
+            })
+            .collect();
+        let fins = Lr::BOTH
+            .iter()
+            .flat_map(|s| rig.chain(Chain::Arm(*s)).into_iter().map(move |b| (b, s.sign())))
+            .collect();
+        Ok(Self {
+            root: rig.bone(Chain::Root, 0),
+            segments,
+            fins,
+            length,
+            rate: p.get(SWIM, "rate"),
+            amplitude: p.get(SWIM, "amplitude"),
+            speed: p.get(SWIM, "speed"),
+        })
+    }
+}
+
+impl Motion for Swim {
+    fn duration(&self) -> f32 {
+        1.0 / self.rate
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        body.reset();
+        let a = self.amplitude;
+        let travel = self.speed * self.length * self.duration() * u;
+        if let Some(r) = self.root {
+            body.shift(Some(r), Vec3::new(0.0, 0.0, travel));
+        }
+        for &(b, s, len, sign) in &self.segments {
+            // Courbure : amplitude croissante vers la queue, une longueur
+            // d'onde par longueur de corps.
+            let envelope = 0.15 + 0.85 * s * s;
+            let k = 2.4 * a * envelope * len * wave(u - s);
+            body.turn(Some(b), Vec3::Y, sign * k);
+        }
+        // Recul de la tête et nageoires pectorales qui battent.
+        body.turn(self.root, Vec3::Y, -0.04 * a * wave(u + 0.1));
+        for &(b, side) in &self.fins {
+            body.turn(Some(b), Vec3::Z, side * 0.25 * wave(2.0 * u));
+        }
+        body.fk();
+    }
+}
+
+pub(crate) const SLITHER: &[ParamSpec] = &[
+    ParamSpec::new("speed", "Speed (m/s)", 0.05, 3.0, 0.4),
+    ParamSpec::new("wavelength", "Wavelength (body lengths)", 0.2, 1.0, 0.45),
+    ParamSpec::new("amplitude", "Amplitude", 0.2, 1.5, 1.0),
+];
+
+pub(crate) struct Slither<'r, 'a> {
+    rig: &'r Rigging<'a>,
+    root: BoneId,
+    /// Os du corps et abscisses curvilignes de leur tête et de leur queue
+    /// depuis le bout avant du corps.
+    bones: Vec<(BoneId, f32, f32)>,
+    head: Option<BoneId>,
+    front: Vec3,
+    lambda: f32,
+    speed: f32,
+    /// Chemin serpenoïde sur une longueur d'onde (x latéral, y avant).
+    path: Vec<Vec2>,
+}
+
+impl<'r, 'a> Slither<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let root = rig.bone(Chain::Root, 0).ok_or_else(|| incompatible("no root bone"))?;
+        let mut chain = vec![root];
+        chain.extend(rig.chain(Chain::Spine));
+        if chain.len() < 3 {
+            return Err(incompatible("body chain too short"));
+        }
+        let fwd = rig.w(Vec3::Z);
+        let (first, last) = (rig.head(chain[0]), rig.tail(*chain.last().unwrap()));
+        let front = if first.dot(fwd) >= last.dot(fwd) { first } else { last };
+        let bones: Vec<(BoneId, f32, f32)> = chain
+            .iter()
+            .map(|b| ((*b), (rig.head(*b) - front).length(), (rig.tail(*b) - front).length()))
+            .collect();
+        let length = bones.iter().map(|(_, h, t)| h.max(*t)).fold(0.0, f32::max).max(1e-3);
+        let lambda = p.get(SLITHER, "wavelength") * length;
+        let theta = 0.75 * p.get(SLITHER, "amplitude");
+        let n = 512;
+        let mut path = Vec::with_capacity(n + 1);
+        let mut pos = Vec2::ZERO;
+        path.push(pos);
+        for i in 0..n {
+            let sigma = (i as f32 + 0.5) / n as f32 * lambda;
+            let a = theta * (std::f32::consts::TAU * sigma / lambda).sin();
+            pos += Vec2::new(a.sin(), a.cos()) * lambda / n as f32;
+            path.push(pos);
+        }
+        Ok(Self {
+            rig,
+            root,
+            bones,
+            head: rig.bone(Chain::Head, 0),
+            front,
+            lambda,
+            speed: p.get(SLITHER, "speed"),
+            path,
+        })
+    }
+
+    /// Point du chemin à l'abscisse `sigma` (canonique : x latéral, z avant).
+    fn at(&self, sigma: f32) -> Vec3 {
+        let n = self.path.len() - 1;
+        let drift = self.path[n].y;
+        let turns = (sigma / self.lambda).floor();
+        let x = (sigma / self.lambda - turns) * n as f32;
+        let i = (x.floor() as usize).min(n - 1);
+        let p = self.path[i].lerp(self.path[i + 1], x - i as f32);
+        Vec3::new(p.x, 0.0, p.y + turns * drift)
+    }
+}
+
+impl Motion for Slither<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.lambda / self.speed
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let rig = self.rig;
+        body.reset();
+        let head = u * self.lambda;
+        let point = |d: f32| self.front + rig.w(self.at(head - d));
+        let (_, d_head, _) = self.bones[0];
+        body.shift(Some(self.root), rig.c(point(d_head) - rig.head(self.root)));
+        body.fk();
+        for &(b, _, d_tail) in &self.bones {
+            let target = point(d_tail);
+            body.aim(b, target - body.head(b));
+        }
+        if let Some(h) = self.head {
+            let ahead = rig.w(self.at(head + 0.05 * self.lambda) - self.at(head));
+            body.aim(h, ahead);
+        }
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/ctx.rs b/crates/bones-core/src/presets/procedural/ctx.rs
new file mode 100644
index 0000000..2a9e43f
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/ctx.rs
@@ -0,0 +1,215 @@
+//! Contexte des générateurs : rôles et repère du squelette cible
+//! ([`Rigging`]), et pose de travail avec ses transformations monde
+//! ([`Body`]) : rotations autour d'axes canoniques, visée, IK à deux os.
+//!
+//! Repère canonique : X à gauche, Y en haut, Z vers l'avant. Une rotation
+//! « canonique » d'un os est exprimée dans le repère de son parent au
+//! repos : tourner la cuisse autour de l'axe gauche la lève vers l'avant,
+//! quelle que soit l'orientation de ses axes locaux.
+
+use glam::{Quat, Vec3};
+
+use crate::math::rotation_arc;
+use crate::presets::roles::{BodyFrame, Chain, RoleMap};
+use crate::{BoneId, Pose, Skeleton, Transform, head_tail};
+
+/// Squelette cible vu par un générateur.
+pub(crate) struct Rigging<'a> {
+    pub skeleton: &'a Skeleton,
+    pub roles: &'a RoleMap,
+    /// Transformations monde au repos.
+    pub rest: Vec<Transform>,
+    /// Canonique → monde.
+    pub basis: Quat,
+    pub frame: BodyFrame,
+}
+
+impl<'a> Rigging<'a> {
+    pub fn new(skeleton: &'a Skeleton, roles: &'a RoleMap) -> Self {
+        Self {
+            skeleton,
+            roles,
+            rest: skeleton.rest_world(),
+            basis: roles.frame.basis(),
+            frame: roles.frame,
+        }
+    }
+
+    pub fn bone(&self, chain: Chain, index: u8) -> Option<BoneId> {
+        self.roles.bone(chain, index)
+    }
+
+    pub fn chain(&self, chain: Chain) -> Vec<BoneId> {
+        self.roles.chain(chain)
+    }
+
+    /// Vecteur canonique → monde.
+    pub fn w(&self, v: Vec3) -> Vec3 {
+        self.basis * v
+    }
+
+    /// Vecteur monde → canonique.
+    pub fn c(&self, v: Vec3) -> Vec3 {
+        self.basis.inverse() * v
+    }
+
+    pub fn head(&self, b: BoneId) -> Vec3 {
+        self.rest[b.index()].translation
+    }
+
+    pub fn tail(&self, b: BoneId) -> Vec3 {
+        head_tail(&self.rest[b.index()], self.skeleton.bone(b).length).1
+    }
+
+    pub fn len(&self, b: BoneId) -> f32 {
+        (self.tail(b) - self.head(b)).length()
+    }
+
+    /// Direction monde de repos de l'os.
+    pub fn dir(&self, b: BoneId) -> Vec3 {
+        (self.tail(b) - self.head(b)).normalize_or(Vec3::Y)
+    }
+
+    /// Hauteur d'un point au-dessus du sol.
+    pub fn height(&self, p: Vec3) -> f32 {
+        (p - self.frame.up * self.frame.ground).dot(self.frame.up)
+    }
+
+    /// Projection d'un point sur le sol.
+    pub fn on_ground(&self, p: Vec3) -> Vec3 {
+        p - self.frame.up * self.height(p)
+    }
+}
+
+/// Pose en construction et ses transformations monde.
+pub(crate) struct Body<'r, 'a> {
+    pub rig: &'r Rigging<'a>,
+    pub pose: Pose,
+    pub world: Vec<Transform>,
+}
+
+impl<'r, 'a> Body<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>) -> Self {
+        Self {
+            rig,
+            pose: Pose::rest(rig.skeleton),
+            world: rig.rest.clone(),
+        }
+    }
+
+    /// Retour à la pose de repos.
+    pub fn reset(&mut self) {
+        self.pose.bones.fill(Transform::IDENTITY);
+        self.world.clone_from(&self.rig.rest);
+    }
+
+    /// Rotation de `angle` (radians) autour d'un axe canonique, appliquée
+    /// par-dessus la rotation actuelle de l'os (pose seulement : appeler
+    /// [`Self::fk`] ensuite).
+    pub fn turn(&mut self, bone: Option<BoneId>, axis: Vec3, angle: f32) {
+        if let Some(b) = bone
+            && angle != 0.0
+        {
+            let q = Quat::from_axis_angle(self.rig.w(axis).normalize_or(Vec3::Y), angle);
+            self.turn_world(b, q);
+        }
+    }
+
+    /// Rotation exprimée en monde (au repos du parent), cumulée.
+    pub fn turn_world(&mut self, bone: BoneId, q: Quat) {
+        let rest = self.rig.rest[bone.index()].rotation;
+        let local = (rest.inverse() * q * rest).normalize();
+        let delta = &mut self.pose.bones[bone.index()];
+        delta.rotation = (local * delta.rotation).normalize();
+    }
+
+    /// Déplacement (canonique, en mètres) d'un os dont le parent est immobile.
+    pub fn shift(&mut self, bone: Option<BoneId>, offset: Vec3) {
+        let Some(b) = bone else { return };
+        let rest = &self.rig.rest[b.index()];
+        let local = rest.rotation.inverse() * self.rig.w(offset) / rest.scale;
+        self.pose.bones[b.index()].translation += local;
+    }
+
+    /// Recalcule toutes les transformations monde depuis la pose.
+    pub fn fk(&mut self) {
+        self.refresh(BoneId(0));
+    }
+
+    /// Recalcule les transformations monde des os d'indice ≥ `from`.
+    pub fn refresh(&mut self, from: BoneId) {
+        let skeleton = self.rig.skeleton;
+        for i in from.index()..skeleton.len() {
+            let bone = &skeleton.bones()[i];
+            let local = bone.rest.mul(&self.pose.bones[i]);
+            self.world[i] = match bone.parent() {
+                Some(p) => self.world[p.index()].mul(&local),
+                None => local,
+            };
+        }
+    }
+
+    pub fn head(&self, b: BoneId) -> Vec3 {
+        self.world[b.index()].translation
+    }
+
+    pub fn tail(&self, b: BoneId) -> Vec3 {
+        head_tail(&self.world[b.index()], self.rig.skeleton.bone(b).length).1
+    }
+
+    pub fn rotation(&self, b: BoneId) -> Quat {
+        self.world[b.index()].rotation
+    }
+
+    /// Donne à l'os la rotation monde `rotation` (descendants mis à jour).
+    pub fn set_rotation(&mut self, b: BoneId, rotation: Quat) {
+        let bone = self.rig.skeleton.bone(b);
+        let parent = bone.parent().map_or(Quat::IDENTITY, |p| self.world[p.index()].rotation);
+        let basis = (parent * bone.rest.rotation).normalize();
+        self.pose.bones[b.index()].rotation = (basis.inverse() * rotation).normalize();
+        self.refresh(b);
+    }
+
+    /// Applique une rotation monde autour de la tête de l'os.
+    pub fn rotate(&mut self, b: BoneId, q: Quat) {
+        let r = (q * self.rotation(b)).normalize();
+        self.set_rotation(b, r);
+    }
+
+    /// Oriente l'os vers une direction monde (rotation minimale).
+    pub fn aim(&mut self, b: BoneId, dir: Vec3) {
+        let current = self.tail(b) - self.head(b);
+        self.rotate(b, rotation_arc(current, dir));
+    }
+
+    /// Torsion autour de l'axe actuel de l'os.
+    pub fn twist(&mut self, b: BoneId, angle: f32) {
+        let axis = (self.tail(b) - self.head(b)).normalize_or(Vec3::Y);
+        self.rotate(b, Quat::from_axis_angle(axis, angle));
+    }
+
+    /// IK analytique à deux os : la queue de `lower` vers `target`, le
+    /// coude ou le genou vers `pole`. Retourne vrai si la cible est atteinte.
+    pub fn two_bone(&mut self, upper: BoneId, lower: BoneId, target: Vec3, pole: Vec3) -> bool {
+        let a = self.head(upper);
+        let b = self.head(lower);
+        let c = self.tail(lower);
+        let (la, lb) = ((b - a).length(), (c - b).length());
+        if la < 1e-6 || lb < 1e-6 {
+            return false;
+        }
+        let reach = (target - a).length();
+        let dist = reach.clamp((la - lb).abs() + 1e-5, la + lb - 1e-5);
+        let dir = (target - a).try_normalize().unwrap_or((c - a).normalize_or(Vec3::Y));
+        let side = |v: Vec3| (v - dir * v.dot(dir)).try_normalize();
+        let bend = side(pole - a)
+            .or_else(|| side(b - a))
+            .unwrap_or_else(|| dir.any_orthonormal_vector());
+        let cos_a = ((la * la + dist * dist - lb * lb) / (2.0 * la * dist)).clamp(-1.0, 1.0);
+        let elbow = a + (dir * cos_a + bend * (1.0 - cos_a * cos_a).sqrt()) * la;
+        self.rotate(upper, rotation_arc(b - a, elbow - a));
+        let (b, c) = (self.head(lower), self.tail(lower));
+        self.rotate(lower, rotation_arc(c - b, a + dir * dist - b));
+        (reach - dist).abs() < 1e-3
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/curves.rs b/crates/bones-core/src/presets/procedural/curves.rs
new file mode 100644
index 0000000..46d55b0
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/curves.rs
@@ -0,0 +1,152 @@
+//! Courbes utilitaires des générateurs : adoucissements, trajectoire à jerk
+//! minimal, bosse, bruit périodique (bouclable) et courbes à clés.
+
+use std::f32::consts::{PI, TAU};
+
+/// Adoucissement cubique sur [0, 1].
+pub(crate) fn smooth(t: f32) -> f32 {
+    let t = t.clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// Trajectoire à jerk minimal (vitesse et accélération nulles aux bouts),
+/// celle des mouvements humains volontaires (Flash & Hogan, 1985).
+pub(crate) fn minjerk(t: f32) -> f32 {
+    let t = t.clamp(0.0, 1.0);
+    t * t * t * (10.0 + t * (-15.0 + 6.0 * t))
+}
+
+/// Bosse sur [0, 1] (nulle aux bouts) culminant à `peak` (0 < peak < 1).
+pub(crate) fn bump(u: f32, peak: f32) -> f32 {
+    let u = u.clamp(0.0, 1.0);
+    let k = 0.5f32.ln() / peak.clamp(0.05, 0.95).ln();
+    (PI * u.powf(k)).sin()
+}
+
+/// Sinus d'une phase exprimée en tours.
+pub(crate) fn wave(turns: f32) -> f32 {
+    (TAU * turns).sin()
+}
+
+/// Cosinus d'une phase exprimée en tours.
+pub(crate) fn cwave(turns: f32) -> f32 {
+    (TAU * turns).cos()
+}
+
+/// Bruit doux et périodique de période 1 (somme d'harmoniques entières
+/// aux phases pseudo-aléatoires), dans [−1, 1] environ.
+pub(crate) fn noise(u: f32, seed: u32, harmonics: &[u32]) -> f32 {
+    let mut sum = 0.0;
+    let mut weight = 0.0;
+    for (i, h) in harmonics.iter().enumerate() {
+        let phase = hash(seed.wrapping_mul(31).wrapping_add(i as u32));
+        let a = 1.0 / (1.0 + i as f32);
+        sum += a * wave(*h as f32 * u + phase);
+        weight += a;
+    }
+    sum / weight.max(1e-6)
+}
+
+/// Nombre pseudo-aléatoire dans [0, 1) dérivé d'un entier.
+pub(crate) fn hash(n: u32) -> f32 {
+    let mut x = n.wrapping_mul(0x9E37_79B9) ^ 0x85EB_CA6B;
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x2C1B_3C6D);
+    x ^= x >> 12;
+    (x & 0xFF_FFFF) as f32 / 16_777_216.0
+}
+
+/// Courbe à clés (temps, valeur) : Hermite cubique, tangentes de
+/// Catmull-Rom annulées aux extremums et aux paliers (pas de dépassement).
+pub(crate) struct Curve {
+    keys: Vec<(f32, f32)>,
+}
+
+impl Curve {
+    pub fn new(keys: &[(f32, f32)]) -> Self {
+        let mut keys = keys.to_vec();
+        keys.sort_by(|a, b| a.0.total_cmp(&b.0));
+        Self { keys }
+    }
+
+    fn tangent(&self, i: usize) -> f32 {
+        let k = &self.keys;
+        if i == 0 || i + 1 >= k.len() {
+            return 0.0;
+        }
+        let (prev, cur, next) = (k[i - 1], k[i], k[i + 1]);
+        if (cur.1 - prev.1) * (next.1 - cur.1) <= 0.0 {
+            return 0.0;
+        }
+        (next.1 - prev.1) / (next.0 - prev.0).max(1e-6)
+    }
+
+    pub fn at(&self, t: f32) -> f32 {
+        let k = &self.keys;
+        match k.len() {
+            0 => return 0.0,
+            1 => return k[0].1,
+            _ => {}
+        }
+        if t <= k[0].0 {
+            return k[0].1;
+        }
+        if t >= k[k.len() - 1].0 {
+            return k[k.len() - 1].1;
+        }
+        let i = k.partition_point(|key| key.0 <= t).max(1) - 1;
+        let (t0, p0) = k[i];
+        let (t1, p1) = k[i + 1];
+        let dt = (t1 - t0).max(1e-6);
+        let s = (t - t0) / dt;
+        let (m0, m1) = (self.tangent(i) * dt, self.tangent(i + 1) * dt);
+        let (s2, s3) = (s * s, s * s * s);
+        p0 * (2.0 * s3 - 3.0 * s2 + 1.0) + m0 * (s3 - 2.0 * s2 + s) + p1 * (3.0 * s2 - 2.0 * s3) + m1 * (s3 - s2)
+    }
+}
+
+/// Polynôme d'Hermite : position à `t` ∈ [0, dt] partant de `p0` à la
+/// vitesse `v0` pour arriver en `p1` à la vitesse `v1`.
+pub(crate) fn hermite(p0: f32, v0: f32, p1: f32, v1: f32, t: f32, dt: f32) -> f32 {
+    let s = (t / dt.max(1e-6)).clamp(0.0, 1.0);
+    let (s2, s3) = (s * s, s * s * s);
+    p0 * (2.0 * s3 - 3.0 * s2 + 1.0)
+        + v0 * dt * (s3 - 2.0 * s2 + s)
+        + p1 * (3.0 * s2 - 2.0 * s3)
+        + v1 * dt * (s3 - s2)
+}
+
+/// Enveloppe supérieure d'un signal périodique échantillonné, à
+/// accélération bornée (dilatation par une parabole) : la courbe obtenue
+/// reste au-dessus de `need`, sans changement de vitesse brusque.
+pub(crate) fn envelope(need: &[f32], dt: f32, accel: f32) -> Vec<f32> {
+    let n = need.len();
+    (0..n)
+        .map(|i| {
+            (0..n)
+                .map(|j| {
+                    let k = i.abs_diff(j).min(n - i.abs_diff(j)) as f32 * dt;
+                    need[j] - 0.5 * accel * k * k
+                })
+                .fold(f32::MIN, f32::max)
+        })
+        .collect()
+}
+
+/// Valeur d'un signal périodique échantillonné (période 1) à `u`,
+/// interpolée par Catmull-Rom.
+pub(crate) fn periodic(samples: &[f32], u: f32) -> f32 {
+    let n = samples.len();
+    if n == 0 {
+        return 0.0;
+    }
+    let x = u.rem_euclid(1.0) * n as f32;
+    let i = x.floor() as usize;
+    let t = x - i as f32;
+    let p = |k: usize| samples[(i + n + k - 1) % n];
+    let (p0, p1, p2, p3) = (p(0), p(1), p(2), p(3));
+    0.5 * (2.0 * p1
+        + (p2 - p0) * t
+        + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t * t
+        + (3.0 * p1 - p0 - 3.0 * p2 + p3) * t * t * t)
+}
