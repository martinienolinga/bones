+}
+
+#[test]
+fn spider_legs_are_numbered_front_to_back() {
+    let s = RefRig::Spider.skeleton();
+    let map = detect(&s);
+    assert_eq!(map.rig_type, RigType::MultiLegged);
+    for pair in 0..4u8 {
