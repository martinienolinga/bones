diff --git a/crates/bones-core/src/presets/procedural/human/postures.rs b/crates/bones-core/src/presets/procedural/human/postures.rs
new file mode 100644
index 0000000..9473916
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/postures.rs
@@ -0,0 +1,144 @@
+//! Changements de posture : s'accroupir, s'asseoir, se relever. Les pieds
+//! restent plantés (IK) ; le buste se penche pour garder le centre de
+//! masse au-dessus des appuis.
+
+use glam::Vec3;
+
+use super::rig::Human;
+use super::stance::Foot;
+use crate::presets::error::PresetError;
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::procedural::Motion;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::procedural::curves::{Curve, minjerk, wave};
+use crate::presets::roles::Lr;
+
+pub(crate) const CROUCH: &[ParamSpec] = &[
+    ParamSpec::new("depth", "Depth", 0.2, 1.0, 0.85),
+    ParamSpec::new("hold", "Hold (s)", 0.0, 4.0, 1.2),
+];
+
+/// S'accroupir, rester accroupi en respirant, se relever.
+pub(crate) struct Crouch<'r, 'a> {
+    h: Human<'r, 'a>,
+    depth: f32,
+    times: [f32; 3],
+}
+
+impl<'r, 'a> Crouch<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        let hold = p.get(CROUCH, "hold");
+        Ok(Self {
+            h: Human::new(rig)?,
+            depth: p.get(CROUCH, "depth"),
+            times: [0.7, 0.7 + hold, 1.5 + hold],
+        })
+    }
+}
+
+impl Motion for Crouch<'_, '_> {
+    fn duration(&self) -> f32 {
+        self.times[2] + 0.3
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let [down, hold, up] = self.times;
+        let t = u.clamp(0.0, 1.0) * self.duration();
+        let k = if t < down {
+            minjerk(t / down)
+        } else if t < hold {
+            1.0
+        } else {
+            1.0 - minjerk((t - hold) / (up - hold))
+        };
+        let d = self.depth * k;
+        let leg = h.legs[0].length;
+        let breath = if t >= down && t < hold { 0.01 * leg * wave((t - down) / 2.5) } else { 0.0 };
+        body.reset();
+        let offset = Vec3::new(0.0, -0.5 * leg * d + breath, -0.12 * leg * d);
+        h.pelvis(body, offset, 0.0, 0.25 * d, 0.0);
+        h.bend_spine(body, 0.3 * d, 0.0, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 0.3 + 0.2 * d);
+        }
+        body.fk();
+        // Talons levés en accroupissement profond.
+        let heel = Foot {
+            pitch: -0.5 * ((d - 0.7) / 0.3).clamp(0.0, 1.0),
+            ..Foot::default()
+        };
+        h.stand(body, [heel, heel]);
+        let swing = 0.9 * d;
+        h.relax_arms(body, [swing, swing], 0.15 + 0.15 * d, 0.3 + 0.6 * d);
+        h.look(body, -0.15 * d, 0.0, 0.0);
+    }
+}
+
+pub(crate) const SIT: &[ParamSpec] = &[
+    ParamSpec::new("seat", "Seat height", 0.35, 0.75, 0.52),
+    ParamSpec::toggle("reverse", "Stand up instead", false),
+];
+
+/// S'asseoir sur une chaise (ou se relever) : le buste se penche, le bassin
+/// recule et descend, puis le buste se redresse ; les mains finissent sur
+/// les cuisses.
+pub(crate) struct Sit<'r, 'a> {
+    h: Human<'r, 'a>,
+    seat: f32,
+    reverse: bool,
+    lean: Curve,
+    descend: Curve,
+}
+
+impl<'r, 'a> Sit<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>, p: &Params) -> Result<Self, PresetError> {
+        Ok(Self {
+            h: Human::new(rig)?,
+            seat: p.get(SIT, "seat"),
+            reverse: p.flag(SIT, "reverse"),
+            lean: Curve::new(&[(0.0, 0.0), (0.35, 0.65), (0.6, 0.55), (0.9, 0.08), (1.0, 0.08)]),
+            descend: Curve::new(&[(0.0, 0.0), (0.15, 0.0), (0.75, 1.0), (1.0, 1.0)]),
+        })
+    }
+}
+
+impl Motion for Sit<'_, '_> {
+    fn duration(&self) -> f32 {
+        2.2
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let h = &self.h;
+        let u = u.clamp(0.0, 1.0);
+        let u = if self.reverse { 1.0 - u } else { u };
+        let k = self.descend.at(u);
+        let lean = self.lean.at(u);
+        let thigh = h.rig.len(h.legs[0].thigh);
+        let drop = h.hip_height * (1.0 - self.seat);
+        body.reset();
+        h.pelvis(body, Vec3::new(0.0, -drop * k, -0.85 * thigh * k), 0.0, 0.3 * lean, 0.0);
+        h.bend_spine(body, 0.7 * lean, 0.0, 0.0);
+        for side in Lr::BOTH {
+            h.curl(body, side, 0.3);
+        }
+        body.fk();
+        // Les pieds reculent un peu pour se placer sous les genoux.
+        let feet = Foot::at(0.0, -0.06 * thigh * k);
+        h.stand(body, [feet, feet]);
+        // Bras en avant pendant la descente, mains sur les cuisses ensuite.
+        for side in Lr::BOTH {
+            let leg = h.leg_of(side);
+            let knee = body.head(leg.shin);
+            let hip = body.head(leg.thigh);
+            let on_thigh = hip.lerp(knee, 0.75) + h.rig.frame.up * 0.06 * thigh;
+            let forward = 1.2 * (lean - 0.1).max(0.0);
+            h.swing_arm(body, side, 0.12, forward, 0.4, 0.1);
+            let hand = body.tail(h.arm_of(side).map_or(leg.shin, |a| a.fore));
+            let w = ((k - 0.7) / 0.3).clamp(0.0, 1.0);
+            let pole = body.head(h.arm_of(side).map_or(leg.shin, |a| a.fore)) - h.rig.w(Vec3::Z) * 0.3;
+            h.reach(body, side, hand.lerp(on_thigh, w), pole, 0.2 * w);
+        }
+        h.look(body, -0.1 * lean, 0.0, 0.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/rig.rs b/crates/bones-core/src/presets/procedural/human/rig.rs
new file mode 100644
index 0000000..633bbed
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/rig.rs
@@ -0,0 +1,171 @@
+//! Squelette humanoïde vu par les générateurs : os par rôle, géométrie de
+//! repos (hanches, chevilles, talons, plantes de pied) et gestes de base
+//! (bassin, colonne, regard, pieds en IK, bras, mains).
+
+use glam::Vec3;
+
+use crate::BoneId;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::roles::{Chain, Lr};
+
+pub(crate) struct Leg {
+    pub side: Lr,
+    pub thigh: BoneId,
+    pub shin: BoneId,
+    pub foot: Option<BoneId>,
+    pub toe: Option<BoneId>,
+    /// Points de repos (monde) : cheville, plante (base des orteils) et
+    /// talon, ces deux derniers posés au sol.
+    pub ankle: Vec3,
+    pub ball: Vec3,
+    pub heel: Vec3,
+    /// Cuisse + jambe.
+    pub length: f32,
+    /// Sens de flexion du genou au repos (monde).
+    pub bend: Vec3,
+}
+
+pub(crate) struct Arm {
+    pub side: Lr,
+    pub clavicle: Option<BoneId>,
+    pub upper: BoneId,
+    pub fore: BoneId,
+    pub hand: Option<BoneId>,
+    pub fingers: Vec<Vec<BoneId>>,
+    pub length: f32,
+    /// Direction de flexion du coude au repos (monde), ⟂ au bras.
+    pub flex: Vec3,
+    /// Normale de la paume au repos (monde).
+    pub palm: Vec3,
+}
+
+pub(crate) struct Human<'r, 'a> {
+    pub rig: &'r Rigging<'a>,
+    pub root: BoneId,
+    pub spine: Vec<BoneId>,
+    pub neck: Vec<BoneId>,
+    pub head: Option<BoneId>,
+    pub legs: [Leg; 2],
+    pub arms: [Option<Arm>; 2],
+    /// Hauteur du bassin au-dessus du sol au repos.
+    pub hip_height: f32,
+}
+
+impl<'r, 'a> Human<'r, 'a> {
+    pub fn new(rig: &'r Rigging<'a>) -> Result<Self, PresetError> {
+        let root = rig.bone(Chain::Root, 0).ok_or_else(|| incompatible("no hips bone"))?;
+        let leg = |side| -> Result<Leg, PresetError> {
+            let chain = rig.chain(Chain::Leg(side));
+            if chain.len() < 2 {
+                return Err(incompatible(format!("{} leg not found", side.label().to_lowercase())));
+            }
+            Ok(Self::leg(rig, side, &chain))
+        };
+        let legs = [leg(Lr::Left)?, leg(Lr::Right)?];
+        let arm = |side| Self::arm(rig, side);
+        let hip_height = rig.height(rig.head(root)).max(0.05);
+        Ok(Self {
+            rig,
+            root,
+            spine: rig.chain(Chain::Spine),
+            neck: rig.chain(Chain::Neck),
+            head: rig.bone(Chain::Head, 0),
+            legs,
+            arms: [arm(Lr::Left), arm(Lr::Right)],
+            hip_height,
+        })
+    }
+
+    fn leg(rig: &Rigging, side: Lr, chain: &[BoneId]) -> Leg {
+        let (thigh, shin) = (chain[0], chain[1]);
+        let foot = chain.get(2).copied();
+        let toe = chain.get(3).copied();
+        let ankle = rig.tail(shin);
+        let forward = rig.w(Vec3::Z);
+        let ball = match foot {
+            Some(f) => rig.on_ground(rig.tail(f)),
+            None => rig.on_ground(ankle) + forward * 0.12 * rig.len(shin),
+        };
+        let foot_len = (ball - rig.on_ground(ankle)).length().max(0.05 * rig.len(shin));
+        let heel = rig.on_ground(ankle) - forward * 0.25 * foot_len;
+        let (hip, knee) = (rig.head(thigh), rig.head(shin));
+        let axis = (ankle - hip).normalize_or(-rig.frame.up);
+        let off = knee - hip;
+        let bend = (off - axis * off.dot(axis))
+            .try_normalize()
+            .filter(|b| b.dot(forward) > -0.5)
+            .unwrap_or(forward);
+        Leg {
+            side,
+            thigh,
+            shin,
+            foot,
+            toe,
+            ankle,
+            ball,
+            heel,
+            length: rig.len(thigh) + rig.len(shin),
+            bend,
+        }
+    }
+
+    fn arm(rig: &Rigging, side: Lr) -> Option<Arm> {
+        let chain = rig.chain(Chain::Arm(side));
+        let (&upper, &fore) = (chain.first()?, chain.get(1)?);
+        let dir = rig.dir(upper);
+        let forward = rig.w(Vec3::Z);
+        let flex = (forward - dir * forward.dot(dir)).normalize_or(forward);
+        let fingers: Vec<Vec<BoneId>> = (0..5)
+            .map(|f| rig.chain(Chain::Finger(side, f)))
+            .filter(|c| !c.is_empty())
+            .collect();
+        let hand = chain.get(2).copied();
+        // Paume : du côté opposé au dos de la main (index → auriculaire × main).
+        let index = rig.bone(Chain::Finger(side, 1), 0);
+        let pinky = rig.bone(Chain::Finger(side, 4), 0).or(rig.bone(Chain::Finger(side, 3), 0));
+        let palm = match (hand, index, pinky) {
+            (Some(h), Some(i), Some(p)) => {
+                let across = rig.head(i) - rig.head(p);
+                (-side.sign() * across.cross(rig.dir(h))).normalize_or(-rig.frame.up)
+            }
+            _ => -rig.frame.up,
+        };
+        Some(Arm {
+            side,
+            clavicle: rig.bone(Chain::Clavicle(side), 0),
+            upper,
+            fore,
+            hand,
+            fingers,
+            length: rig.len(upper) + rig.len(fore),
+            flex,
+            palm,
+        })
+    }
+
+    pub fn leg_of(&self, side: Lr) -> &Leg {
+        &self.legs[(side == Lr::Right) as usize]
+    }
+
+    pub fn arm_of(&self, side: Lr) -> Option<&Arm> {
+        self.arms[(side == Lr::Right) as usize].as_ref()
+    }
+
+    /// Bassin : déplacement canonique et rotations (lacet autour de Y,
+    /// tangage autour de X — positif penche vers l'avant —, roulis autour de Z).
+    pub fn pelvis(&self, body: &mut Body, offset: Vec3, yaw: f32, pitch: f32, roll: f32) {
+        body.pelvis(self.root, offset, yaw, pitch, roll);
+    }
+
+    /// Courbure de la colonne, répartie sur ses os.
+    pub fn bend_spine(&self, body: &mut Body, pitch: f32, yaw: f32, roll: f32) {
+        body.spread(&self.spine, pitch, yaw, roll);
+    }
+
+    /// Orientation monde de la tête (relative au repère du corps) après la
+    /// cinématique directe : le cou fait la moitié du chemin.
+    pub fn look(&self, body: &mut Body, pitch: f32, yaw: f32, roll: f32) {
+        body.look(&self.neck, self.head, pitch, yaw, roll);
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/human/stance.rs b/crates/bones-core/src/presets/procedural/human/stance.rs
new file mode 100644
index 0000000..fc63211
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/human/stance.rs
@@ -0,0 +1,87 @@
+//! Postures debout communes aux actions humaines : pieds posés (décalés,
+//! tournés, talons levés), bras relâchés, garde de combat.
+
+use glam::{Quat, Vec3};
+
+use super::rig::Human;
+use crate::presets::procedural::ctx::Body;
+use crate::presets::roles::Lr;
+
+/// Pied posé : décalage canonique depuis la place de repos, lacet et
+/// tangage (négatif : talon levé, positif : pointe levée).
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Foot {
+    pub offset: Vec3,
+    pub yaw: f32,
+    pub pitch: f32,
+    /// Hauteur du pied au-dessus du sol (pied levé), en mètres.
+    pub lift: f32,
+}
+
+impl Foot {
+    pub fn at(x: f32, z: f32) -> Self {
+        Self {
+            offset: Vec3::new(x, 0.0, z),
+            ..Self::default()
+        }
+    }
+}
+
+impl Human<'_, '_> {
+    /// Pose les deux pieds (IK) ; les orteils restent à plat quand le talon est levé.
+    pub fn stand(&self, body: &mut Body, feet: [Foot; 2]) {
+        for (side, foot) in Lr::BOTH.into_iter().zip(feet) {
+            let leg = self.leg_of(side);
+            let flat = leg.ankle + self.rig.w(foot.offset);
+            let ankle = self.rolled_ankle(side, flat, foot.pitch, foot.yaw) + self.rig.frame.up * foot.lift;
+            let toe = if foot.pitch < 0.0 && foot.lift < 1e-3 { 1.0 } else { 0.0 };
+            self.place_foot(body, side, ankle, foot.pitch, foot.yaw, toe);
+        }
+    }
+
+    /// Bras relâchés le long du corps, avec un balancement avant/arrière.
+    pub fn relax_arms(&self, body: &mut Body, swing: [f32; 2], abduct: f32, elbow: f32) {
+        for (side, s) in Lr::BOTH.into_iter().zip(swing) {
+            self.swing_arm(body, side, abduct, s, elbow + 0.3 * s.max(0.0), 0.1);
+        }
+    }
+
+    /// Épaule (tête du bras) en pose.
+    pub fn shoulder(&self, body: &Body, side: Lr) -> Vec3 {
+        self.arm_of(side).map_or(body.head(self.root), |a| body.head(a.upper))
+    }
+
+    /// Point canonique relatif à l'épaule, tourné avec la poitrine.
+    pub fn from_shoulder(&self, body: &Body, side: Lr, offset: Vec3) -> Vec3 {
+        let chest = self.spine.last().copied().unwrap_or(self.root);
+        let turn = body.rotation(chest) * self.rig.rest[chest.index()].rotation.inverse();
+        self.shoulder(body, side) + turn * self.rig.w(offset)
+    }
+
+    /// Main vers un point relatif à l'épaule (canonique, suit la poitrine),
+    /// coude vers un pôle relatif lui aussi.
+    pub fn reach_from_shoulder(&self, body: &mut Body, side: Lr, hand: Vec3, elbow: Vec3, wrist: f32) {
+        let target = self.from_shoulder(body, side, hand);
+        let pole = self.from_shoulder(body, side, elbow);
+        self.reach(body, side, target, pole, wrist);
+    }
+
+    /// Garde de boxe : poing devant le menton et coude bas, en décalages
+    /// canoniques depuis l'épaule (main, pôle du coude).
+    pub fn guard_offsets(&self, side: Lr) -> (Vec3, Vec3) {
+        let s = side.sign();
+        let arm = self.arm_of(side).map_or(0.6, |a| a.length);
+        (Vec3::new(-s * 0.12, 0.12, 0.42) * arm / 0.6, Vec3::new(s * 0.4, -0.8, 0.05))
+    }
+
+    /// Garde, ou mélange vers une autre position de main (`toward`, poids `w`).
+    pub fn guard(&self, body: &mut Body, side: Lr, toward: Vec3, w: f32) {
+        let (hand, elbow) = self.guard_offsets(side);
+        self.reach_from_shoulder(body, side, hand.lerp(toward, w), elbow, -0.2 * (1.0 - w));
+    }
+
+    /// Rotation canonique → monde d'un lacet autour de la verticale.
+    pub fn heading(&self, yaw: f32) -> Quat {
+        Quat::from_axis_angle(self.rig.frame.up, yaw)
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/misc.rs b/crates/bones-core/src/presets/procedural/misc.rs
new file mode 100644
index 0000000..3a9ea12
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/misc.rs
@@ -0,0 +1,252 @@
+//! Créatures et objets : queue qui remue, tentacule, corde qui se balance,
+//! pendule (période physique), mécanismes (roue et piston synchronisés).
+
+use std::f32::consts::{PI, TAU};
+
+use glam::{Quat, Vec3};
+
+use super::Motion;
+use super::ctx::{Body, Rigging};
+use super::curves::{cwave, wave};
+use crate::BoneId;
+use crate::anim::physics::GRAVITY;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+use crate::presets::roles::Chain;
+
+/// Chaînes animées : la queue si elle existe, sinon les chaînes libres,
+/// sinon tous les os depuis la racine.
+fn chains(rig: &Rigging, prefer_tail: bool) -> Vec<Vec<BoneId>> {
+    if prefer_tail {
+        let tail = rig.chain(Chain::Tail);
+        if !tail.is_empty() {
+            return vec![tail];
+        }
+    }
+    let mut out: Vec<Vec<BoneId>> = rig
+        .roles
+        .chains()
+        .into_iter()
+        .filter(|c| matches!(c, Chain::Branch(_) | Chain::Tail | Chain::Spine))
+        .map(|c| rig.chain(c))
+        .collect();
+    if out.is_empty() {
+        out.push(rig.skeleton.ids().collect());
+    }
+    // La racine fait partie de la première chaîne (pied d'une plante, tête d'une corde).
+    if let Some(r) = rig.bone(Chain::Root, 0)
+        && !prefer_tail
+        && rig.skeleton.bone(r).parent().is_none()
+    {
+        out[0].insert(0, r);
+    }
+    out
+}
+
+pub(crate) const WAG: &[ParamSpec] = &[
+    ParamSpec::new("rate", "Wags per second", 0.3, 8.0, 3.0),
+    ParamSpec::new("amplitude", "Amplitude", 0.1, 2.0, 1.0),
+    ParamSpec::new("lag", "Whip (phase lag)", 0.0, 1.0, 0.3),
+];
+
+pub(crate) const TENTACLE: &[ParamSpec] = &[
+    ParamSpec::new("rate", "Waves per second", 0.1, 3.0, 0.5),
+    ParamSpec::new("amplitude", "Amplitude", 0.1, 2.0, 1.0),
+    ParamSpec::new("wavelength", "Waves along the chain", 0.3, 3.0, 1.0),
+];
+
+/// Ondulation d'une ou plusieurs chaînes : queue qui remue (dans le plan
+/// horizontal) ou tentacule (deux axes, mouvement tournoyant).
+pub(crate) struct Wave {
+    chains: Vec<Vec<(BoneId, f32, f32, Vec3, Vec3)>>,
+    rate: f32,
+    amplitude: f32,
+    lag: f32,
+    swirl: bool,
+}
+
+impl Wave {
+    pub fn new(rig: &Rigging, p: &Params, tentacle: bool) -> Result<Self, PresetError> {
+        let specs = if tentacle { TENTACLE } else { WAG };
+        let lists = chains(rig, !tentacle);
+        let chains = lists
+            .into_iter()
+            .map(|bones| {
+                let total: f32 = bones.iter().map(|b| rig.len(*b)).sum::<f32>().max(1e-4);
+                let mut at = 0.0;
+                bones
+                    .into_iter()
+                    .map(|b| {
+                        let len = rig.len(b);
+                        let s = (at + 0.5 * len) / total;
+                        at += len;
+                        // Axes canoniques ⟂ à l'os : flexion principale et secondaire.
+                        let dir = rig.c(rig.dir(b));
+                        let a = dir.cross(Vec3::Y).try_normalize().unwrap_or(Vec3::X);
+                        let (a1, a2) = if tentacle { (a, dir.cross(a)) } else { (Vec3::Y, a) };
+                        (b, s, len / total, a1, a2)
+                    })
+                    .collect()
+            })
+            .collect();
+        Ok(Self {
+            chains,
+            rate: p.get(specs, "rate"),
+            amplitude: p.get(specs, "amplitude"),
+            lag: if tentacle { p.get(TENTACLE, "wavelength") } else { p.get(WAG, "lag") },
+            swirl: tentacle,
+        })
+    }
+}
+
+impl Motion for Wave {
+    fn duration(&self) -> f32 {
+        if self.swirl { 1.0 / self.rate } else { 2.0 / self.rate }
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        body.reset();
+        let cycles = if self.swirl { 1.0 } else { 2.0 };
+        for chain in &self.chains {
+            for &(b, s, weight, a1, a2) in chain {
+                let phase = cycles * u - self.lag * s;
+                let k = self.amplitude * weight * (0.4 + s) * if self.swirl { 2.5 } else { 1.6 };
+                body.turn(Some(b), a1, k * wave(phase));
+                if self.swirl {
+                    body.turn(Some(b), a2, 0.6 * k * cwave(phase));
+                }
+            }
+        }
+        body.fk();
+    }
+}
+
+pub(crate) const SWING: &[ParamSpec] = &[
+    ParamSpec::new("amplitude", "Amplitude (deg)", 2.0, 80.0, 25.0),
+    ParamSpec::new("bend", "Rope bend", 0.0, 2.0, 1.0),
+];
+
+/// Corde ou pendule : la chaîne oscille autour de son point d'attache avec
+/// la période d'un pendule pesant, T = 2π·√(L/g)·(1 + θ₀²/16) ; une corde
+/// se courbe en plus avec retard (mode d'onde le long de la corde).
+pub(crate) struct Swing {
+    chains: Vec<Vec<BoneId>>,
+    amplitude: f32,
+    bend: f32,
+    period: f32,
+}
+
+impl Swing {
+    pub fn new(rig: &Rigging, p: &Params, rope: bool) -> Result<Self, PresetError> {
+        let chains = chains(rig, false);
+        let length: f32 = chains[0].iter().map(|b| rig.len(*b)).sum();
+        if length < 1e-4 {
+            return Err(incompatible("chain too short"));
+        }
+        let amplitude = p.get(SWING, "amplitude").to_radians();
+        // Corde : pendule composé (centre d'oscillation aux 2/3) ; pendule : masse au bout.
+        let l = if rope { 2.0 / 3.0 * length } else { length };
+        let period = TAU * (l / GRAVITY).sqrt() * (1.0 + amplitude * amplitude / 16.0);
+        Ok(Self {
+            chains,
+            amplitude,
+            bend: if rope { p.get(SWING, "bend") } else { 0.0 },
+            period,
+        })
+    }
+}
+
+impl Motion for Swing {
+    fn duration(&self) -> f32 {
+        self.period
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        body.reset();
+        let a = self.amplitude;
+        for chain in &self.chains {
+            let n = chain.len().max(1) as f32;
+            for (i, b) in chain.iter().enumerate() {
+                if i == 0 {
+                    body.turn(Some(*b), Vec3::X, a * cwave(u));
+                    body.turn(Some(*b), Vec3::Z, 0.08 * a * self.bend * wave(u));
+                } else {
+                    let s = i as f32 / n;
+                    let lag = 0.25 * self.bend * a / n * (1.0 + s) * wave(u - 0.15 - 0.2 * s);
+                    body.turn(Some(*b), Vec3::X, -lag);
+                }
+            }
+        }
+        body.fk();
+    }
+}
+
+pub(crate) const MACHINE: &[ParamSpec] = &[
+    ParamSpec::new("rate", "Turns per second", 0.05, 20.0, 0.5),
+    ParamSpec::new("stroke", "Piston stroke (m)", 0.0, 2.0, 0.15),
+    ParamSpec::toggle("reverse", "Reverse", false),
+];
+
+/// Mécanisme : les roues (os nommés wheel, gear, rotor, fan, propeller…)
+/// tournent autour de leur axe, les pistons (piston, slider, plunger…)
+/// coulissent en phase, comme entraînés par une bielle. Sans os nommés,
+/// la racine tourne autour de la verticale.
+pub(crate) struct Machine {
+    wheels: Vec<BoneId>,
+    pistons: Vec<BoneId>,
+    spin_root: Option<BoneId>,
+    rate: f32,
+    stroke: f32,
+    sign: f32,
+}
+
+impl Machine {
+    pub fn new(rig: &Rigging, p: &Params) -> Result<Self, PresetError> {
+        let named = |keys: &[&str]| -> Vec<BoneId> {
+            rig.skeleton
+                .ids()
+                .filter(|b| {
+                    let n = rig.skeleton.bone(*b).name.to_lowercase();
+                    keys.iter().any(|k| n.contains(k))
+                })
+                .collect()
+        };
+        let wheels = named(&["wheel", "gear", "rotor", "fan", "propeller", "turbine", "cog", "spin", "axle"]);
+        let pistons = named(&["piston", "slider", "plunger", "pump", "press"]);
+        let spin_root = (wheels.is_empty() && pistons.is_empty())
+            .then(|| rig.bone(Chain::Root, 0).or(rig.skeleton.ids().next()))
+            .flatten();
+        Ok(Self {
+            wheels,
+            pistons,
+            spin_root,
+            rate: p.get(MACHINE, "rate"),
+            stroke: p.get(MACHINE, "stroke"),
+            sign: if p.flag(MACHINE, "reverse") { -1.0 } else { 1.0 },
+        })
+    }
+}
+
+impl Motion for Machine {
+    fn duration(&self) -> f32 {
+        1.0 / self.rate
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        body.reset();
+        let angle = self.sign * TAU * u;
+        for b in &self.wheels {
+            // Rotation autour de l'axe propre de l'os (Y local).
+            body.pose.bones[b.index()].rotation = Quat::from_rotation_y(angle);
+        }
+        for b in &self.pistons {
+            // Course d'une bielle-manivelle : (1 − cos θ) / 2.
+            let x = self.stroke * 0.5 * (1.0 - (angle + PI).cos());
+            body.pose.bones[b.index()].translation = Vec3::Y * x;
+        }
+        if let Some(r) = self.spin_root {
+            body.turn(Some(r), Vec3::Y, angle);
+        }
+        body.fk();
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/mod.rs b/crates/bones-core/src/presets/procedural/mod.rs
new file mode 100644
index 0000000..0504ee8
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/mod.rs
@@ -0,0 +1,107 @@
+//! Générateurs procéduraux : chaque préréglage procédural est un
+//! générateur et ses paramètres ; il produit des clés pour n'importe quel
+//! squelette dont il trouve les rôles nécessaires (proportions, longueurs de
+//! jambes et orientations de repos sont lues sur le squelette cible).
+//!
+//! Un générateur décrit la pose à un instant normalisé `u` (en cycles pour
+//! les boucles, dans [0, 1] pour les actions) ; la cuisson échantillonne
+//! une pose par image, en parallèle.
+
+pub(crate) mod animal;
+pub(crate) mod ctx;
+pub(crate) mod curves;
+mod generator;
+pub(crate) mod human;
+mod misc;
+mod plant;
+mod pose_ops;
+
+#[cfg(test)]
+pub(crate) mod tests;
+
+use rayon::prelude::*;
+
+pub use generator::Generator;
+
+use crate::io::rigging::clip_from_poses;
+use crate::presets::error::{PresetError, invalid};
+use crate::presets::params::Params;
+use crate::presets::roles::RoleMap;
+use crate::{Clip, Pose, Skeleton};
+use ctx::{Body, Rigging};
+
+/// Mouvement prêt à échantillonner sur un squelette.
+pub(crate) trait Motion: Sync {
+    /// Durée naturelle d'un cycle (ou de l'action), en secondes.
+    fn duration(&self) -> f32;
+    /// Pose au temps normalisé `u` (la pose de `body` est réinitialisée
+    /// par le générateur).
+    fn pose(&self, u: f32, body: &mut Body);
+}
+
+/// Nombre maximal d'images d'une cuisson.
+pub(crate) const MAX_FRAMES: u32 = 100_000;
+
+/// Cuisson d'un générateur : une clé par image (interpolation linéaire).
+///
+/// `speed` accélère le mouvement, `loops` répète les cycles (préréglages en
+/// boucle seulement ; le déplacement s'accumule).
+pub fn bake(
+    generator: Generator,
+    params: &Params,
+    skeleton: &Skeleton,
+    roles: &RoleMap,
+    fps: f32,
+    speed: f32,
+    loops: u32,
+) -> Result<Clip, PresetError> {
+    if !roles.fits(skeleton) {
+        return Err(invalid("bone roles do not match the skeleton"));
+    }
+    let rig = Rigging::new(skeleton, roles);
+    let motion = generator.build(&rig, params)?;
+    let fps = if fps.is_finite() { fps.clamp(1.0, 240.0) } else { 30.0 };
+    let speed = if speed.is_finite() { speed.clamp(0.05, 20.0) } else { 1.0 };
+    let duration = (motion.duration() / speed).clamp(1.0 / fps, 600.0);
+    let per_cycle = ((duration * fps).round() as u32).max(1);
+    let cycles = if generator.looping() { loops.max(1) } else { 1 };
+    let count = (per_cycle * cycles + 1).min(MAX_FRAMES);
+    let poses = sample(&*motion, &rig, per_cycle, count);
+    Ok(clip_from_poses(fps, poses))
+}
+
+/// Une pose par image `f` ∈ [0, count), au temps normalisé f / per_cycle.
+pub(crate) fn sample(motion: &dyn Motion, rig: &Rigging, per_cycle: u32, count: u32) -> Vec<Pose> {
+    (0..count)
+        .into_par_iter()
+        .map_init(
+            || Body::new(rig),
+            |body, f| {
+                motion.pose(f as f32 / per_cycle as f32, body);
+                body.pose.clone()
+            },
+        )
+        .collect()
+}
+
+/// Durée naturelle (secondes) et déplacement horizontal de la racine sur
+/// un cycle, sans cuisson complète ; `None` si le squelette ne convient pas.
+pub(crate) fn measure(
+    generator: Generator,
+    params: &Params,
+    skeleton: &Skeleton,
+    roles: &RoleMap,
+) -> Option<(f32, f32)> {
+    let rig = Rigging::new(skeleton, roles);
+    let motion = generator.build(&rig, params).ok()?;
+    let mut body = Body::new(&rig);
+    let root = roles.root().unwrap_or(crate::BoneId(0));
+    let mut at = |u: f32| {
+        motion.pose(u, &mut body);
+        body.fk();
+        body.world[root.index()].translation
+    };
+    let d = at(1.0) - at(0.0);
+    let up = roles.frame.up;
+    Some((motion.duration(), (d - up * d.dot(up)).length()))
+}
diff --git a/crates/bones-core/src/presets/procedural/plant.rs b/crates/bones-core/src/presets/procedural/plant.rs
new file mode 100644
index 0000000..6196d90
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/plant.rs
@@ -0,0 +1,129 @@
+//! Végétaux dans le vent : flexion statique dans le sens du vent,
+//! oscillation qui remonte la hiérarchie avec un retard de phase (l'onde
+//! part du tronc), amplitude croissante vers les extrémités souples,
+//! mouvement elliptique, rafales, frémissement des feuilles et poids des
+//! fleurs. Toutes les fréquences sont des harmoniques de la durée : la
+//! boucle est parfaite.
+
+use glam::Vec3;
+
+use super::Motion;
+use super::ctx::{Body, Rigging};
+use super::curves::{bump, noise, wave};
+use crate::BoneId;
+use crate::presets::error::{PresetError, incompatible};
+use crate::presets::params::{ParamSpec, Params};
+
+pub(crate) const PARAMS: &[ParamSpec] = &[
+    ParamSpec::new("wind", "Wind strength", 0.0, 2.0, 0.4),
+    ParamSpec::new("gust", "Gust", 0.0, 1.5, 0.0),
+    ParamSpec::new("frequency", "Sway frequency (Hz)", 0.05, 3.0, 0.45),
+    ParamSpec::new("delay", "Wave delay", 0.0, 2.0, 0.35),
+    ParamSpec::new("flutter", "Leaf flutter", 0.0, 2.0, 0.3),
+    ParamSpec::new("stiffness", "Stiffness", 0.2, 3.0, 1.0),
+    ParamSpec::new("droop", "Heavy top (droop)", 0.0, 1.0, 0.0),
+    ParamSpec::new("direction", "Wind direction (deg)", -180.0, 180.0, 0.0),
+    ParamSpec::new("duration", "Loop duration (s)", 2.0, 20.0, 8.0),
+];
+
+/// Os et sa place dans la plante.
+struct Part {
+    bone: BoneId,
+    /// Abscisse le long de la plante (0 au pied, 1 aux extrémités).
+    s: f32,
+    /// Part de la hauteur portée par l'os (longueur relative).
+    weight: f32,
+    /// Extrémité fine (feuille, pétale, rameau terminal).
+    leaf: bool,
+}
+
+pub(crate) struct Sway {
+    parts: Vec<Part>,
+    p: [f32; 8],
+    duration: f32,
+}
+
+impl Sway {
+    pub fn new(rig: &Rigging, p: &Params) -> Result<Self, PresetError> {
+        let skeleton = rig.skeleton;
+        if skeleton.is_empty() {
+            return Err(incompatible("empty skeleton"));
+        }
+        // Distance depuis le pied de la plante le long de la hiérarchie.
+        let mut start = vec![0.0f32; skeleton.len()];
+        let mut has_children = vec![false; skeleton.len()];
+        for (i, b) in skeleton.bones().iter().enumerate() {
+            if let Some(par) = b.parent() {
+                start[i] = start[par.index()] + rig.len(par);
+                has_children[par.index()] = true;
+            }
+        }
+        let total = skeleton
+            .ids()
+            .map(|b| start[b.index()] + rig.len(b))
+            .fold(1e-3f32, f32::max);
+        let parts = skeleton
+            .ids()
+            .map(|b| Part {
+                bone: b,
+                s: (start[b.index()] + 0.5 * rig.len(b)) / total,
+                weight: rig.len(b) / total,
+                leaf: !has_children[b.index()] && skeleton.depth(b) >= 2,
+            })
+            .collect();
+        let get = |k| p.get(PARAMS, k);
+        Ok(Self {
+            parts,
+            p: [
+                get("wind"),
+                get("gust"),
+                get("frequency"),
+                get("delay"),
+                get("flutter"),
+                get("stiffness"),
+                get("droop"),
+                get("direction").to_radians(),
+            ],
+            duration: get("duration"),
+        })
+    }
+}
+
+impl Motion for Sway {
+    fn duration(&self) -> f32 {
+        self.duration
+    }
+
+    fn pose(&self, u: f32, body: &mut Body) {
+        let [wind, gust, freq, delay, flutter, stiffness, droop, dir] = self.p;
+        body.reset();
+        let w = Vec3::new(dir.sin(), 0.0, dir.cos());
+        let bend_axis = Vec3::Y.cross(w);
+        // Nombre entier d'oscillations par boucle.
+        let cycles = (freq * self.duration).round().max(1.0);
+        let fast = (4.0 * freq * self.duration).round().max(2.0);
+        let g = 1.0 + 2.5 * gust * bump(u.rem_euclid(1.0), 0.3).powi(2);
+        for part in &self.parts {
+            let s = part.s;
+            let soft = (0.3 + s) / stiffness;
+            let seed = part.bone.0;
+            let phase = cycles * u - delay * s;
+            let lean = 0.5 * wind * g * soft;
+            let sway = 0.35 * wind * g * soft * (0.8 * wave(phase) + 0.4 * noise(u, seed, &[cycles as u32 + 1, 2 * cycles as u32 + 1]));
+            let cross = 0.15 * wind * g * soft * wave(phase + 0.25 + 0.1 * noise(u, seed + 7, &[1, 2]));
+            body.turn(Some(part.bone), bend_axis, (lean + sway) * part.weight * 2.0);
+            body.turn(Some(part.bone), w, cross * part.weight * 2.0);
+            if droop > 0.0 {
+                // Tête lourde : elle ploie vers le sol et hoche avec retard.
+                let nod = droop * s * s * (1.0 + 0.6 * wind * wave(phase - 0.2));
+                body.turn(Some(part.bone), bend_axis, nod * part.weight * 3.0);
+            }
+            if part.leaf && flutter > 0.0 {
+                let f = 0.3 * flutter * (0.5 + wind) * noise(u, seed + 31, &[fast as u32, fast as u32 + 3, 2 * fast as u32 + 1]);
+                body.turn(Some(part.bone), Vec3::Y, f);
+                body.turn(Some(part.bone), bend_axis, 0.6 * f);
+            }
+        }
+        body.fk();
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/pose_ops.rs b/crates/bones-core/src/presets/procedural/pose_ops.rs
new file mode 100644
index 0000000..31d4b5f
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/pose_ops.rs
@@ -0,0 +1,61 @@
+//! Gestes de corps communs à tous les générateurs : bassin, courbure d'une
+//! chaîne, orientation de la tête, ondulation d'une queue.
+
+use glam::{Quat, Vec3};
+
+use super::ctx::Body;
+use crate::BoneId;
+
+/// Rotation canonique tangage (X), lacet (Y), roulis (Z).
+pub(crate) fn euler(pitch: f32, yaw: f32, roll: f32) -> Quat {
+    Quat::from_rotation_y(yaw) * Quat::from_rotation_z(roll) * Quat::from_rotation_x(pitch)
+}
+
+impl Body<'_, '_> {
+    /// Bassin : déplacement canonique et rotations (lacet autour de Y,
+    /// tangage autour de X — positif penche vers l'avant —, roulis autour de Z).
+    pub fn pelvis(&mut self, root: BoneId, offset: Vec3, yaw: f32, pitch: f32, roll: f32) {
+        self.shift(Some(root), offset);
+        self.turn(Some(root), Vec3::X, pitch);
+        self.turn(Some(root), Vec3::Z, roll);
+        self.turn(Some(root), Vec3::Y, yaw);
+    }
+
+    /// Répartit une rotation canonique sur une chaîne (rotations relatives).
+    pub fn spread(&mut self, bones: &[BoneId], pitch: f32, yaw: f32, roll: f32) {
+        let n = bones.len().max(1) as f32;
+        for b in bones {
+            self.turn(Some(*b), Vec3::X, pitch / n);
+            self.turn(Some(*b), Vec3::Z, roll / n);
+            self.turn(Some(*b), Vec3::Y, yaw / n);
+        }
+    }
+
+    /// Orientation monde de la tête relative au repère du corps (après la
+    /// cinématique directe) ; le cou fait une partie du chemin.
+    pub fn look(&mut self, neck: &[BoneId], head: Option<BoneId>, pitch: f32, yaw: f32, roll: f32) {
+        let basis = self.rig.basis;
+        let q = basis * euler(pitch, yaw, roll) * basis.inverse();
+        for (i, b) in neck.iter().enumerate() {
+            let want = q * self.rig.rest[b.index()].rotation;
+            let t = (i + 1) as f32 / (neck.len() + 1) as f32 * 0.5;
+            let r = self.rotation(*b).slerp(want, t);
+            self.set_rotation(*b, r);
+        }
+        if let Some(h) = head {
+            self.set_rotation(h, q * self.rig.rest[h.index()].rotation);
+        }
+    }
+
+    /// Onde qui parcourt une chaîne (queue, tentacule) : chaque os tourne
+    /// autour de l'axe canonique `axis`, avec un retard de phase croissant
+    /// et une amplitude qui grandit vers le bout. `phase` en tours.
+    pub fn ripple(&mut self, bones: &[BoneId], axis: Vec3, amplitude: f32, phase: f32, lag: f32) {
+        let n = bones.len().max(1) as f32;
+        for (i, b) in bones.iter().enumerate() {
+            let s = (i as f32 + 1.0) / n;
+            let a = amplitude * (0.5 + s) / n * 2.0;
+            self.turn(Some(*b), axis, a * (std::f32::consts::TAU * (phase - lag * s)).sin());
+        }
+    }
+}
diff --git a/crates/bones-core/src/presets/procedural/tests.rs b/crates/bones-core/src/presets/procedural/tests.rs
new file mode 100644
index 0000000..06c1da6
--- /dev/null
+++ b/crates/bones-core/src/presets/procedural/tests.rs
@@ -0,0 +1,108 @@
+use glam::Vec3;
+
+use super::*;
+use crate::presets::params::Params;
+use crate::presets::roles::{Chain, Lr, detect};
+use crate::{Clip, Rig, Skeleton, head_tail};
+
+/// Têtes et queues monde de chaque os à chaque image.
+pub(crate) fn frames(skeleton: &Skeleton, clip: &Clip) -> Vec<Vec<(Vec3, Vec3)>> {
+    let mut pose = crate::Pose::rest(skeleton);
+    (0..clip.frame_count)
+        .map(|f| {
+            clip.sample_into(f as f32, &mut pose);
+            pose.world(skeleton)
+                .iter()
+                .zip(skeleton.bones())
+                .map(|(w, b)| head_tail(w, b.length))
+                .collect()
+        })
+        .collect()
+}
+
+/// Vérifie l'absence de NaN et, pour une boucle, que la dernière image
+/// reprend la première (au déplacement horizontal de la racine près).
+pub(crate) fn check_clip(skeleton: &Skeleton, clip: &Clip, looping: bool, name: &str) {
+    let all = frames(skeleton, clip);
+    for (f, frame) in all.iter().enumerate() {
+        for (h, t) in frame {
+            assert!(h.is_finite() && t.is_finite(), "{name}: NaN à l'image {f}");
+        }
+    }
+    if looping {
+        let (first, last) = (&all[0], &all[all.len() - 1]);
+        let shift = last[0].0 - first[0].0;
+        let shift = Vec3::new(shift.x, 0.0, shift.z);
+        for (i, ((h0, t0), (h1, t1))) in first.iter().zip(last).enumerate() {
+            let gap = (*h1 - shift - *h0).length().max((*t1 - shift - *t0).length());
+            assert!(gap < 2e-3, "{name}: boucle discontinue sur l'os {i} ({gap})");
+        }
+    }
+}
+
+/// Pieds posés : un point au sol ne glisse pas d'une image à l'autre.
+pub(crate) fn check_planted(skeleton: &Skeleton, roles: &RoleMap, clip: &Clip, name: &str) -> usize {
+    let all = frames(skeleton, clip);
+    let ground = roles.frame.ground;
+    let mut contacts = 0;
+    for side in Lr::BOTH {
+        let Some(foot) = roles.bone(Chain::Leg(side), 2) else { continue };
+        let rest_ankle = skeleton.rest_head_tail(foot).0.y;
+        for f in 1..all.len() {
+            let (a0, b0) = all[f - 1][foot.index()];
+            let (a1, b1) = all[f][foot.index()];
+            if b0.y < ground + 0.003 && b1.y < ground + 0.003 {
+                contacts += 1;
+                let slide = (b1 - b0).length();
+                assert!(slide < 0.005, "{name}: la plante glisse de {slide} m à l'image {f} ({side:?})");
+            }
+            if a0.y < rest_ankle + 0.002 && a1.y < rest_ankle + 0.002 && b1.y < ground + 0.003 {
+                let slide = (a1 - a0).length();
+                assert!(slide < 0.005, "{name}: la cheville glisse de {slide} m à l'image {f} ({side:?})");
+            }
+        }
+    }
+    contacts
+}
+
+fn walk(params: &[(&str, f32)], rig: &Rig) -> Clip {
+    let roles = detect(&rig.skeleton);
+    bake(Generator::HumanLocomotion, &Params::of(params), &rig.skeleton, &roles, 30.0, 1.0, 2).unwrap()
+}
+
+#[test]
+fn walk_on_demo_loops_and_plants_feet() {
+    let rig = Rig::demo();
+    let roles = detect(&rig.skeleton);
+    for (name, params) in [
+        ("walk", vec![("speed", 1.4)]),
+        ("run", vec![("speed", 3.5), ("run", 1.0)]),
+        ("sprint", vec![("speed", 7.0), ("run", 1.0)]),
+        ("sneak", vec![("speed", 0.8), ("crouch", 1.0)]),
+    ] {
+        let clip = walk(&params, &rig);
+        check_clip(&rig.skeleton, &clip, true, name);
+        let contacts = check_planted(&rig.skeleton, &roles, &clip, name);
+        assert!(contacts > 10, "{name}: {contacts} contacts");
+    }
+}
+
+#[test]
+fn every_builtin_preset_bakes_and_loops() {
+    let demo = Rig::demo();
+    for preset in crate::presets::builtin() {
+        let crate::presets::PresetKind::Procedural(p) = &preset.kind else { continue };
+        let mut targets = vec![p.reference().skeleton()];
+        if p.generator.rig_type() == crate::presets::RigType::Humanoid {
+            targets.push(demo.skeleton.clone());
+        }
+        for skeleton in targets {
+            let roles = detect(&skeleton);
+            let clip = bake(p.generator, &p.params, &skeleton, &roles, 30.0, 1.0, 1)
+                .unwrap_or_else(|e| panic!("{}: {e}", preset.info.id));
+            assert!(clip.frame_count >= 2, "{}", preset.info.id);
+            check_clip(&skeleton, &clip, preset.info.looping, &preset.info.id);
+        }
+        assert!(preset.info.frames > 0, "{}", preset.info.id);
+    }
+}
diff --git a/crates/bones-core/src/presets/reference/animals.rs b/crates/bones-core/src/presets/reference/animals.rs
new file mode 100644
index 0000000..4a0d54c
--- /dev/null
+++ b/crates/bones-core/src/presets/reference/animals.rs
@@ -0,0 +1,119 @@
+//! Squelettes de référence des animaux.
+
+use glam::Vec3;
+
+use super::Builder;
+use crate::Skeleton;
+
+/// Chien de 0,6 m au garrot : membres avant (bras) et arrière (jambes)
+/// digitigrades, queue de trois os.
+pub(super) fn quadruped() -> Skeleton {
+    let mut b = Builder::new();
+    let root = b.bone("root.x", None, [0.0, 0.55, -0.30], [0.0, 0.57, -0.15]);
+    let s1 = b.bone("spine_01.x", Some(root), [0.0, 0.57, -0.15], [0.0, 0.58, 0.05]);
+    let chest = b.bone("spine_02.x", Some(s1), [0.0, 0.58, 0.05], [0.0, 0.58, 0.22]);
+    let neck = b.bone("neck.x", Some(chest), [0.0, 0.58, 0.22], [0.0, 0.72, 0.36]);
+    b.bone("head.x", Some(neck), [0.0, 0.72, 0.36], [0.0, 0.70, 0.54]);
+    let tail = [[0.0, 0.56, -0.31], [0.0, 0.52, -0.45], [0.0, 0.45, -0.56], [0.0, 0.38, -0.65]];
+    b.chain("tail_#.x", Some(root), &tail.map(Vec3::from_array));
+    b.pair(|b, s, x| {
+        let p = |v: [f32; 3]| Vec3::new(v[0] * x, v[1], v[2]);
+        let front = [[0.09, 0.50, 0.20], [0.09, 0.30, 0.15], [0.09, 0.10, 0.18], [0.09, 0.03, 0.20], [0.09, 0.0, 0.26]];
+        let names = ["arm", "forearm", "hand", "toes_front"];
+        let mut parent = Some(chest);
+        for (i, name) in names.iter().enumerate() {
+            parent = Some(b.0.add_bone_world(format!("{name}.{s}"), parent, p(front[i]), p(front[i + 1])));
+        }
+        let hind = [[0.09, 0.50, -0.28], [0.09, 0.30, -0.20], [0.09, 0.13, -0.32], [0.09, 0.03, -0.30], [0.09, 0.0, -0.24]];
+        let names = ["thigh", "leg", "foot", "toes"];
+        let mut parent = Some(root);
+        for (i, name) in names.iter().enumerate() {
+            parent = Some(b.0.add_bone_world(format!("{name}.{s}"), parent, p(hind[i]), p(hind[i + 1])));
+        }
+    });
+    b.0
+}
+
+/// Oiseau de 0,37 m (pigeon) : corps incliné, long cou, ailes déployées.
+pub(super) fn bird() -> Skeleton {
+    let mut b = Builder::new();
+    let root = b.bone("root.x", None, [0.0, 0.20, -0.02], [0.0, 0.22, 0.04]);
+    let chest = b.bone("spine_01.x", Some(root), [0.0, 0.22, 0.04], [0.0, 0.25, 0.10]);
+    let neck = [[0.0, 0.25, 0.10], [0.0, 0.29, 0.13], [0.0, 0.33, 0.15], [0.0, 0.36, 0.16]];
+    let neck = b.chain("neck_#.x", Some(chest), &neck.map(Vec3::from_array));
+    b.bone("head.x", neck.last().copied(), [0.0, 0.36, 0.16], [0.0, 0.37, 0.22]);
+    let tail = [[0.0, 0.20, -0.03], [0.0, 0.18, -0.11], [0.0, 0.16, -0.19]];
+    b.chain("tail_#.x", Some(root), &tail.map(Vec3::from_array));
+    b.pair(|b, s, x| {
+        let p = |v: [f32; 3]| Vec3::new(v[0] * x, v[1], v[2]);
+        let wing = [[0.03, 0.24, 0.08], [0.12, 0.24, 0.06], [0.25, 0.24, 0.05], [0.38, 0.24, 0.03]];
+        b.chain(&format!("wing_#.{s}"), Some(chest), &wing.map(p));
+        let leg = [[0.03, 0.19, 0.01], [0.04, 0.14, 0.05], [0.04, 0.08, 0.0], [0.04, 0.015, 0.01], [0.04, 0.0, 0.05]];
+        let names = ["thigh", "leg", "foot", "toes"];
+        let mut parent = Some(root);
+        for (i, name) in names.iter().enumerate() {
+            parent = Some(b.0.add_bone_world(format!("{name}.{s}"), parent, p(leg[i]), p(leg[i + 1])));
+        }
+    });
+    b.0
+}
+
+/// Poisson de 0,5 m nageant à 0,5 m du sol : racine au milieu du corps,
+/// tête vers l'avant, queue vers l'arrière, nageoires.
+pub(super) fn fish() -> Skeleton {
+    let mut b = Builder::new();
+    let root = b.bone("root.x", None, [0.0, 0.5, 0.0], [0.0, 0.5, 0.1]);
+    let front = b.bone("spine_01.x", Some(root), [0.0, 0.5, 0.1], [0.0, 0.5, 0.18]);
+    b.bone("head.x", Some(front), [0.0, 0.5, 0.18], [0.0, 0.5, 0.26]);
+    let tail = [[0.0, 0.5, 0.0], [0.0, 0.5, -0.07], [0.0, 0.5, -0.13], [0.0, 0.5, -0.18], [0.0, 0.5, -0.24]];
+    b.chain("tail_#.x", Some(root), &tail.map(Vec3::from_array));
+    b.bone("fin_dorsal.x", Some(root), [0.0, 0.54, 0.03], [0.0, 0.58, -0.03]);
+    b.pair(|b, s, x| {
+        b.0.add_bone_world(
+            format!("fin.{s}"),
+            Some(front),
+            Vec3::new(0.03 * x, 0.48, 0.13),
+            Vec3::new(0.08 * x, 0.46, 0.09),
+        );
+    });
+    b.0
+}
+
+/// Serpent de 1,8 m posé au sol : racine derrière la tête, corps vers l'arrière.
+pub(super) fn serpent() -> Skeleton {
+    let mut b = Builder::new();
+    let root = b.bone("root.x", None, [0.0, 0.03, 0.9], [0.0, 0.03, 0.78]);
+    b.bone("head.x", Some(root), [0.0, 0.03, 0.9], [0.0, 0.03, 1.0]);
+    let points: Vec<Vec3> = (0..=14).map(|i| Vec3::new(0.0, 0.03, 0.78 - i as f32 * 0.12)).collect();
+    b.chain("spine_#.x", Some(root), &points);
+    b.0
+}
+
+/// Arthropode à `pairs` paires de pattes (4 : araignée, 3 : insecte) :
+/// corps central, abdomen, pattes à quatre segments (hanche, fémur, tibia, tarse).
+pub(super) fn many_legs(pairs: usize) -> Skeleton {
+    let mut b = Builder::new();
+    let body = b.bone("root.x", None, [0.0, 0.12, -0.02], [0.0, 0.12, 0.05]);
+    b.bone("head.x", Some(body), [0.0, 0.12, 0.05], [0.0, 0.11, 0.08]);
+    b.bone("spine_01.x", Some(body), [0.0, 0.13, -0.03], [0.0, 0.15, -0.14]);
+    let spread = if pairs > 3 { 0.022 } else { 0.03 };
+    for i in 0..pairs {
+        let z = 0.035 - i as f32 * spread;
+        // Les pattes avant visent l'avant, les arrière l'arrière.
+        let fan = (pairs as f32 - 1.0) * 0.5 - i as f32;
+        b.pair(|b, s, x| {
+            let p = |v: Vec3| Vec3::new(v.x * x, v.y, v.z);
+            let reach = Vec3::new(1.0, 0.0, fan * 0.45).normalize();
+            let base = Vec3::new(0.02, 0.12, z);
+            let points = [
+                base,
+                base + reach * 0.02 + Vec3::Y * 0.005,
+                base + reach * 0.07 + Vec3::Y * 0.05,
+                base + reach * 0.12 - Vec3::Y * 0.05,
+                base + reach * 0.14 - Vec3::Y * 0.12,
+            ];
+            b.chain(&format!("leg{}_#.{s}", i + 1), Some(body), &points.map(p));
+        });
+    }
+    b.0
+}
diff --git a/crates/bones-core/src/presets/reference/mod.rs b/crates/bones-core/src/presets/reference/mod.rs
new file mode 100644
index 0000000..ba7f02f
--- /dev/null
+++ b/crates/bones-core/src/presets/reference/mod.rs
@@ -0,0 +1,141 @@
+//! Squelettes de référence de chaque famille : aperçu des préréglages
+//! procéduraux dans la galerie, export (BVH, glTF) et tests. Tous suivent
+//! les conventions de l'application (Y en haut, face à +Z, gauche en +X,
+//! noms à la Auto-Rig Pro), en mètres.
+
+mod animals;
+mod plants;
+
+use glam::Vec3;
+use serde::{Deserialize, Serialize};
+
+use crate::{AutoRigOptions, BoneId, Markers, Skeleton, autorig};
+
+/// Squelette de référence.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum RefRig {
+    Humanoid,
+    Quadruped,
+    Bird,
+    Fish,
+    Serpent,
+    Spider,
+    Insect,
+    Tree,
+    Grass,
+    Flower,
+    Palm,
+    Rope,
+    Tentacle,
+    Pendulum,
+    Machine,
+}
+
+impl RefRig {
+    pub const ALL: [RefRig; 15] = [
+        RefRig::Humanoid,
+        RefRig::Quadruped,
+        RefRig::Bird,
+        RefRig::Fish,
+        RefRig::Serpent,
+        RefRig::Spider,
+        RefRig::Insect,
+        RefRig::Tree,
+        RefRig::Grass,
+        RefRig::Flower,
+        RefRig::Palm,
+        RefRig::Rope,
+        RefRig::Tentacle,
+        RefRig::Pendulum,
+        RefRig::Machine,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            RefRig::Humanoid => "Human",
+            RefRig::Quadruped => "Dog",
+            RefRig::Bird => "Bird",
+            RefRig::Fish => "Fish",
+            RefRig::Serpent => "Snake",
+            RefRig::Spider => "Spider",
+            RefRig::Insect => "Insect",
+            RefRig::Tree => "Tree",
+            RefRig::Grass => "Grass blade",
+            RefRig::Flower => "Flower",
+            RefRig::Palm => "Palm tree",
+            RefRig::Rope => "Rope",
+            RefRig::Tentacle => "Tentacle",
+            RefRig::Pendulum => "Pendulum",
+            RefRig::Machine => "Machine",
+        }
+    }
+
+    /// Construit le squelette.
+    pub fn skeleton(self) -> Skeleton {
+        match self {
+            RefRig::Humanoid => humanoid(),
+            RefRig::Quadruped => animals::quadruped(),
+            RefRig::Bird => animals::bird(),
+            RefRig::Fish => animals::fish(),
+            RefRig::Serpent => animals::serpent(),
+            RefRig::Spider => animals::many_legs(4),
+            RefRig::Insect => animals::many_legs(3),
+            RefRig::Tree => plants::tree(),
+            RefRig::Grass => plants::grass(),
+            RefRig::Flower => plants::flower(),
+            RefRig::Palm => plants::palm(),
+            RefRig::Rope => plants::rope(),
+            RefRig::Tentacle => plants::tentacle(),
+            RefRig::Pendulum => plants::pendulum(),
+            RefRig::Machine => plants::machine(),
+        }
+    }
+}
+
+/// Humain de 1,80 m en pose T, généré par l'auto-rig (mêmes noms et
+/// proportions que les personnages de l'application).
+fn humanoid() -> Skeleton {
+    let markers = Markers {
+        head_top: Vec3::new(0.0, 1.80, 0.0),
+        chin: Vec3::new(0.0, 1.57, 0.02),
+        neck: Vec3::new(0.0, 1.51, 0.0),
+        shoulder: Vec3::new(0.19, 1.45, 0.0),
+        wrist: Vec3::new(0.72, 1.45, 0.0),
+        root: Vec3::new(0.0, 0.98, 0.0),
+        ankle: Vec3::new(0.10, 0.08, 0.0),
+    };
+    autorig::generate(&markers, &AutoRigOptions::default()).0
+}
+
+/// Petit outil de construction : os définis par tête et queue monde.
+pub(super) struct Builder(pub Skeleton);
+
+impl Builder {
+    pub fn new() -> Self {
+        Self(Skeleton::new())
+    }
+
+    pub fn bone(&mut self, name: &str, parent: Option<BoneId>, head: [f32; 3], tail: [f32; 3]) -> BoneId {
+        self.0
+            .add_bone_world(name, parent, Vec3::from_array(head), Vec3::from_array(tail))
+    }
+
+    /// Chaîne de points ; retourne les os créés.
+    pub fn chain(&mut self, base: &str, parent: Option<BoneId>, points: &[Vec3]) -> Vec<BoneId> {
+        let mut parent = parent;
+        let mut out = Vec::with_capacity(points.len().saturating_sub(1));
+        for (i, pair) in points.windows(2).enumerate() {
+            let name = base.replacen('#', &format!("{:02}", i + 1), 1);
+            let b = self.0.add_bone_world(name, parent, pair[0], pair[1]);
+            out.push(b);
+            parent = Some(b);
+        }
+        out
+    }
+
+    /// Côté gauche puis son symétrique (`.l` → `.r`).
+    pub fn pair(&mut self, f: impl Fn(&mut Builder, &str, f32)) {
+        f(self, "l", 1.0);
+        f(self, "r", -1.0);
+    }
+}
diff --git a/crates/bones-core/src/presets/reference/plants.rs b/crates/bones-core/src/presets/reference/plants.rs
new file mode 100644
index 0000000..e0cb6a9
--- /dev/null
+++ b/crates/bones-core/src/presets/reference/plants.rs
@@ -0,0 +1,116 @@
+//! Squelettes de référence des végétaux et des objets (cordes, machines).
+
+use glam::Vec3;
+
+use super::Builder;
+use crate::{BoneId, Skeleton};
+
+/// Points d'une courbe : `n` segments de `from` dans la direction `dir`,
+/// qui s'incurve de `bend` par segment.
+fn arc(from: Vec3, dir: Vec3, step: f32, n: usize, bend: Vec3) -> Vec<Vec3> {
+    let mut points = vec![from];
+    let mut d = dir.normalize();
+    let mut p = from;
+    for _ in 0..n {
+        p += d * step;
+        points.push(p);
+        d = (d + bend).normalize();
+    }
+    points
+}
+
+/// Arbre de 3 m : tronc de quatre os, deux étages de branches, rameaux.
+pub(super) fn tree() -> Skeleton {
+    let mut b = Builder::new();
+    let trunk = b.chain("trunk_#", None, &arc(Vec3::ZERO, Vec3::Y, 0.75, 4, Vec3::new(0.01, 0.0, 0.0)));
+    let mut k = 0;
+    let mut branch = |b: &mut Builder, at: BoneId, dir: Vec3, len: f32| {
+        k += 1;
+        let start = b.0.rest_head_tail(at).1;
+        let pts = arc(start, dir, len, 3, Vec3::new(0.0, -0.12, 0.0));
+        let bones = b.chain(&format!("branch_{k:02}_#"), Some(at), &pts);
+        // Rameau à mi-branche.
+        let mid = b.0.rest_head_tail(bones[1]).1;
+        let twig = arc(mid, dir + Vec3::Y * 1.2, len * 0.5, 2, Vec3::ZERO);
+        b.chain(&format!("branch_{k:02}_twig_#"), Some(bones[1]), &twig);
+    };
+    branch(&mut b, trunk[1], Vec3::new(1.0, 0.9, 0.2), 0.4);
+    branch(&mut b, trunk[1], Vec3::new(-1.0, 0.8, -0.3), 0.4);
+    branch(&mut b, trunk[2], Vec3::new(0.2, 0.9, 1.0), 0.33);
+    branch(&mut b, trunk[2], Vec3::new(-0.3, 0.9, -1.0), 0.33);
+    let top = arc(b.0.rest_head_tail(trunk[3]).1, Vec3::Y, 0.25, 2, Vec3::ZERO);
+    b.chain("crown_#", Some(trunk[3]), &top);
+    b.0
+}
+
+/// Brin d'herbe (ou roseau) de 0,6 m : une chaîne de cinq os.
+pub(super) fn grass() -> Skeleton {
+    let mut b = Builder::new();
+    b.chain("blade_#", None, &arc(Vec3::ZERO, Vec3::Y, 0.12, 5, Vec3::new(0.0, 0.0, 0.03)));
+    b.0
+}
+
+/// Fleur de 0,5 m : tige, cœur et quatre pétales.
+pub(super) fn flower() -> Skeleton {
+    let mut b = Builder::new();
+    let stem = b.chain("stem_#", None, &arc(Vec3::ZERO, Vec3::Y, 0.11, 4, Vec3::new(0.0, 0.0, 0.04)));
+    let top = b.0.rest_head_tail(stem[3]).1;
+    let head = b.bone("flower_head", Some(stem[3]), top.to_array(), (top + Vec3::new(0.0, 0.04, 0.03)).to_array());
+    let center = top + Vec3::new(0.0, 0.04, 0.03);
+    for (i, angle) in [0.0f32, 90.0, 180.0, 270.0].iter().enumerate() {
+        let (s, c) = angle.to_radians().sin_cos();
+        let dir = Vec3::new(c, 0.3, s * 0.8 + 0.4);
+        b.bone(&format!("petal_{:02}", i + 1), Some(head), center.to_array(), (center + dir * 0.06).to_array());
+    }
+    b.0
+}
+
+/// Palmier de 4 m : tronc incurvé de six os, six palmes retombantes.
+pub(super) fn palm() -> Skeleton {
+    let mut b = Builder::new();
+    let trunk = b.chain("trunk_#", None, &arc(Vec3::ZERO, Vec3::new(0.15, 1.0, 0.0), 0.65, 6, Vec3::new(0.02, 0.0, 0.0)));
+    let top = b.0.rest_head_tail(trunk[5]).1;
+    for i in 0..6 {
+        let a = i as f32 / 6.0 * std::f32::consts::TAU;
+        let out = Vec3::new(a.cos(), 0.5, a.sin());
+        b.chain(&format!("frond_{:02}_#", i + 1), Some(trunk[5]), &arc(top, out, 0.45, 3, Vec3::new(0.0, -0.45, 0.0)));
+    }
+    b.0
+}
+
+/// Corde de 1,6 m suspendue à 2 m.
+pub(super) fn rope() -> Skeleton {
+    let mut b = Builder::new();
+    let points: Vec<Vec3> = (0..=8).map(|i| Vec3::new(0.0, 2.0 - i as f32 * 0.2, 0.0)).collect();
+    b.chain("rope_#", None, &points);
+    b.0
+}
+
+/// Tentacule de 1,2 m dressé depuis le sol, légèrement incurvé.
+pub(super) fn tentacle() -> Skeleton {
+    let mut b = Builder::new();
+    b.chain("tentacle_#", None, &arc(Vec3::ZERO, Vec3::Y, 0.12, 10, Vec3::new(0.0, 0.0, 0.02)));
+    b.0
+}
+
+/// Pendule : pivot à 2 m, tige de 1,2 m et masse.
+pub(super) fn pendulum() -> Skeleton {
+    let mut b = Builder::new();
+    let rod = b.bone("pendulum_rod", None, [0.0, 2.0, 0.0], [0.0, 0.8, 0.0]);
+    b.bone("pendulum_bob", Some(rod), [0.0, 0.8, 0.0], [0.0, 0.65, 0.0]);
+    b.0
+}
+
+/// Machine : socle, roue à quatre rayons, bielle et piston.
+pub(super) fn machine() -> Skeleton {
+    let mut b = Builder::new();
+    let base = b.bone("base", None, [0.0, 0.0, 0.0], [0.0, 0.5, 0.0]);
+    let wheel = b.bone("wheel", Some(base), [0.0, 0.5, 0.0], [0.0, 0.5, 0.1]);
+    for i in 0..4 {
+        let a = i as f32 * std::f32::consts::FRAC_PI_2;
+        let tip = Vec3::new(a.cos() * 0.3, 0.5 + a.sin() * 0.3, 0.1);
+        b.bone(&format!("spoke_{:02}", i + 1), Some(wheel), [0.0, 0.5, 0.1], tip.to_array());
+    }
+    b.bone("piston", Some(base), [0.6, 0.2, 0.0], [0.6, 0.6, 0.0]);
+    b.0
+}
diff --git a/crates/bones-core/src/presets/retarget/clip.rs b/crates/bones-core/src/presets/retarget/clip.rs
new file mode 100644
index 0000000..a966893
--- /dev/null
+++ b/crates/bones-core/src/presets/retarget/clip.rs
@@ -0,0 +1,87 @@
+//! Reciblage d'un clip entier : rééchantillonnage à la cadence cible,
+//! vitesse, répétitions (le déplacement de la racine s'accumule d'un cycle
+//! à l'autre), calcul parallèle (une image par tâche).
+
+use glam::Vec3;
+use rayon::prelude::*;
+
+use super::{Mapping, Report, RetargetOptions, Retargeter};
+use crate::presets::error::{PresetError, invalid};
+use crate::presets::model::KeyframeData;
+use crate::presets::procedural::ctx::Body;
+use crate::presets::procedural::MAX_FRAMES;
+use crate::presets::roles::RoleMap;
+use crate::{Pose, Skeleton};
+
+/// Recible `data` sur `target` : une pose par image à `fps`, `speed` fois
+/// plus vite, répétée `loops` fois si l'animation boucle. `base` donne la
+/// pose des os sans correspondance.
+#[allow(clippy::too_many_arguments)]
+pub fn retarget_clip(
+    data: &KeyframeData,
+    looping: bool,
+    target: (&Skeleton, &RoleMap),
+    options: &RetargetOptions,
+    base: &Pose,
+    fps: f32,
+    speed: f32,
+    loops: u32,
+) -> Result<(Vec<Pose>, Report), PresetError> {
+    let (tgt, roles) = target;
+    if !roles.fits(tgt) || !data.roles.fits(&data.skeleton) {
+        return Err(invalid("bone roles do not match the skeleton"));
+    }
+    if data.clip.is_empty() {
+        return Err(invalid("the preset has no keys"));
+    }
+    let mapping = Mapping::new((&data.skeleton, &data.roles), &data.bones, (tgt, roles), options);
+    let mut report = mapping.report.clone();
+    if mapping.mapped() == 0 {
+        return Err(PresetError::Incompatible("no bone of the skeleton matches the preset".into()));
+    }
+    if data.roles.rig_type != roles.rig_type && !data.roles.rig_type.fits(roles.rig_type) {
+        report.warnings.push(format!(
+            "the preset was made for a {} skeleton, this one looks {}",
+            data.roles.rig_type.label().to_lowercase(),
+            roles.rig_type.label().to_lowercase()
+        ));
+    }
+    let retargeter = Retargeter::new((&data.skeleton, &data.roles), (tgt, roles), mapping, *options);
+
+    let src = &data.skeleton;
+    let clip = &data.clip;
+    let (first, last) = (clip.keys()[0].frame, clip.keys()[clip.keys().len() - 1].frame);
+    let span = (last - first) as f32 / clip.fps.max(1.0);
+    let fps = if fps.is_finite() { fps.clamp(1.0, 240.0) } else { 30.0 };
+    let speed = if speed.is_finite() { speed.clamp(0.05, 20.0) } else { 1.0 };
+    let cycles = if looping { loops.max(1) } else { 1 };
+    let count = ((span * cycles as f32 / speed * fps).round() as u32 + 1).min(MAX_FRAMES);
+
+    // Déplacement horizontal de la racine sur un cycle (pour enchaîner les boucles).
+    let root = data.roles.root().unwrap_or(crate::BoneId(0));
+    let world_at = |frame: f32| {
+        let mut pose = Pose::rest(src);
+        clip.sample_into(frame, &mut pose);
+        pose.world(src)
+    };
+    let up = data.roles.frame.up;
+    let step = world_at(last as f32)[root.index()].translation - world_at(first as f32)[root.index()].translation;
+    let step = if looping { step - up * step.dot(up) } else { Vec3::ZERO };
+
+    let poses = (0..count)
+        .into_par_iter()
+        .map_init(
+            || (Body::new(&retargeter.rig), Pose::rest(src)),
+            |(body, src_pose), j| {
+                let time = j as f32 / fps * speed;
+                let cycle = if span > 0.0 { ((time / span).floor() as u32).min(cycles - 1) } else { 0 };
+                let local = (time - cycle as f32 * span).clamp(0.0, span);
+                clip.sample_into(first as f32 + local * clip.fps, src_pose);
+                let world = src_pose.world(src);
+                retargeter.pose(&world, step * cycle as f32, base, body);
+                body.pose.clone()
+            },
+        )
+        .collect();
+    Ok((poses, report))
+}
diff --git a/crates/bones-core/src/presets/retarget/mapping.rs b/crates/bones-core/src/presets/retarget/mapping.rs
new file mode 100644
index 0000000..85a7c8e
--- /dev/null
+++ b/crates/bones-core/src/presets/retarget/mapping.rs
@@ -0,0 +1,114 @@
+//! Correspondance des os : par rôle (chaînes rééchantillonnées), puis par
+//! nom ; alignement des directions de repos.
+
+use glam::{Quat, Vec3};
+
+use super::{Report, RetargetOptions, Sample};
+use crate::math::rotation_arc;
+use crate::presets::roles::{Chain, RoleMap};
+use crate::rig::mirror::mirror_name;
+use crate::{BoneId, Skeleton};
+
+/// Correspondance os cible → os source.
+#[derive(Clone, Debug)]
+pub struct Mapping {
+    pub(crate) samples: Vec<Option<Sample>>,
+    pub(crate) report: Report,
+}
+
+/// Nom sans espace de noms (`mixamorig:Hips` → `hips`).
+fn plain(name: &str) -> String {
+    name.rsplit([':', '|']).next().unwrap_or(name).to_lowercase()
+}
+
+/// Reflet d'un vecteur canonique (plan sagittal).
+pub(crate) fn mirror_vec(v: Vec3) -> Vec3 {
+    Vec3::new(-v.x, v.y, v.z)
+}
+
+/// Reflet d'une rotation canonique (plan sagittal).
+pub(crate) fn mirror_quat(q: Quat) -> Quat {
+    Quat::from_xyzw(q.x, -q.y, -q.z, q.w)
+}
+
+impl Mapping {
+    /// `animated` : os source animés (vide : tous).
+    pub fn new(
+        source: (&Skeleton, &RoleMap),
+        animated: &[BoneId],
+        target: (&Skeleton, &RoleMap),
+        options: &RetargetOptions,
+    ) -> Self {
+        let (src, src_roles) = source;
+        let (tgt, tgt_roles) = target;
+        let usable = |b: BoneId| animated.is_empty() || animated.contains(&b);
+        let src_rest = src.rest_world();
+        let tgt_rest = tgt.rest_world();
+        let (bs, bt) = (src_roles.frame.basis(), tgt_roles.frame.basis());
+        let mut samples = vec![None; tgt.len()];
+        let mut report = Report::default();
+        for t in tgt.ids() {
+            let by_role = tgt_roles.role(t).and_then(|role| {
+                let chain = if options.mirror { role.chain.mirror() } else { role.chain };
+                let bones = src_roles.chain(chain);
+                let n_t = tgt_roles.chain(role.chain).len();
+                pick(&bones, role.index as usize, n_t, chain.is_limb())
+            });
+            let by_name = || {
+                let name = &tgt.bone(t).name;
+                let wanted = if options.mirror { mirror_name(name).unwrap_or(name.clone()) } else { name.clone() };
+                let wanted = plain(&wanted);
+                src.ids().find(|s| plain(&src.bone(*s).name) == wanted).map(|s| (s, s, 0.0))
+            };
+            let Some((a, b, w)) = by_role.or_else(by_name).filter(|(a, b, _)| usable(*a) && usable(*b)) else {
+                report.unmapped.push(tgt.bone(t).name.clone());
+                continue;
+            };
+            let role = tgt_roles.role(t).map(|r| r.chain);
+            let translate = matches!(role, Some(Chain::Root | Chain::Ground))
+                || (role.is_none() && tgt.bone(t).parent().is_none());
+            // Alignement de repos : direction source reportée dans le repère cible.
+            let dir = |x: BoneId| src_rest[x.index()].rotation * Vec3::Y;
+            let src_dir = dir(a).lerp(dir(b), w);
+            let canon = bs.inverse() * src_dir;
+            let wanted = bt * if options.mirror { mirror_vec(canon) } else { canon };
+            let tgt_dir = tgt_rest[t.index()].rotation * Vec3::Y;
+            let limit: f32 = match role {
+                Some(Chain::Root | Chain::Ground) => 0.0,
+                Some(c) if c.is_limb() => 100.0,
+                _ => 60.0,
+            };
+            let angle = tgt_dir.angle_between(wanted).to_degrees();
+            let align = if options.align_rest && angle < limit {
+                rotation_arc(tgt_dir, wanted)
+            } else {
+                Quat::IDENTITY
+            };
+            samples[t.index()] = Some(Sample { a, b, w, align, translate });
+            report.mapped.push((tgt.bone(t).name.clone(), src.bone(a).name.clone()));
+        }
+        Self { samples, report }
+    }
+
+    /// Nombre d'os cible animés.
+    pub fn mapped(&self) -> usize {
+        self.samples.iter().flatten().count()
+    }
+}
+
+/// Os source pour le rang `i` d'une chaîne cible de `n_t` os : même rang
+/// pour un membre, position relative interpolée pour une colonne, une
+/// queue, un cou.
+fn pick(bones: &[BoneId], i: usize, n_t: usize, limb: bool) -> Option<(BoneId, BoneId, f32)> {
+    let n_s = bones.len();
+    if n_s == 0 {
+        return None;
+    }
+    if limb || n_s == n_t {
+        return bones.get(i).map(|b| (*b, *b, 0.0));
+    }
+    let x = ((i as f32 + 0.5) / n_t.max(1) as f32 * n_s as f32 - 0.5).clamp(0.0, (n_s - 1) as f32);
+    let a = x.floor() as usize;
+    let b = (a + 1).min(n_s - 1);
+    Some((bones[a], bones[b], x - a as f32))
+}
diff --git a/crates/bones-core/src/presets/retarget/mod.rs b/crates/bones-core/src/presets/retarget/mod.rs
new file mode 100644
index 0000000..3a60652
--- /dev/null
+++ b/crates/bones-core/src/presets/retarget/mod.rs
@@ -0,0 +1,78 @@
+//! Reciblage d'une animation d'un squelette source vers un squelette cible.
+//!
+//! Méthode (squelette intermédiaire par rôles, Monzani et al. 2000 ;
+//! transfert de rotations monde relatives au repos alignées, comme l'IK
+//! Retargeter d'Unreal avec « auto-align » ou les outils de Rokoko et
+//! Blender) :
+//! 1. correspondance os à os par rôle (chaînes rééchantillonnées quand le
+//!    nombre d'os diffère : 2 os de colonne ↔ 4), puis par nom ;
+//! 2. pour chaque os apparié, la rotation monde de la source *relative à
+//!    son repos* est exprimée dans le repère du corps (avant/haut/gauche),
+//!    reportée dans celui de la cible, puis appliquée à l'os cible
+//!    préalablement aligné sur la direction de repos de la source (pose T
+//!    contre pose A, axes d'os différents) ;
+//! 3. le déplacement du bassin est mis à l'échelle (hauteur des hanches) ;
+//! 4. option : IK des pieds (et des pattes) pour reproduire les appuis à
+//!    l'échelle de la cible, sans glissement ;
+//! 5. les os sans correspondance gardent leur pose.
+
+mod clip;
+mod mapping;
+mod transfer;
+
+#[cfg(test)]
+mod tests;
+
+use glam::Quat;
+
+pub use clip::retarget_clip;
+pub use mapping::Mapping;
+pub(crate) use transfer::Retargeter;
+
+use crate::BoneId;
+
+/// Réglages du reciblage.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RetargetOptions {
+    /// Gauche ↔ droite.
+    pub mirror: bool,
+    /// Aligner les directions de repos (pose T ↔ pose A).
+    pub align_rest: bool,
+    /// Reporter le déplacement du bassin (sinon il reste en place).
+    pub root_motion: bool,
+    /// Replacer pieds et pattes par IK aux appuis mis à l'échelle.
+    pub foot_ik: bool,
+}
+
+impl Default for RetargetOptions {
+    fn default() -> Self {
+        Self {
+            mirror: false,
+            align_rest: true,
+            root_motion: true,
+            foot_ik: true,
+        }
+    }
+}
+
+/// Source d'un os cible : mélange de deux os source.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Sample {
+    pub a: BoneId,
+    pub b: BoneId,
+    pub w: f32,
+    /// Alignement de repos (monde cible), appliqué avant le delta source.
+    pub align: Quat,
+    /// Reporte aussi la translation (bassin, os au sol).
+    pub translate: bool,
+}
+
+/// Compte rendu d'un reciblage (affiché par l'interface).
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Report {
+    /// Os cible animés et leur source (noms).
+    pub mapped: Vec<(String, String)>,
+    /// Os cible sans correspondance (gardent leur pose).
+    pub unmapped: Vec<String>,
+    pub warnings: Vec<String>,
+}
diff --git a/crates/bones-core/src/presets/retarget/tests.rs b/crates/bones-core/src/presets/retarget/tests.rs
new file mode 100644
index 0000000..523ed62
--- /dev/null
+++ b/crates/bones-core/src/presets/retarget/tests.rs
@@ -0,0 +1,172 @@
+use glam::{Quat, Vec3};
+
+use super::*;
+use crate::presets::model::KeyframeData;
+use crate::presets::params::Params;
+use crate::presets::procedural::{Generator, bake};
+use crate::presets::reference::RefRig;
+use crate::presets::roles::detect;
+use crate::{Pose, Skeleton, Transform, head_tail};
+
+/// Variante en pose A : chaque bras tourné de 45° vers le bas autour de l'épaule.
+fn a_pose(mut s: Skeleton) -> Skeleton {
+    let mut world = s.rest_world();
+    for (name, sign) in [("arm.l", -1.0f32), ("arm.r", 1.0)] {
+        let arm = s.find(name).unwrap();
+        let pivot = world[arm.index()].translation;
+        let q = Quat::from_rotation_z(sign * 45f32.to_radians());
+        for b in s.subtree(arm) {
+            let w = &mut world[b.index()];
+            w.translation = pivot + q * (w.translation - pivot);
+            w.rotation = (q * w.rotation).normalize();
+        }
+    }
+    s.set_rest_world(&world);
+    s
+}
+
+fn walk_data(skeleton: Skeleton) -> KeyframeData {
+    let roles = detect(&skeleton);
+    let clip = bake(Generator::HumanLocomotion, &Params::of(&[("speed", 1.4)]), &skeleton, &roles, 30.0, 1.0, 1).unwrap();
+    KeyframeData {
+        skeleton,
+        roles,
+        clip,
+        bones: Vec::new(),
+    }
+}
+
+fn retarget(data: &KeyframeData, target: &Skeleton, options: RetargetOptions) -> (Vec<Pose>, Report) {
+    let roles = detect(target);
+    retarget_clip(data, true, (target, &roles), &options, &Pose::rest(target), 30.0, 1.0, 1).unwrap()
+}
+
+/// Directions monde des os nommés `names` dans une pose.
+fn dirs(s: &Skeleton, pose: &Pose, names: &[&str]) -> Vec<Vec3> {
+    let w = pose.world(s);
+    names
+        .iter()
+        .map(|n| {
+            let b = s.find(n).unwrap();
+            let (h, t) = head_tail(&w[b.index()], s.bone(b).length);
+            (t - h).normalize()
+        })
+        .collect()
+}
+
+const BONES: &[&str] = &["arm.l", "forearm.r", "thigh.l", "leg.r", "spine_02.x", "head.x"];
+
+#[test]
+fn identity_on_the_same_skeleton() {
+    let data = walk_data(RefRig::Humanoid.skeleton());
+    let (poses, report) = retarget(&data, &data.skeleton, RetargetOptions::default());
+    assert!(report.unmapped.is_empty(), "{:?}", report.unmapped);
+    let mut src = Pose::rest(&data.skeleton);
+    for (f, pose) in poses.iter().enumerate() {
+        data.clip.sample_into(f as f32, &mut src);
+        let (a, b) = (src.world(&data.skeleton), pose.world(&data.skeleton));
+        for (x, y) in a.iter().zip(&b) {
+            assert!(x.translation.abs_diff_eq(y.translation, 2e-3), "image {f}");
+        }
+    }
+}
+
+#[test]
+fn a_pose_source_drives_t_pose_target_and_back() {
+    let t_pose = RefRig::Humanoid.skeleton();
+    let data = walk_data(a_pose(t_pose.clone()));
+    let (poses, _) = retarget(&data, &t_pose, RetargetOptions::default());
+    let mut src = Pose::rest(&data.skeleton);
+    for (f, pose) in poses.iter().enumerate() {
+        data.clip.sample_into(f as f32, &mut src);
+        for (a, b) in dirs(&data.skeleton, &src, BONES).iter().zip(dirs(&t_pose, pose, BONES)) {
+            assert!(a.angle_between(b).to_degrees() < 1.0, "image {f}: {a:?} / {b:?}");
+        }
+    }
+    // Retour : T → A redonne l'animation d'origine.
+    let roles = detect(&t_pose);
+    let mut clip = crate::Clip::new(30.0, poses.len() as u32);
+    for (f, p) in poses.into_iter().enumerate() {
+        clip.set_key(f as u32, p);
+    }
+    let back = KeyframeData {
+        skeleton: t_pose,
+        roles,
+        clip,
+        bones: Vec::new(),
+    };
+    let (again, _) = retarget(&back, &data.skeleton, RetargetOptions::default());
+    for (f, pose) in again.iter().enumerate() {
+        data.clip.sample_into(f as f32, &mut src);
+        let (a, b) = (src.world(&data.skeleton), pose.world(&data.skeleton));
+        for (x, y) in a.iter().zip(&b) {
+            assert!(x.translation.abs_diff_eq(y.translation, 3e-3), "image {f}");
+        }
+    }
+}
+
+#[test]
+fn bigger_target_scales_root_motion_and_keeps_feet_planted() {
+    let data = walk_data(RefRig::Humanoid.skeleton());
+    let mut big = data.skeleton.clone();
+    let world: Vec<Transform> = big
+        .rest_world()
+        .iter()
+        .map(|w| Transform::from_rotation_translation(w.rotation, w.translation * 1.5))
+        .collect();
+    for b in big.ids().collect::<Vec<_>>() {
+        big.bone_mut(b).length *= 1.5;
+    }
+    big.set_rest_world(&world);
+    let (poses, _) = retarget(&data, &big, RetargetOptions::default());
+    let root = big.find("root.x").unwrap();
+    let travel = |s: &Skeleton, a: &Pose, b: &Pose| {
+        (b.world(s)[root.index()].translation - a.world(s)[root.index()].translation).z
+    };
+    let (mut s0, mut s1) = (Pose::rest(&data.skeleton), Pose::rest(&data.skeleton));
+    data.clip.sample_into(0.0, &mut s0);
+    data.clip.sample_into((poses.len() - 1) as f32, &mut s1);
+    let ratio = travel(&big, &poses[0], &poses[poses.len() - 1]) / travel(&data.skeleton, &s0, &s1);
+    assert!((ratio - 1.5).abs() < 0.02, "{ratio}");
+    let roles = detect(&big);
+    let mut clip = crate::Clip::new(30.0, poses.len() as u32);
+    for (f, p) in poses.into_iter().enumerate() {
+        clip.set_key(f as u32, p);
+    }
+    let contacts = crate::presets::procedural::tests::check_planted(&big, &roles, &clip, "grand");
+    assert!(contacts > 5);
+}
+
+#[test]
+fn mixamo_names_map_completely() {
+    let data = walk_data(RefRig::Humanoid.skeleton());
+    let mut target = RefRig::Humanoid.skeleton();
+    for b in target.ids().collect::<Vec<_>>() {
+        let name = target.bone(b).name.clone();
+        let mixamo = match name.as_str() {
+            "root.x" => "mixamorig:Hips".to_owned(),
+            n => format!("mixamorig:{}", n.replace(".l", "Left").replace(".r", "Right")),
+        };
+        target.bone_mut(b).name = mixamo;
+    }
+    let (_, report) = retarget(&data, &target, RetargetOptions::default());
+    let arms = report.mapped.iter().filter(|(t, _)| t.contains("arm")).count();
+    assert!(arms >= 4, "{:?}", report.mapped);
+}
+
+#[test]
+fn mirror_swaps_sides() {
+    let data = walk_data(RefRig::Humanoid.skeleton());
+    let options = RetargetOptions {
+        mirror: true,
+        ..RetargetOptions::default()
+    };
+    let (poses, _) = retarget(&data, &data.skeleton, options);
+    let s = &data.skeleton;
+    let mut src = Pose::rest(s);
+    data.clip.sample_into(7.0, &mut src);
+    let (a, b) = (src.world(s), poses[7].world(s));
+    let (l, r) = (s.find("foot.l").unwrap(), s.find("foot.r").unwrap());
+    let flip = |v: Vec3| Vec3::new(-v.x, v.y, v.z);
+    assert!(flip(a[l.index()].translation).abs_diff_eq(b[r.index()].translation, 3e-3));
+}
diff --git a/crates/bones-core/src/presets/retarget/transfer.rs b/crates/bones-core/src/presets/retarget/transfer.rs
new file mode 100644
index 0000000..581b2df
--- /dev/null
+++ b/crates/bones-core/src/presets/retarget/transfer.rs
@@ -0,0 +1,154 @@
+//! Transfert d'une pose source vers la cible : rotations monde relatives
+//! au repos dans le repère du corps, translation du bassin à l'échelle,
+//! puis IK des appuis.
+
+use glam::{Quat, Vec3};
+
+use super::mapping::{Mapping, mirror_quat, mirror_vec};
+use super::RetargetOptions;
+use crate::presets::procedural::ctx::{Body, Rigging};
+use crate::presets::roles::{Chain, Lr, RigType, RoleMap};
+use crate::{BoneId, Pose, Skeleton, Transform, head_tail};
+
+pub(crate) struct Retargeter<'a> {
+    src: &'a Skeleton,
+    src_rest: Vec<Transform>,
+    pub rig: Rigging<'a>,
+    mapping: Mapping,
+    /// Repères du corps (canonique → monde) source et cible.
+    bs: Quat,
+    bt: Quat,
+    /// Rapport des tailles (hauteurs de hanches) cible / source.
+    scale: f32,
+    options: RetargetOptions,
+    /// Membres posés par IK : (chaîne cible, chaîne source).
+    limbs: Vec<(Vec<BoneId>, Vec<BoneId>)>,
+}
+
+impl<'a> Retargeter<'a> {
+    pub fn new(
+        source: (&'a Skeleton, &'a RoleMap),
+        target: (&'a Skeleton, &'a RoleMap),
+        mapping: Mapping,
+        options: RetargetOptions,
+    ) -> Self {
+        let (src, src_roles) = source;
+        let (tgt, tgt_roles) = target;
+        let mut limbs = Vec::new();
+        if options.foot_ik {
+            let quad = matches!(tgt_roles.rig_type, RigType::Quadruped | RigType::MultiLegged);
+            for chain in tgt_roles.chains() {
+                let wanted = match chain {
+                    Chain::Leg(_) | Chain::LegPair(..) => true,
+                    Chain::Arm(_) => quad,
+                    _ => false,
+                };
+                let from = if options.mirror { chain.mirror() } else { chain };
+                let (t, s) = (tgt_roles.chain(chain), src_roles.chain(from));
+                if wanted && t.len() >= 2 && s.len() >= 2 {
+                    limbs.push((t, s));
+                }
+            }
+        }
+        Self {
+            src,
+            src_rest: src.rest_world(),
+            rig: Rigging::new(tgt, tgt_roles),
+            mapping,
+            bs: src_roles.frame.basis(),
+            bt: tgt_roles.frame.basis(),
+            scale: (tgt_roles.frame.size / src_roles.frame.size.max(1e-4)).clamp(1e-3, 1e3),
+            options,
+            limbs,
+        }
+    }
+
+    pub fn mapping(&self) -> &Mapping {
+        &self.mapping
+    }
+
+    /// Rotation monde source (relative au repos) → rotation monde cible.
+    fn carry(&self, q: Quat) -> Quat {
+        let c = self.bs.inverse() * q * self.bs;
+        let c = if self.options.mirror { mirror_quat(c) } else { c };
+        (self.bt * c * self.bt.inverse()).normalize()
+    }
+
+    /// Déplacement monde source → déplacement monde cible (à l'échelle).
+    fn carry_vec(&self, v: Vec3) -> Vec3 {
+        let c = self.bs.inverse() * v;
+        self.bt * if self.options.mirror { mirror_vec(c) } else { c } * self.scale
+    }
+
+    fn src_tail(&self, world: &[Transform], b: BoneId) -> Vec3 {
+        head_tail(&world[b.index()], self.src.bone(b).length).1
+    }
+
+    /// Pose cible pour une pose source (transformations monde `src_world`).
+    /// `extra` : décalage monde ajouté au déplacement source (boucles) ;
+    /// `base` : pose des os sans correspondance.
+    pub fn pose(&self, src_world: &[Transform], extra: Vec3, base: &Pose, body: &mut Body) {
+        let tgt = self.rig.skeleton;
+        let rest = &self.rig.rest;
+        let delta = |x: BoneId| (src_world[x.index()].rotation * self.src_rest[x.index()].rotation.inverse()).normalize();
+        for (t, bone) in tgt.bones().iter().enumerate() {
+            let parent = bone.parent().map_or(Transform::IDENTITY, |p| body.world[p.index()]);
+            let local = &bone.rest;
+            let keep = base.get(BoneId(t as u32));
+            let pose = match self.mapping.samples[t] {
+                None => keep,
+                Some(s) => {
+                    let (qa, qb) = (delta(s.a), delta(s.b));
+                    let qb = if qa.dot(qb) < 0.0 { -qb } else { qb };
+                    let ds = if s.w > 0.0 { qa.slerp(qb, s.w) } else { qa };
+                    let desired = self.carry(ds) * s.align * rest[t].rotation;
+                    let basis = (parent.rotation * local.rotation).normalize();
+                    let mut translation = keep.translation;
+                    if s.translate && self.options.root_motion {
+                        let a = s.a.index();
+                        let moved = src_world[a].translation + extra - self.src_rest[a].translation;
+                        let at = rest[t].translation + self.carry_vec(moved);
+                        let p = parent.inverse().transform_point(at);
+                        translation = local.rotation.inverse() * (p - local.translation) / local.scale;
+                    }
+                    Transform {
+                        translation,
+                        rotation: (basis.inverse() * desired).normalize(),
+                        scale: keep.scale,
+                    }
+                }
+            };
+            body.pose.bones[t] = pose;
+            body.world[t] = parent.mul(&local.mul(&pose));
+        }
+        for (t, s) in &self.limbs {
+            self.plant(src_world, extra, t, s, body);
+        }
+    }
+
+    /// Replace l'appui d'un membre (bout du 3ᵉ segment) à la position source
+    /// mise à l'échelle, en gardant l'orientation des segments distaux.
+    fn plant(&self, src_world: &[Transform], extra: Vec3, t: &[BoneId], s: &[BoneId], body: &mut Body) {
+        let rig = &self.rig;
+        let (kt, ks) = (2.min(t.len() - 1), 2.min(s.len() - 1));
+        let src_rest_contact = head_tail(&self.src_rest[s[ks].index()], self.src.bone(s[ks]).length).1;
+        let moved = self.src_tail(src_world, s[ks]) + extra - src_rest_contact;
+        let contact = rig.tail(t[kt]) + self.carry_vec(moved);
+        let target = if t.len() >= 3 {
+            let q = body.rotation(t[2]) * rig.rest[t[2].index()].rotation.inverse();
+            contact - q * (rig.tail(t[2]) - rig.head(t[2]))
+        } else {
+            contact
+        };
+        let saved: Vec<Quat> = t[2.min(t.len())..].iter().map(|b| body.rotation(*b)).collect();
+        let (hip, knee) = (body.head(t[0]), body.head(t[1]));
+        let side = t.first().and_then(|b| self.rig.roles.role(*b)).and_then(|r| r.chain.side());
+        let fallback = rig.w(Vec3::Z) + rig.w(Vec3::X) * side.map_or(0.0, Lr::sign) * 0.1;
+        let bend = (knee - (hip + target) * 0.5).try_normalize().unwrap_or(fallback);
+        let reach = rig.len(t[0]) + rig.len(t[1]);
+        body.two_bone(t[0], t[1], target, knee + bend * reach);
+        for (b, r) in t[2.min(t.len())..].iter().zip(saved) {
+            body.set_rotation(*b, r);
+        }
+    }
+}
diff --git a/crates/bones-core/src/presets/roles/classify.rs b/crates/bones-core/src/presets/roles/classify.rs
new file mode 100644
index 0000000..35e0e55
--- /dev/null
+++ b/crates/bones-core/src/presets/roles/classify.rs
@@ -0,0 +1,185 @@
+//! Type de rig d'après les rôles trouvés et la forme du squelette, puis
+//! rôles des corps sans membres (serpent, poisson) et chaînes libres
+//! (végétaux, cordes).
+
+use glam::Vec3;
+
+use super::names::{NameHint, Part};
+use super::topology::Geo;
+use super::{Chain, Lr, RigType, Role, RoleMap};
+use crate::{BoneId, Skeleton};
+
+pub(super) fn rig_type(skeleton: &Skeleton, hints: &[NameHint], geo: &Geo, map: &RoleMap) -> RigType {
+    let word = |p: Part| hints.iter().any(|h| h.part == Some(p));
+    let has = |c: Chain| map.bone(c, 0).is_some() || !map.chain(c).is_empty();
+    // Noms de végétaux majoritaires (tronc, branches, feuilles).
+    let plant_words = hints.iter().filter(|h| h.part == Some(Part::Plant)).count();
+    if plant_words * 3 >= skeleton.len() {
+        return RigType::Plant;
+    }
+    // Pattes multiples, posées au sol.
+    let legs_down = map
+        .chains()
+        .into_iter()
+        .filter(|c| matches!(c, Chain::LegPair(_, Lr::Left)))
+        .filter(|c| {
+            let tip = map.chain(*c).last().map(|b| geo.tails[b.index()].y);
+            tip.is_some_and(|y| y < geo.lo.y + 0.25 * geo.size)
+        })
+        .count();
+    if legs_down >= 3 {
+        return RigType::MultiLegged;
+    }
+    let legs = has(Chain::Leg(Lr::Left)) && has(Chain::Leg(Lr::Right));
+    let arms = has(Chain::Arm(Lr::Left)) && has(Chain::Arm(Lr::Right));
+    let ground = geo.lo.y;
+    let height = map.root().map_or(geo.size, |r| (geo.heads[r.index()].y - ground).max(1e-3));
+    let reaches_ground = |side| {
+        map.chain(Chain::Arm(side))
+            .last()
+            .is_some_and(|b| geo.tails[b.index()].y < ground + 0.2 * height)
+    };
+    // Colonne verticale : du bassin à la poitrine (ou à la tête).
+    let vertical = match (map.root(), map.chain(Chain::Spine).last().or(map.chain(Chain::Head).first())) {
+        (Some(r), Some(top)) => {
+            let d = geo.heads[top.index()] - geo.heads[r.index()];
+            d.normalize_or(Vec3::Y).y > 0.7
+        }
+        _ => true,
+    };
+    if word(Part::Wing) && legs {
+        return RigType::Bird;
+    }
+    if legs && arms {
+        return if reaches_ground(Lr::Left) && reaches_ground(Lr::Right) {
+            RigType::Quadruped
+        } else if vertical {
+            RigType::Humanoid
+        } else {
+            RigType::Bird
+        };
+    }
+    if legs {
+        return if vertical { RigType::Humanoid } else { RigType::Bird };
+    }
+    if word(Part::Fin) {
+        return RigType::Fish;
+    }
+    if arms {
+        return RigType::Any;
+    }
+    // Long corps sans membres : serpent au sol, poisson dans l'eau.
+    let body = map.chain(Chain::Spine);
+    if body.len() >= 5 {
+        let (first, last) = (geo.heads[body[0].index()], geo.tails[body[body.len() - 1].index()]);
+        let length: f32 = body.iter().map(|b| geo.len(*b)).sum();
+        if (last - first).normalize_or(Vec3::Y).y.abs() < 0.4 {
+            let top = body.iter().map(|b| geo.heads[b.index()].y).fold(f32::MIN, f32::max);
+            return if top - geo.lo.y < 0.15 * length { RigType::Serpent } else { RigType::Fish };
+        }
+    }
+    if word(Part::Plant) {
+        return RigType::Plant;
+    }
+    shape_type(skeleton, hints, geo)
+}
+
+/// Squelette sans membres : arbre, tige, corde, serpent ou poisson.
+fn shape_type(skeleton: &Skeleton, hints: &[NameHint], geo: &Geo) -> RigType {
+    let Some(main) = main_root(skeleton) else {
+        return RigType::Any;
+    };
+    let path = geo.main_path(main, hints);
+    let branching = skeleton.ids().filter(|b| geo.significant(*b, hints).len() >= 2).count();
+    let start = geo.heads[main.index()];
+    let end = geo.tails[path.last().unwrap().index()];
+    let d = (end - start).normalize_or(Vec3::Y);
+    let length: f32 = path.iter().map(|b| geo.len(*b)).sum();
+    if path.len() < 2 && branching == 0 {
+        return RigType::Any;
+    }
+    if d.y > 0.6 && start.y < geo.lo.y + 0.15 * length {
+        return RigType::Plant;
+    }
+    if branching > 0 {
+        return if d.y > 0.3 { RigType::Plant } else { RigType::Any };
+    }
+    if d.y < -0.6 {
+        return RigType::Chain;
+    }
+    if d.y.abs() < 0.4 && path.len() >= 6 {
+        let top = path.iter().map(|b| geo.heads[b.index()].y).fold(f32::MIN, f32::max);
+        return if top - geo.lo.y < 0.15 * length { RigType::Serpent } else { RigType::Fish };
+    }
+    RigType::Chain
+}
+
+fn main_root(skeleton: &Skeleton) -> Option<BoneId> {
+    skeleton
+        .ids()
+        .filter(|b| skeleton.bone(*b).parent().is_none())
+        .max_by_key(|b| skeleton.subtree(*b).len())
+}
+
+/// Rôles des corps sans membres et chaînes libres pour les os restants.
+pub(super) fn finish(skeleton: &Skeleton, hints: &[NameHint], geo: &Geo, map: &mut RoleMap) {
+    let Some(main) = main_root(skeleton) else { return };
+    let free = |map: &RoleMap, b: BoneId| map.role(b).is_none();
+    match map.rig_type {
+        RigType::Serpent | RigType::Fish if map.chain(Chain::Spine).is_empty() => {
+            // Corps : chemin principal, la racine côté tête (convention la
+            // plus courante), sauf si un os « tail » est près de la racine.
+            let mut path = geo.main_path(main, hints);
+            path.retain(|b| free(map, *b));
+            let tail_first = path
+                .iter()
+                .take(path.len() / 2)
+                .any(|b| hints[b.index()].part == Some(Part::Tail));
+            if let Some((first, rest)) = path.split_first() {
+                if map.root().is_none() {
+                    map.roles[first.index()] = Some(Role::new(Chain::Root, 0));
+                }
+                for (i, b) in rest.iter().enumerate() {
+                    map.roles[b.index()] = Some(Role::new(Chain::Spine, i.min(255) as u8));
+                }
+                let head = if tail_first { rest.last() } else { None };
+                if let Some(h) = head.filter(|_| map.chain(Chain::Head).is_empty()) {
+                    map.roles[h.index()] = Some(Role::new(Chain::Head, 0));
+                }
+            }
+        }
+        RigType::Plant | RigType::Chain | RigType::Any => {
+            if map.rig_type != RigType::Any {
+                // Végétaux et cordes : racine à la base, tout le reste en chaînes.
+                map.roles.iter_mut().for_each(|r| *r = None);
+            }
+            if map.root().is_none() && free(map, main) {
+                map.roles[main.index()] = Some(Role::new(Chain::Root, 0));
+            }
+            branches(skeleton, hints, geo, map);
+        }
+        _ => {}
+    }
+}
+
+/// Découpe les os restants en chaînes : les parents précédant leurs
+/// enfants, le premier os libre rencontré commence une chaîne qui suit le
+/// chemin principal (le tronc d'abord, puis chaque branche latérale).
+fn branches(skeleton: &Skeleton, hints: &[NameHint], geo: &Geo, map: &mut RoleMap) {
+    let mut next: u16 = 0;
+    for b in skeleton.ids() {
+        if map.role(b).is_some() || matches!(hints[b.index()].part, Some(Part::Ignore)) {
+            continue;
+        }
+        let path = geo.main_path(b, hints);
+        let mut index = 0u8;
+        for bone in path {
+            if map.role(bone).is_some() {
+                break;
+            }
+            map.roles[bone.index()] = Some(Role::new(Chain::Branch(next), index));
+            index = index.saturating_add(1);
+        }
+        next = next.saturating_add(1);
+    }
+}
diff --git a/crates/bones-core/src/presets/roles/detect.rs b/crates/bones-core/src/presets/roles/detect.rs
new file mode 100644
index 0000000..7337ee9
--- /dev/null
+++ b/crates/bones-core/src/presets/roles/detect.rs
@@ -0,0 +1,189 @@
+//! Détection des rôles : noms d'abord, topologie pour compléter, puis type
+//! de rig et repère du corps.
+
+use super::names::{self, NameHint, Part};
+use super::topology::{self, Geo};
+use super::{Chain, Lr, Role, RoleMap, classify, frame};
+use crate::{BoneId, Skeleton};
+
+/// Devine le type de rig, le rôle de chaque os et le repère du corps.
+pub fn detect(skeleton: &Skeleton) -> RoleMap {
+    let mut map = RoleMap::empty(skeleton);
+    if skeleton.is_empty() {
+        return map;
+    }
+    let hints: Vec<NameHint> = skeleton.bones().iter().map(|b| names::parse(&b.name)).collect();
+    let geo = Geo::new(skeleton);
+    from_names(skeleton, &hints, &geo, &mut map);
+    let topo = topology::detect(skeleton, &hints, &geo);
+    if topo.chains().iter().any(|c| matches!(c, Chain::LegPair(..))) {
+        // Plus de deux paires de pattes : la topologie l'emporte pour les membres.
+        for role in &mut map.roles {
+            if role.is_some_and(|r| matches!(r.chain, Chain::Arm(_) | Chain::Leg(_) | Chain::Clavicle(_))) {
+                *role = None;
+            }
+        }
+    }
+    merge(&mut map, topo);
+    map.rig_type = classify::rig_type(skeleton, &hints, &geo, &map);
+    classify::finish(skeleton, &hints, &geo, &mut map);
+    map.frame = frame::estimate(skeleton, &map);
+    map
+}
+
+/// Complète les chaînes absentes avec celles trouvées par la topologie,
+/// si leurs os sont libres.
+fn merge(map: &mut RoleMap, topo: RoleMap) {
+    let named_chains = map.chains();
+    for chain in topo.chains() {
+        if named_chains.contains(&chain) {
+            continue;
+        }
+        let bones = topo.chain(chain);
+        if bones.iter().all(|b| map.role(*b).is_none()) {
+            for b in bones {
+                map.roles[b.index()] = topo.role(b);
+            }
+        }
+    }
+}
+
+fn depth_sorted(skeleton: &Skeleton, mut bones: Vec<(BoneId, Option<u8>)>) -> Vec<(BoneId, Option<u8>)> {
+    bones.sort_by_key(|(b, _)| (skeleton.depth(*b), *b));
+    bones
+}
+
+/// Rôles d'après les noms.
+fn from_names(skeleton: &Skeleton, hints: &[NameHint], geo: &Geo, map: &mut RoleMap) {
+    let with = |pred: &dyn Fn(&NameHint) -> Option<Option<u8>>| -> Vec<(BoneId, Option<u8>)> {
+        let bones = skeleton
+            .ids()
+            .filter_map(|b| pred(&hints[b.index()]).map(|seg| (b, seg)))
+            .collect();
+        depth_sorted(skeleton, bones)
+    };
+    // Côté d'un os sans suffixe : d'après sa position (+X à gauche).
+    let side_of = |b: BoneId, h: &NameHint| {
+        h.side.unwrap_or(if geo.heads[b.index()].x >= 0.0 { Lr::Left } else { Lr::Right })
+    };
+
+    // Bassin : os « hips/pelvis », sinon ancêtre commun des deux jambes,
+    // sinon premier os « root » qui a des enfants.
+    let legs = with(&|h| matches!(h.part, Some(Part::Leg(_))).then_some(None));
+    let left_leg = legs.iter().find(|(b, _)| side_of(*b, &hints[b.index()]) == Lr::Left);
+    let right_leg = legs.iter().find(|(b, _)| side_of(*b, &hints[b.index()]) == Lr::Right);
+    let root = with(&|h| (h.part == Some(Part::Hips)).then_some(None))
+        .first()
+        .map(|(b, _)| *b)
+        .or_else(|| match (left_leg, right_leg) {
+            (Some((l, _)), Some((r, _))) => common_ancestor(skeleton, *l, *r),
+            _ => None,
+        })
+        .or_else(|| {
+            with(&|h| (h.part == Some(Part::RootWord)).then_some(None))
+                .into_iter()
+                .map(|(b, _)| b)
+                .find(|b| !geo.children[b.index()].is_empty())
+        });
+    if let Some(r) = root {
+        map.roles[r.index()] = Some(Role::new(Chain::Root, 0));
+        let ground = skeleton.ids().filter(|b| *b != r && skeleton.is_ancestor(*b, r)).find(|b| {
+            hints[b.index()].part == Some(Part::RootWord)
+        });
+        if let Some(g) = ground {
+            map.roles[g.index()] = Some(Role::new(Chain::Ground, 0));
+        }
+    }
+    let under_root = |b: BoneId| root.is_none_or(|r| skeleton.is_ancestor(r, b) && b != r);
+
+    let simple = [
+        (Part::Spine, Chain::Spine),
+        (Part::Neck, Chain::Neck),
+        (Part::Head, Chain::Head),
+        (Part::Jaw, Chain::Jaw),
+        (Part::Tail, Chain::Tail),
+    ];
+    for (part, chain) in simple {
+        let bones: Vec<_> = with(&|h| (h.part == Some(part)).then_some(None))
+            .into_iter()
+            .filter(|(b, _)| under_root(*b) && map.role(*b).is_none())
+            .collect();
+        let limit = if matches!(chain, Chain::Head | Chain::Jaw) { 1 } else { usize::MAX };
+        assign_chain(skeleton, geo, map, chain, bones.into_iter().take(limit).collect());
+    }
+    for side in Lr::BOTH {
+        let sided = |map: &RoleMap, pred: &dyn Fn(Part) -> Option<Option<u8>>| {
+            with(&|h| h.part.and_then(pred))
+                .into_iter()
+                .filter(|(b, _)| side_of(*b, &hints[b.index()]) == side && map.role(*b).is_none())
+                .collect::<Vec<_>>()
+        };
+        let clavicle = sided(map, &|p| (p == Part::Clavicle).then_some(None));
+        assign_chain(skeleton, geo, map, Chain::Clavicle(side), clavicle.into_iter().take(1).collect());
+        let arm = sided(map, &|p| match p {
+            Part::Arm(seg) => Some(seg),
+            Part::Wing => Some(None),
+            _ => None,
+        });
+        assign_chain(skeleton, geo, map, Chain::Arm(side), arm);
+        let leg = sided(map, &|p| if let Part::Leg(seg) = p { Some(seg) } else { None });
+        assign_chain(skeleton, geo, map, Chain::Leg(side), leg);
+        for finger in 0..5u8 {
+            let bones = sided(map, &|p| (p == Part::Finger(finger)).then_some(None));
+            assign_chain(skeleton, geo, map, Chain::Finger(side, finger), bones);
+        }
+        // `LeftShoulder / LeftElbow / LeftWrist` : l'épaule est le haut du bras.
+        let arm = map.chain(Chain::Arm(side));
+        if let (Some(first), Some(c)) = (arm.first(), map.bone(Chain::Clavicle(side), 0))
+            && map.role(*first).is_some_and(|r| r.index == 1)
+            && skeleton.bone(*first).parent() == Some(c)
+        {
+            map.roles[c.index()] = Some(Role::new(Chain::Arm(side), 0));
+        }
+    }
+}
+
+/// Numérote une chaîne (os triés par profondeur) : chaque os doit
+/// descendre du précédent ; un segment déjà vu n'est accepté que s'il
+/// change de direction (orteil après le pied), sinon c'est un os de
+/// découpe (`thigh.L.001`) laissé sans rôle.
+fn assign_chain(
+    skeleton: &Skeleton,
+    geo: &Geo,
+    map: &mut RoleMap,
+    chain: Chain,
+    bones: Vec<(BoneId, Option<u8>)>,
+) {
+    let mut next = 0u8;
+    let mut last: Option<BoneId> = None;
+    for (b, hint) in bones {
+        if last.is_some_and(|l| !skeleton.is_ancestor(l, b)) {
+            continue;
+        }
+        let index = match hint {
+            Some(h) if h < next => {
+                let bent = last.is_some_and(|l| geo.dir(l).dot(geo.dir(b)) < 0.94);
+                if !bent {
+                    continue;
+                }
+                next
+            }
+            Some(h) => h,
+            None => next,
+        };
+        map.roles[b.index()] = Some(Role::new(chain, index));
+        next = index.saturating_add(1);
+        last = Some(b);
+    }
+}
+
+fn common_ancestor(skeleton: &Skeleton, a: BoneId, b: BoneId) -> Option<BoneId> {
+    let mut cur = skeleton.bone(a).parent();
+    while let Some(p) = cur {
+        if skeleton.is_ancestor(p, b) {
+            return Some(p);
+        }
+        cur = skeleton.bone(p).parent();
+    }
+    None
+}
diff --git a/crates/bones-core/src/presets/roles/frame.rs b/crates/bones-core/src/presets/roles/frame.rs
new file mode 100644
index 0000000..54d7d29
--- /dev/null
+++ b/crates/bones-core/src/presets/roles/frame.rs
@@ -0,0 +1,139 @@
+//! Repère du corps : avant, haut, gauche, sol et taille de référence.
+//!
+//! Les générateurs et le reciblage travaillent dans un repère canonique
+//! (X à gauche, Y en haut, Z vers l'avant, comme les personnages de
+//! l'application) ; [`BodyFrame::basis`] le ramène dans le monde du squelette.
+
+use glam::{Mat3, Quat, Vec3};
+use serde::{Deserialize, Serialize};
+
+use super::{Chain, Lr, RoleMap};
+use crate::{Skeleton, head_tail};
+
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct BodyFrame {
+    /// Direction du regard (horizontale, unitaire).
+    pub forward: Vec3,
+    /// Verticale (unitaire).
+    pub up: Vec3,
+    /// Hauteur du sol au repos.
+    pub ground: f32,
+    /// Taille de référence : hauteur du bassin au-dessus du sol (ou du corps
+    /// entier sans bassin).
+    pub size: f32,
+}
+
+impl Default for BodyFrame {
+    fn default() -> Self {
+        Self {
+            forward: Vec3::Z,
+            up: Vec3::Y,
+            ground: 0.0,
+            size: 1.0,
+        }
+    }
+}
+
+impl BodyFrame {
+    /// Repère par défaut d'un squelette : face à +Z, sol au point le plus bas.
+    pub fn from_skeleton(skeleton: &Skeleton) -> Self {
+        let (lo, hi) = extent(skeleton);
+        Self {
+            ground: lo.y,
+            size: (hi - lo).max_element().max(1e-3),
+            ..Self::default()
+        }
+    }
+
+    pub fn left(&self) -> Vec3 {
+        self.up.cross(self.forward).normalize_or(Vec3::X)
+    }
+
+    /// Rotation canonique (X gauche, Y haut, Z avant) → monde.
+    pub fn basis(&self) -> Quat {
+        let forward = (self.forward - self.up * self.forward.dot(self.up)).normalize_or(Vec3::Z);
+        let up = self.up.normalize_or(Vec3::Y);
+        Quat::from_mat3(&Mat3::from_cols(up.cross(forward).normalize_or(Vec3::X), up, forward)).normalize()
+    }
+
+    pub fn to_world(&self, v: Vec3) -> Vec3 {
+        self.basis() * v
+    }
+
+    pub fn to_canon(&self, v: Vec3) -> Vec3 {
+        self.basis().inverse() * v
+    }
+}
+
+/// Boîte englobante des têtes et queues au repos.
+pub(super) fn extent(skeleton: &Skeleton) -> (Vec3, Vec3) {
+    let world = skeleton.rest_world();
+    let mut lo = Vec3::splat(f32::MAX);
+    let mut hi = Vec3::splat(f32::MIN);
+    for (w, b) in world.iter().zip(skeleton.bones()) {
+        let (h, t) = head_tail(w, b.length);
+        lo = lo.min(h.min(t));
+        hi = hi.max(h.max(t));
+    }
+    if lo.x > hi.x { (Vec3::ZERO, Vec3::ZERO) } else { (lo, hi) }
+}
+
+/// Repère estimé d'après les rôles : côtés gauche/droite, position de la
+/// tête, direction des pieds.
+pub(super) fn estimate(skeleton: &Skeleton, map: &RoleMap) -> BodyFrame {
+    let mut frame = BodyFrame::from_skeleton(skeleton);
+    let world = skeleton.rest_world();
+    let head_of = |b: crate::BoneId| world[b.index()].translation;
+    let tail_of = |b: crate::BoneId| head_tail(&world[b.index()], skeleton.bone(b).length).1;
+    let flat = |v: Vec3| Vec3::new(v.x, 0.0, v.z);
+
+    // Côtés : moyenne des membres gauches moins celle des droits.
+    let mut lateral = Vec3::ZERO;
+    for chain in map.chains() {
+        if let (Some(side), Some(first)) = (chain.side(), map.chain(chain).first()) {
+            lateral += head_of(*first) * side.sign();
+        }
+    }
+    let from_sides = flat(lateral).try_normalize().map(|l| l.cross(Vec3::Y));
+
+    // Corps horizontal (animal) : la tête est devant le bassin.
+    let root = map.root().or_else(|| map.chain(Chain::Spine).first().copied());
+    let head = map
+        .chain(Chain::Head)
+        .first()
+        .or(map.chain(Chain::Neck).last())
+        .or(map.chain(Chain::Spine).last())
+        .copied();
+    let from_head = match (root, head) {
+        (Some(r), Some(h)) if r != h => {
+            let d = head_of(h) - head_of(r);
+            let horizontal = flat(d).length();
+            (horizontal > 0.5 * d.length()).then(|| flat(d).normalize())
+        }
+        _ => None,
+    };
+
+    // Pieds : les orteils pointent vers l'avant.
+    let mut toes = Vec3::ZERO;
+    for side in Lr::BOTH {
+        if let Some(foot) = map.bone(Chain::Leg(side), 2) {
+            toes += flat(tail_of(foot) - head_of(foot));
+        }
+    }
+    let from_toes = toes.try_normalize();
+
+    frame.forward = match (from_head, from_sides, from_toes) {
+        (Some(h), _, _) => h,
+        (None, Some(s), Some(t)) if s.dot(t) < -0.3 => t,
+        (None, Some(s), _) => s,
+        (None, None, Some(t)) => t,
+        _ => Vec3::Z,
+    };
+    if let Some(r) = map.root() {
+        let height = head_of(r).y - frame.ground;
+        if height > 0.05 * frame.size {
+            frame.size = height;
+        }
+    }
+    frame
+}
diff --git a/crates/bones-core/src/presets/roles/mod.rs b/crates/bones-core/src/presets/roles/mod.rs
new file mode 100644
index 0000000..59f0846
--- /dev/null
+++ b/crates/bones-core/src/presets/roles/mod.rs
@@ -0,0 +1,284 @@
+//! Rôles des os : à quoi sert chaque os d'un squelette quelconque (bassin,
+//! colonne, bras gauche…), pour appliquer une animation conçue sur un autre
+//! squelette. Les rôles sont organisés en chaînes ([`Chain`]) numérotées de
+//! la racine vers le bout ([`Role::index`]).
+//!
+//! [`detect`] devine le type de rig et les rôles : noms d'abord (conventions
+//! Auto-Rig Pro, Rigify, Mixamo, Unreal, Unity, 3ds Max Biped, BVH CMU…),
+//! puis topologie et géométrie de la pose de repos. L'interface peut ensuite
+//! corriger chaque os à la main ([`RoleMap::set`]).
+
+mod classify;
+mod detect;
+mod frame;
+mod names;
+mod topology;
+
+#[cfg(test)]
+mod tests;
+
+use serde::{Deserialize, Serialize};
+
+pub use detect::detect;
+pub use frame::BodyFrame;
+
+use crate::{BoneId, Skeleton};
+
+/// Côté d'un membre.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
+pub enum Lr {
+    Left,
+    Right,
+}
+
+impl Lr {
+    pub const BOTH: [Lr; 2] = [Lr::Left, Lr::Right];
+
+    pub fn mirror(self) -> Lr {
+        match self {
+            Lr::Left => Lr::Right,
+            Lr::Right => Lr::Left,
+        }
+    }
+
+    /// +1 à gauche (+X canonique), −1 à droite.
+    pub fn sign(self) -> f32 {
+        match self {
+            Lr::Left => 1.0,
+            Lr::Right => -1.0,
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Lr::Left => "Left",
+            Lr::Right => "Right",
+        }
+    }
+}
+
+/// Chaîne d'os ayant un rôle commun.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
+pub enum Chain {
+    /// Os au sol sous le bassin (« root » d'Unreal) : trajectoire.
+    Ground,
+    /// Bassin : porte le déplacement du corps (un seul os).
+    Root,
+    /// Colonne, du bassin à la poitrine (tout le corps d'un poisson, d'un serpent).
+    Spine,
+    Neck,
+    Head,
+    Jaw,
+    Tail,
+    Clavicle(Lr),
+    /// Membre antérieur : bras, patte avant, aile (segments : haut, bas, main, doigt).
+    Arm(Lr),
+    /// Membre postérieur : jambe, patte arrière (cuisse, jambe, pied, orteils).
+    Leg(Lr),
+    /// Doigt : 0 pouce, 1 index, 2 majeur, 3 annulaire, 4 auriculaire.
+    Finger(Lr, u8),
+    /// Pattes des animaux à plus de quatre pattes (paire 0 à l'avant).
+    LegPair(u8, Lr),
+    /// Chaîne libre (végétaux, tentacules, cordes).
+    Branch(u16),
+}
+
+impl Chain {
+    /// Chaîne symétrique (gauche ↔ droite).
+    pub fn mirror(self) -> Chain {
+        match self {
+            Chain::Clavicle(s) => Chain::Clavicle(s.mirror()),
+            Chain::Arm(s) => Chain::Arm(s.mirror()),
+            Chain::Leg(s) => Chain::Leg(s.mirror()),
+            Chain::Finger(s, f) => Chain::Finger(s.mirror(), f),
+            Chain::LegPair(p, s) => Chain::LegPair(p, s.mirror()),
+            c => c,
+        }
+    }
+
+    pub fn side(self) -> Option<Lr> {
+        match self {
+            Chain::Clavicle(s) | Chain::Arm(s) | Chain::Leg(s) | Chain::Finger(s, _) | Chain::LegPair(_, s) => {
+                Some(s)
+            }
+            _ => None,
+        }
+    }
+
+    /// Membre dont les segments ont un sens fixe (pas de rééchantillonnage).
+    pub fn is_limb(self) -> bool {
+        matches!(
+            self,
+            Chain::Clavicle(_) | Chain::Arm(_) | Chain::Leg(_) | Chain::Finger(..) | Chain::LegPair(..)
+        )
+    }
+
+    /// Nom affiché (anglais).
+    pub fn label(self) -> String {
+        let fingers = ["thumb", "index finger", "middle finger", "ring finger", "little finger"];
+        match self {
+            Chain::Ground => "Ground".into(),
+            Chain::Root => "Hips".into(),
+            Chain::Spine => "Spine".into(),
+            Chain::Neck => "Neck".into(),
+            Chain::Head => "Head".into(),
+            Chain::Jaw => "Jaw".into(),
+            Chain::Tail => "Tail".into(),
+            Chain::Clavicle(s) => format!("{} clavicle", s.label()),
+            Chain::Arm(s) => format!("{} arm", s.label()),
+            Chain::Leg(s) => format!("{} leg", s.label()),
+            Chain::Finger(s, f) => format!("{} {}", s.label(), fingers.get(f as usize).unwrap_or(&"finger")),
+            Chain::LegPair(p, s) => format!("{} leg {}", s.label(), p + 1),
+            Chain::Branch(b) => format!("Chain {}", b + 1),
+        }
+    }
+}
+
+/// Rôle d'un os : chaîne et rang dans la chaîne (0 côté racine).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord, Serialize, Deserialize)]
+pub struct Role {
+    pub chain: Chain,
+    pub index: u8,
+}
+
+impl Role {
+    pub fn new(chain: Chain, index: u8) -> Self {
+        Self { chain, index }
+    }
+
+    /// Nom affiché : « Left arm 2 », « Hips »…
+    pub fn label(self) -> String {
+        match self.chain {
+            Chain::Root | Chain::Ground | Chain::Head | Chain::Jaw => self.chain.label(),
+            c => format!("{} {}", c.label(), self.index + 1),
+        }
+    }
+}
+
+/// Famille de squelette, pour choisir les préréglages compatibles.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum RigType {
+    Humanoid,
+    Quadruped,
+    Bird,
+    Fish,
+    Serpent,
+    MultiLegged,
+    Plant,
+    Chain,
+    /// Convient à tout squelette.
+    #[default]
+    Any,
+}
+
+impl RigType {
+    pub const ALL: [RigType; 9] = [
+        RigType::Humanoid,
+        RigType::Quadruped,
+        RigType::Bird,
+        RigType::Fish,
+        RigType::Serpent,
+        RigType::MultiLegged,
+        RigType::Plant,
+        RigType::Chain,
+        RigType::Any,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            RigType::Humanoid => "Humanoid",
+            RigType::Quadruped => "Quadruped",
+            RigType::Bird => "Bird",
+            RigType::Fish => "Fish",
+            RigType::Serpent => "Serpent",
+            RigType::MultiLegged => "Multi-legged",
+            RigType::Plant => "Plant / tree",
+            RigType::Chain => "Chain",
+            RigType::Any => "Any",
+        }
+    }
+
+    /// Un préréglage prévu pour `self` s'applique-t-il à un rig `target` ?
+    pub fn fits(self, target: RigType) -> bool {
+        self == target || matches!(self, RigType::Any | RigType::Chain)
+    }
+}
+
+/// Rôles de tous les os d'un squelette, type de rig et repère du corps.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct RoleMap {
+    pub rig_type: RigType,
+    /// Rôle de chaque os (indice = [`BoneId`]).
+    pub roles: Vec<Option<Role>>,
+    pub frame: BodyFrame,
+}
+
+impl RoleMap {
+    /// Aucun rôle (repère par défaut : face à +Z).
+    pub fn empty(skeleton: &Skeleton) -> Self {
+        Self {
+            rig_type: RigType::Any,
+            roles: vec![None; skeleton.len()],
+            frame: BodyFrame::from_skeleton(skeleton),
+        }
+    }
+
+    /// Correspond au squelette (même nombre d'os).
+    pub fn fits(&self, skeleton: &Skeleton) -> bool {
+        self.roles.len() == skeleton.len()
+    }
+
+    pub fn role(&self, bone: BoneId) -> Option<Role> {
+        self.roles.get(bone.index()).copied().flatten()
+    }
+
+    /// Change le rôle d'un os ; l'os qui avait ce rôle le perd.
+    pub fn set(&mut self, bone: BoneId, role: Option<Role>) {
+        if let Some(r) = role {
+            for slot in &mut self.roles {
+                if *slot == Some(r) {
+                    *slot = None;
+                }
+            }
+        }
+        if let Some(slot) = self.roles.get_mut(bone.index()) {
+            *slot = role;
+        }
+    }
+
+    pub fn bone(&self, chain: Chain, index: u8) -> Option<BoneId> {
+        self.roles
+            .iter()
+            .position(|r| *r == Some(Role { chain, index }))
+            .map(|i| BoneId(i as u32))
+    }
+
+    /// Os d'une chaîne, de la racine vers le bout.
+    pub fn chain(&self, chain: Chain) -> Vec<BoneId> {
+        let mut bones: Vec<(u8, BoneId)> = self
+            .roles
+            .iter()
+            .enumerate()
+            .filter_map(|(i, r)| r.filter(|r| r.chain == chain).map(|r| (r.index, BoneId(i as u32))))
+            .collect();
+        bones.sort_unstable();
+        bones.into_iter().map(|(_, b)| b).collect()
+    }
+
+    /// Chaînes présentes, triées.
+    pub fn chains(&self) -> Vec<Chain> {
+        let mut chains: Vec<Chain> = self.roles.iter().flatten().map(|r| r.chain).collect();
+        chains.sort_unstable();
+        chains.dedup();
+        chains
+    }
+
+    /// Bassin (porteur du déplacement).
+    pub fn root(&self) -> Option<BoneId> {
+        self.bone(Chain::Root, 0)
+    }
+
+    pub fn mapped_count(&self) -> usize {
+        self.roles.iter().flatten().count()
+    }
+}
diff --git a/crates/bones-core/src/presets/roles/names.rs b/crates/bones-core/src/presets/roles/names.rs
new file mode 100644
index 0000000..ccc860c
--- /dev/null
+++ b/crates/bones-core/src/presets/roles/names.rs
@@ -0,0 +1,209 @@
+//! Lecture des noms d'os : découpage en mots (camelCase, séparateurs,
+//! chiffres), côté gauche/droit et partie du corps, quelles que soient les
+//! conventions (Auto-Rig Pro `arm.l`, Rigify `DEF-upper_arm.L.001`, Mixamo
+//! `mixamorig:LeftForeArm`, Unreal `lowerarm_l`, 3ds Max `Bip01 L Forearm`,
+//! BVH CMU `LHipJoint`, VRM `J_Bip_L_UpperArm`…).
+
+use super::Lr;
+
+/// Partie du corps suggérée par un nom. Pour les membres, le segment
+/// (0 haut, 1 bas, 2 main/pied, 3 doigt/orteil) quand le nom le précise.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Part {
+    /// « root », « ground », « master » : bassin ou os au sol selon la hiérarchie.
+    RootWord,
+    Hips,
+    Spine,
+    Neck,
+    Head,
+    Jaw,
+    Tail,
+    Clavicle,
+    Arm(Option<u8>),
+    Leg(Option<u8>),
+    Wing,
+    Finger(u8),
+    Fin,
+    /// Tronc, branche, feuille…
+    Plant,
+    /// Tentacule, corde, chaîne.
+    Generic,
+    /// Bout de chaîne sans influence (`HeadTop_End`, `_nub`).
+    End,
+    /// Os auxiliaire (torsion, contrôleur, visage…) : jamais associé.
+    Ignore,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct NameHint {
+    pub side: Option<Lr>,
+    pub part: Option<Part>,
+}
+
+/// Préfixes et mots sans signification anatomique.
+const NOISE: &[&str] = &[
+    "mixamorig", "def", "org", "mch", "bip", "b", "j", "jnt", "bn", "cc", "base", "skeleton", "armature", "sk",
+    "skel", "character", "rig", "deform", "valvebiped", "x", "c", "m", "bone", "anim",
+];
+
+const IGNORE: &[&str] = &[
+    "twist", "roll", "helper", "pole", "target", "ik", "ctrl", "control", "ctr", "socket", "weapon", "prop",
+    "attach", "corrective", "eye", "eyes", "ear", "ears", "tongue", "hair", "brow", "lid", "lip", "lips", "cheek",
+    "nose", "teeth", "breast", "belt", "cloth", "skirt", "cape", "bag", "camera", "light", "mesh", "geo",
+];
+
+const END: &[&str] = &["end", "nub", "tip", "site", "top"];
+
+/// Découpe un nom en mots minuscules (préfixe d'espace de noms retiré).
+pub(super) fn tokens(name: &str) -> Vec<String> {
+    let name = name.rsplit([':', '|']).next().unwrap_or(name);
+    let chars: Vec<char> = name.chars().collect();
+    let mut out = Vec::new();
+    let mut cur = String::new();
+    for (i, &c) in chars.iter().enumerate() {
+        if !c.is_alphanumeric() {
+            flush(&mut cur, &mut out);
+            continue;
+        }
+        if let Some(p) = cur.chars().last() {
+            let next_lower = chars.get(i + 1).is_some_and(|n| n.is_lowercase());
+            let boundary = (p.is_lowercase() && c.is_uppercase())
+                || (p.is_alphabetic() != c.is_alphabetic())
+                || (p.is_uppercase() && c.is_uppercase() && next_lower);
+            if boundary {
+                flush(&mut cur, &mut out);
+            }
+        }
+        cur.push(c);
+    }
+    flush(&mut cur, &mut out);
+    out
+}
+
+fn flush(cur: &mut String, out: &mut Vec<String>) {
+    if !cur.is_empty() {
+        out.push(cur.to_lowercase());
+        cur.clear();
+    }
+}
+
+fn side_of(token: &str) -> Option<Lr> {
+    match token {
+        "left" | "l" | "lf" | "lft" | "izq" | "gauche" => Some(Lr::Left),
+        "right" | "r" | "rt" | "rgt" | "der" | "droite" => Some(Lr::Right),
+        _ => None,
+    }
+}
+
+/// Analyse un nom d'os.
+pub(super) fn parse(name: &str) -> NameHint {
+    let mut side = None;
+    let mut words: Vec<String> = Vec::new();
+    for t in tokens(name) {
+        if let Some(s) = side_of(&t) {
+            side = side.or(Some(s));
+        } else if !NOISE.contains(&t.as_str()) && !t.chars().all(|c| c.is_ascii_digit()) {
+            words.push(t);
+        }
+    }
+    NameHint {
+        side,
+        part: classify(&words, side.is_some()),
+    }
+}
+
+fn classify(words: &[String], sided: bool) -> Option<Part> {
+    let has = |w: &str| words.iter().any(|x| x == w);
+    let s: String = words.concat();
+    let any = |keys: &[&str]| keys.iter().any(|k| s.contains(k));
+    if s.is_empty() {
+        return None;
+    }
+    if words.iter().any(|w| IGNORE.contains(&w.as_str())) {
+        return Some(Part::Ignore);
+    }
+    if words.iter().any(|w| END.contains(&w.as_str())) {
+        return Some(Part::End);
+    }
+    let fingers = [
+        (&["thumb"][..], 0),
+        (&["index"][..], 1),
+        (&["middle"][..], 2),
+        (&["ring"][..], 3),
+        (&["pinky", "pinkie", "little"][..], 4),
+    ];
+    if let Some((_, f)) = fingers.iter().find(|(k, _)| any(k)) {
+        return Some(Part::Finger(*f));
+    }
+    if any(&["finger"]) {
+        return Some(Part::Ignore);
+    }
+    if any(&["wing"]) {
+        return Some(Part::Wing);
+    }
+    let leg_words = ["leg", "thigh", "shin", "calf", "foot", "paw", "toe", "hoof", "knee", "ankle"];
+    let front = has("front") || has("fore") || any(&["frontleg", "foreleg", "frontpaw"]);
+    let hind = has("back") || has("hind") || has("rear") || any(&["hindleg", "backleg", "rearleg"]);
+    if (front || hind) && any(&leg_words) {
+        let seg = leg_segment(&s);
+        return Some(if front { Part::Arm(seg) } else { Part::Leg(seg) });
+    }
+    if any(&["hip"]) && !any(&["hips"]) && sided {
+        // `LHipJoint` (BVH CMU) : court os vers la cuisse ; `LeftHip` : la cuisse.
+        return Some(if has("joint") { Part::Ignore } else { Part::Leg(Some(0)) });
+    }
+    if any(&leg_words) || any(&["upleg", "femur", "tibia", "crus", "shank", "heel", "tarsus", "ball", "digit"]) {
+        return Some(Part::Leg(leg_segment(&s)));
+    }
+    if any(&["forearm", "lowerarm", "elbow", "ulna", "radius"]) {
+        return Some(Part::Arm(Some(1)));
+    }
+    if any(&["hand", "wrist", "palm", "carpal", "carpus"]) {
+        return Some(Part::Arm(Some(2)));
+    }
+    if any(&["upperarm", "uparm", "humerus"]) {
+        return Some(Part::Arm(Some(0)));
+    }
+    if has("arm") {
+        // `arm.l`, `LeftArm` : le haut du bras, mais `arm_joint_L_2`… aussi.
+        return Some(Part::Arm(None));
+    }
+    let table: &[(&[&str], Part)] = &[
+        (&["clavicle", "collar", "shoulder", "scapula"], Part::Clavicle),
+        (&["neck"], Part::Neck),
+        (&["head", "skull", "cranium"], Part::Head),
+        (&["jaw", "chin", "mouth", "mandible"], Part::Jaw),
+        (&["tail"], Part::Tail),
+        (&["hips", "pelvis", "cog", "hip"], Part::Hips),
+        (&["spine", "chest", "abdomen", "torso", "belly", "thorax", "ribcage", "waist"], Part::Spine),
+        (&["root", "ground", "master", "trajectory"], Part::RootWord),
+        (&["trunk", "stem", "stalk", "branch", "twig", "leaf", "leaves", "frond", "petal", "flower"], Part::Plant),
+        (&["tentacle", "rope", "chain", "pendulum", "cable", "whip"], Part::Generic),
+    ];
+    if let Some((_, part)) = table.iter().find(|(k, _)| any(k)) {
+        return Some(*part);
+    }
+    if has("back") {
+        return Some(Part::Spine);
+    }
+    if has("fin") || any(&["pectoral", "dorsal", "caudal"]) {
+        return Some(Part::Fin);
+    }
+    None
+}
+
+/// Segment d'une jambe d'après son nom (`None` : à déduire de l'ordre).
+fn leg_segment(s: &str) -> Option<u8> {
+    let any = |keys: &[&str]| keys.iter().any(|k| s.contains(k));
+    if any(&["toe", "digit", "ball", "phalan"]) {
+        Some(3)
+    } else if any(&["foot", "ankle", "heel", "tarsus", "hoof", "paw"]) {
+        Some(2)
+    } else if any(&["calf", "shin", "lowerleg", "knee", "tibia", "crus", "shank"]) {
+        Some(1)
+    } else if any(&["thigh", "upleg", "upperleg", "femur"]) {
+        Some(0)
+    } else {
+        None
+    }
+}
