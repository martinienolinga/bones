diff --git a/crates/bones-core/src/autorig/face/guess.rs b/crates/bones-core/src/autorig/face/guess.rs
new file mode 100644
index 0000000..c227e2f
--- /dev/null
+++ b/crates/bones-core/src/autorig/face/guess.rs
@@ -0,0 +1,154 @@
+//! Estimation des marqueurs du visage sur le maillage : profil (nez, lèvres,
+//! menton), globes oculaires (pièces séparées, sinon proportions), oreilles,
+//! dents et langue (pièces séparées dans la bouche).
+
+use glam::Vec3;
+
+use super::FaceMarkers;
+use super::profile::{Landmarks, Profile};
+use crate::autorig::fit::surface::Surface;
+use crate::{Markers, Mesh};
+
+impl FaceMarkers {
+    /// Estimation sur la tête du maillage (vu de face, regard vers +Z),
+    /// d'après les marqueurs du corps. `None` si la tête n'a pas de visage
+    /// reconnaissable (pas de nez saillant) : aucun os du visage n'est alors
+    /// créé.
+    pub fn guess(mesh: &Mesh, markers: &Markers) -> Option<FaceMarkers> {
+        guess_on(&Surface::new(mesh), markers)
+    }
+}
+
+pub(crate) fn guess_on(s: &Surface, m: &Markers) -> Option<FaceMarkers> {
+    let cx = m.root.x;
+    let (neck, top) = (m.neck.y, m.head_top.y);
+    let hh = top - neck;
+    if !hh.is_finite() || hh <= 1e-3 {
+        return None;
+    }
+    let lm = Profile::new(s, cx, neck, top, hh / 400.0).landmarks(neck, top)?;
+    let temple = half_width(s, cx, lm.brow.y + 0.05 * hh);
+    let components = s.components();
+    let (eye, eye_radius) = find_eye(s, &components, cx, &lm, hh).unwrap_or_else(|| {
+        let x = 0.42 * temple;
+        (Vec3::new(cx + x, lm.nasion.y, lm.nasion.z - 0.55 * x), 0.36 * x)
+    });
+    let x = eye.x - cx;
+    if x <= 0.0 {
+        return None;
+    }
+    let skin = |px: f32, py: f32, z: f32| s.front_hit(px, py).unwrap_or(Vec3::new(px, py, z));
+    let ear = find_ear(s, cx, temple, &lm, eye);
+    let jaw = match ear {
+        Some((_, root)) => Vec3::new(cx, root.y - 0.3 * x, root.z + 0.4 * x),
+        None => Vec3::new(cx, lm.nose.y, eye.z - 2.5 * x),
+    };
+    let mut face = FaceMarkers {
+        eye,
+        eye_radius,
+        brow: skin(eye.x, eye.y + 0.72 * x, lm.brow.z),
+        nose_tip: Vec3::new(cx, lm.nose.y, lm.nose.z),
+        lip_top: Vec3::new(cx, lm.lip_top.y, lm.lip_top.z),
+        lip_bottom: Vec3::new(cx, lm.lip_bottom.y, lm.lip_bottom.z),
+        mouth_corner: skin(cx + 0.74 * x, lm.slit.y, lm.slit.z - 0.3 * x),
+        chin: Vec3::new(cx, lm.chin.y, lm.chin.z),
+        jaw,
+        ear: ear.map(|(tip, _)| tip),
+        teeth_top: None,
+        teeth_bottom: None,
+        tongue: None,
+    };
+    mouth_parts(s, &components, cx, &mut face, lm.slit.y);
+    plausible(&face, cx).then_some(face)
+}
+
+/// Demi-largeur de la tête à la hauteur `y` (tempes).
+fn half_width(s: &Surface, cx: f32, y: f32) -> f32 {
+    s.slice(Vec3::new(cx, y, 0.0), Vec3::Y)
+        .iter()
+        .flat_map(|(a, b)| [a.x, b.x])
+        .map(|px| (px - cx).abs())
+        .fold(0.0, f32::max)
+}
+
+/// Boîte englobante d'un ensemble de sommets.
+fn bounds(s: &Surface, vertices: &[u32]) -> (Vec3, Vec3) {
+    vertices.iter().fold((Vec3::MAX, Vec3::MIN), |(lo, hi), v| {
+        let p = s.positions[*v as usize];
+        (lo.min(p), hi.max(p))
+    })
+}
+
+/// Globe oculaire gauche : pièce séparée, à peu près sphérique, à hauteur
+/// des yeux. Centre de sa boîte (la cornée ne le décale pas) et rayon.
+fn find_eye(s: &Surface, components: &[Vec<u32>], cx: f32, lm: &Landmarks, hh: f32) -> Option<(Vec3, f32)> {
+    components
+        .iter()
+        .filter_map(|c| {
+            let (lo, hi) = bounds(s, c);
+            let (center, size) = ((lo + hi) * 0.5, hi - lo);
+            let ok = (0.02 * hh..0.3 * hh).contains(&(center.x - cx))
+                && (lm.slit.y..lm.brow.y + 0.05 * hh).contains(&center.y)
+                && (0.03 * hh..0.2 * hh).contains(&size.max_element())
+                && size.max_element() < 1.5 * size.min_element();
+            ok.then_some((c.len(), center, (size.x + size.y + size.z) / 6.0))
+        })
+        .max_by_key(|(count, _, _)| *count)
+        .map(|(_, center, radius)| (center, radius))
+}
+
+/// Oreille gauche : sommets qui dépassent nettement la largeur des tempes,
+/// entre la bouche et les sourcils, en arrière des yeux. (pointe, racine)
+fn find_ear(s: &Surface, cx: f32, temple: f32, lm: &Landmarks, eye: Vec3) -> Option<(Vec3, Vec3)> {
+    let ear: Vec<Vec3> = s
+        .vertices()
+        .map(|v| s.positions[v as usize])
+        .filter(|p| p.x - cx > 1.08 * temple && (lm.slit.y..lm.brow.y).contains(&p.y) && p.z < eye.z)
+        .collect();
+    if ear.len() < 8 {
+        return None;
+    }
+    let tip = *ear.iter().max_by(|a, b| a.x.total_cmp(&b.x))?;
+    let centroid = ear.iter().copied().sum::<Vec3>() / ear.len() as f32;
+    Some((tip, Vec3::new(cx + temple * 0.95, centroid.y, centroid.z)))
+}
+
+/// Dents et langue : pièces séparées (autres que les yeux) dans la bouche.
+fn mouth_parts(s: &Surface, components: &[Vec<u32>], cx: f32, face: &mut FaceMarkers, slit: f32) {
+    let half = (face.mouth_corner.x - cx) * 1.5;
+    let mut tongue: Option<(usize, Vec3, Vec3)> = None;
+    for c in components {
+        let (lo, hi) = bounds(s, c);
+        let center = (lo + hi) * 0.5;
+        let inside = (center.x - cx).abs() < half
+            && (face.chin.y..face.nose_tip.y).contains(&center.y)
+            && (face.jaw.z..face.lip_top.z).contains(&center.z)
+            && hi.z < face.lip_top.z + face.eye_radius;
+        if !inside || (center - face.eye).length() < 2.0 * face.eye_radius {
+            continue;
+        }
+        let deep = hi.z - lo.z > 2.0 * face.eye_radius && hi.y - lo.y < hi.z - lo.z;
+        if center.y >= slit {
+            face.teeth_top = Some(Vec3::new(cx, center.y, hi.z));
+        } else if deep && tongue.is_none_or(|t| c.len() > t.0) {
+            let back = Vec3::new(cx, center.y, lo.z + (hi.z - lo.z) * 0.15);
+            tongue = Some((c.len(), back, Vec3::new(cx, center.y, hi.z)));
+        } else {
+            face.teeth_bottom = Some(Vec3::new(cx, center.y, hi.z));
+        }
+    }
+    face.tongue = tongue.map(|(_, base, tip)| [base, tip]);
+}
+
+/// Cohérence d'ensemble : visage dans le bon ordre de haut en bas.
+fn plausible(f: &FaceMarkers, cx: f32) -> bool {
+    f.is_valid()
+        && f.brow.y > f.eye.y
+        && f.eye.y > f.nose_tip.y
+        && f.nose_tip.y > f.lip_top.y
+        && f.lip_top.y > f.lip_bottom.y
+        && f.lip_bottom.y > f.chin.y
+        && f.jaw.y > f.chin.y
+        && f.jaw.z < f.chin.z
+        && f.mouth_corner.x > cx
+}
diff --git a/crates/bones-core/src/autorig/face/markers.rs b/crates/bones-core/src/autorig/face/markers.rs
new file mode 100644
index 0000000..f2d0c36
--- /dev/null
+++ b/crates/bones-core/src/autorig/face/markers.rs
@@ -0,0 +1,140 @@
+//! Marqueurs du visage (étape « Face » d'Auto-Rig Pro) : quelques points
+//! clés de la tête, estimés sur le maillage ([`FaceMarkers::guess`]) puis
+//! ajustables à la main. Les points pairs sont donnés côté gauche (+X).
+
+use glam::Vec3;
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct FaceMarkers {
+    /// Centre du globe oculaire gauche.
+    pub eye: Vec3,
+    pub eye_radius: f32,
+    /// Milieu du sourcil gauche (sur la peau).
+    pub brow: Vec3,
+    pub nose_tip: Vec3,
+    /// Milieu des lèvres supérieure et inférieure (sur la peau).
+    pub lip_top: Vec3,
+    pub lip_bottom: Vec3,
+    /// Commissure gauche des lèvres.
+    pub mouth_corner: Vec3,
+    /// Pointe du menton (sur la peau).
+    pub chin: Vec3,
+    /// Charnière de la mâchoire, sur l'axe du corps.
+    pub jaw: Vec3,
+    /// Oreille gauche (pointe), si le modèle en a.
+    #[serde(default)]
+    pub ear: Option<Vec3>,
+    /// Dents du haut et du bas (pièces séparées dans la bouche), si présentes.
+    #[serde(default)]
+    pub teeth_top: Option<Vec3>,
+    #[serde(default)]
+    pub teeth_bottom: Option<Vec3>,
+    /// Langue (pièce séparée) : base et bout, si présente.
+    #[serde(default)]
+    pub tongue: Option<[Vec3; 2]>,
+}
+
+/// Marqueurs du visage plaçables à la main.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum FaceMarkerKind {
+    Eye,
+    Brow,
+    NoseTip,
+    LipTop,
+    LipBottom,
+    MouthCorner,
+    Chin,
+    Jaw,
+    Ear,
+}
+
+impl FaceMarkerKind {
+    pub const ALL: [FaceMarkerKind; 9] = [
+        FaceMarkerKind::Eye,
+        FaceMarkerKind::Brow,
+        FaceMarkerKind::NoseTip,
+        FaceMarkerKind::LipTop,
+        FaceMarkerKind::LipBottom,
+        FaceMarkerKind::MouthCorner,
+        FaceMarkerKind::Chin,
+        FaceMarkerKind::Jaw,
+        FaceMarkerKind::Ear,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            FaceMarkerKind::Eye => "Eye",
+            FaceMarkerKind::Brow => "Eyebrow",
+            FaceMarkerKind::NoseTip => "Nose tip",
+            FaceMarkerKind::LipTop => "Upper lip",
+            FaceMarkerKind::LipBottom => "Lower lip",
+            FaceMarkerKind::MouthCorner => "Mouth corner",
+            FaceMarkerKind::Chin => "Chin",
+            FaceMarkerKind::Jaw => "Jaw hinge",
+            FaceMarkerKind::Ear => "Ear",
+        }
+    }
+
+    /// Marqueur sur l'axe du corps (pas de symétrique).
+    pub fn is_central(self) -> bool {
+        matches!(
+            self,
+            FaceMarkerKind::NoseTip
+                | FaceMarkerKind::LipTop
+                | FaceMarkerKind::LipBottom
+                | FaceMarkerKind::Chin
+                | FaceMarkerKind::Jaw
+        )
+    }
+}
+
+impl FaceMarkers {
+    /// Position d'un marqueur ; `None` pour une oreille absente.
+    pub fn get(&self, kind: FaceMarkerKind) -> Option<Vec3> {
+        Some(match kind {
+            FaceMarkerKind::Eye => self.eye,
+            FaceMarkerKind::Brow => self.brow,
+            FaceMarkerKind::NoseTip => self.nose_tip,
+            FaceMarkerKind::LipTop => self.lip_top,
+            FaceMarkerKind::LipBottom => self.lip_bottom,
+            FaceMarkerKind::MouthCorner => self.mouth_corner,
+            FaceMarkerKind::Chin => self.chin,
+            FaceMarkerKind::Jaw => self.jaw,
+            FaceMarkerKind::Ear => return self.ear,
+        })
+    }
+
+    pub fn set(&mut self, kind: FaceMarkerKind, p: Vec3) {
+        match kind {
+            FaceMarkerKind::Eye => self.eye = p,
+            FaceMarkerKind::Brow => self.brow = p,
+            FaceMarkerKind::NoseTip => self.nose_tip = p,
+            FaceMarkerKind::LipTop => self.lip_top = p,
+            FaceMarkerKind::LipBottom => self.lip_bottom = p,
+            FaceMarkerKind::MouthCorner => self.mouth_corner = p,
+            FaceMarkerKind::Chin => self.chin = p,
+            FaceMarkerKind::Jaw => self.jaw = p,
+            FaceMarkerKind::Ear => self.ear = Some(p),
+        }
+    }
+
+    /// Toutes les valeurs sont finies et le rayon de l'œil positif.
+    pub fn is_valid(&self) -> bool {
+        let optional = self.ear.into_iter().chain(self.teeth_top).chain(self.teeth_bottom);
+        let tongue = self.tongue.into_iter().flatten();
+        FaceMarkerKind::ALL
+            .iter()
+            .filter_map(|k| self.get(*k))
+            .chain(optional)
+            .chain(tongue)
+            .all(|p| p.is_finite())
+            && self.eye_radius.is_finite()
+            && self.eye_radius > 0.0
+    }
+
+    /// Écart entre les centres des yeux : échelle du visage.
+    pub fn scale(&self, center_x: f32) -> f32 {
+        (2.0 * (self.eye.x - center_x).abs()).max(1e-3)
+    }
+}
diff --git a/crates/bones-core/src/autorig/face/mod.rs b/crates/bones-core/src/autorig/face/mod.rs
new file mode 100644
index 0000000..20e3992
--- /dev/null
+++ b/crates/bones-core/src/autorig/face/mod.rs
@@ -0,0 +1,137 @@
+//! Rig facial façon Auto-Rig Pro (étape « Face ») : mâchoire, yeux et
+//! paupières, sourcils, joues, nez, lèvres, oreilles, et si le modèle en a,
+//! dents et langue.
+//!
+//! Contrat de nommage (les préréglages d'expressions s'y réfèrent) : les os
+//! sont enfants de `head.x` sauf indication ([`FaceBone::parent`]), suffixes
+//! `.l` / `.r` / `.x`, os le long de leur +Y local.
+//! - `jaw.x` : pivot à la charnière, queue vers le menton ; `chin.x` ;
+//! - `eye.l/.r` : pivot au centre du globe, vers l'avant (+Z) ;
+//! - `eyelid_top/bot.l/.r` : pivot au centre du globe, tournés vers la
+//!   paupière ; une rotation autour de leur X local (= X monde au repos)
+//!   ferme ou ouvre la paupière ;
+//! - os de surface (sourcils, joues, nez, narines, lèvres, commissures) :
+//!   tête juste sous la peau, pointant vers l'avant (+Z). Au repos, X local =
+//!   X monde, Z local = −Y monde (vers le bas). Les côtés `.r` sont les miroirs
+//!   des `.l` (mêmes conventions que Blender : une même rotation locale donne
+//!   un mouvement symétrique).
+//!
+//! Étapes : [`FaceMarkers`] (estimés sur la tête du maillage, modifiables)
+//! → [`FaceLayout`] (positions des os) → os ajoutés par [`super::build`].
+
+mod build;
+mod guess;
+mod markers;
+mod profile;
+#[cfg(test)]
+mod tests;
+
+pub use build::FaceLayout;
+pub use markers::{FaceMarkerKind, FaceMarkers};
+
+use crate::{BoneId, Skeleton};
+
+/// Parent d'un os du visage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FaceParent {
+    Head,
+    Jaw,
+    /// Os précédent de la chaîne de la langue.
+    Tongue,
+}
+
+macro_rules! face_bones {
+    ($($variant:ident => $name:literal, $parent:ident;)*) => {
+        /// Os du visage, dans l'ordre de création.
+        #[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+        pub enum FaceBone {
+            $($variant,)*
+        }
+
+        impl FaceBone {
+            pub const ALL: [FaceBone; face_bones!(@count $($variant)*)] = [$(FaceBone::$variant,)*];
+
+            /// Nom de l'os (contrat).
+            pub const fn name(self) -> &'static str {
+                match self {
+                    $(FaceBone::$variant => $name,)*
+                }
+            }
+
+            pub const fn parent(self) -> FaceParent {
+                match self {
+                    $(FaceBone::$variant => FaceParent::$parent,)*
+                }
+            }
+        }
+    };
+    (@count) => { 0 };
+    (@count $head:ident $($tail:ident)*) => { 1 + face_bones!(@count $($tail)*) };
+}
+
+face_bones! {
+    Jaw => "jaw.x", Head;
+    Chin => "chin.x", Jaw;
+    Tongue1 => "tongue_01.x", Jaw;
+    Tongue2 => "tongue_02.x", Tongue;
+    Tongue3 => "tongue_03.x", Tongue;
+    TeethTop => "teeth_top.x", Head;
+    TeethBottom => "teeth_bot.x", Jaw;
+    EyeL => "eye.l", Head;
+    EyeR => "eye.r", Head;
+    EyelidTopL => "eyelid_top.l", Head;
+    EyelidTopR => "eyelid_top.r", Head;
+    EyelidBottomL => "eyelid_bot.l", Head;
+    EyelidBottomR => "eyelid_bot.r", Head;
+    BrowInL => "brow_in.l", Head;
+    BrowInR => "brow_in.r", Head;
+    BrowMidL => "brow_mid.l", Head;
+    BrowMidR => "brow_mid.r", Head;
+    BrowOutL => "brow_out.l", Head;
+    BrowOutR => "brow_out.r", Head;
+    CheekL => "cheek.l", Head;
+    CheekR => "cheek.r", Head;
+    Nose => "nose.x", Head;
+    NostrilL => "nostril.l", Head;
+    NostrilR => "nostril.r", Head;
+    LipTop => "lip_top.x", Head;
+    LipTopL => "lip_top.l", Head;
+    LipTopR => "lip_top.r", Head;
+    LipBottom => "lip_bot.x", Jaw;
+    LipBottomL => "lip_bot.l", Jaw;
+    LipBottomR => "lip_bot.r", Jaw;
+    LipCornerL => "lip_corner.l", Head;
+    LipCornerR => "lip_corner.r", Head;
+    EarL => "ear.l", Head;
+    EarR => "ear.r", Head;
+}
+
+/// Noms de tous les os du visage (contrat), dans l'ordre de création.
+pub const NAMES: [&str; FaceBone::ALL.len()] = {
+    let mut names = [""; FaceBone::ALL.len()];
+    let mut i = 0;
+    while i < names.len() {
+        names[i] = FaceBone::ALL[i].name();
+        i += 1;
+    }
+    names
+};
+
+impl FaceBone {
+    pub fn from_name(name: &str) -> Option<FaceBone> {
+        FaceBone::ALL.into_iter().find(|b| b.name() == name)
+    }
+
+    /// Os de la partie basse du visage, qui suit la mâchoire.
+    pub fn is_lower(self) -> bool {
+        matches!(self.parent(), FaceParent::Jaw | FaceParent::Tongue)
+    }
+}
+
+/// Os du visage présents dans un squelette, avec leur identifiant.
+pub fn present(skeleton: &Skeleton) -> Vec<(FaceBone, BoneId)> {
+    FaceBone::ALL
+        .into_iter()
+        .filter_map(|b| skeleton.find(b.name()).map(|id| (b, id)))
+        .collect()
+}
diff --git a/crates/bones-core/src/autorig/face/profile.rs b/crates/bones-core/src/autorig/face/profile.rs
new file mode 100644
index 0000000..faed986
--- /dev/null
+++ b/crates/bones-core/src/autorig/face/profile.rs
@@ -0,0 +1,151 @@
+//! Profil du visage : coupe de la tête par le plan de symétrie, dont on garde
+//! le contour avant z(y) (la peau ; l'intérieur de la bouche ou des narines
+//! est derrière). Ses bosses et ses creux donnent le bout du nez, la racine
+//! du nez, l'arcade sourcilière, les lèvres et la fente de la bouche.
+
+use glam::Vec3;
+
+use crate::autorig::fit::surface::Surface;
+
+/// Point du profil : hauteur et profondeur.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Point {
+    pub y: f32,
+    pub z: f32,
+}
+
+/// Contour avant échantillonné à pas régulier en hauteur.
+pub(super) struct Profile {
+    y0: f32,
+    step: f32,
+    /// `NaN` là où la coupe ne passe pas.
+    z: Vec<f32>,
+}
+
+impl Profile {
+    /// Profil entre `y_lo` et `y_hi` (plan x = `center_x`), pas de `step`.
+    pub fn new(s: &Surface, center_x: f32, y_lo: f32, y_hi: f32, step: f32) -> Self {
+        let n = (((y_hi - y_lo) / step).ceil() as usize).max(1) + 1;
+        let mut z = vec![f32::NAN; n];
+        for (a, b) in s.slice(Vec3::new(center_x, 0.0, 0.0), Vec3::X) {
+            let (a, b) = if a.y <= b.y { (a, b) } else { (b, a) };
+            let first = ((a.y - y_lo) / step).ceil().max(0.0) as usize;
+            let mut i = first;
+            while i < n {
+                let y = y_lo + i as f32 * step;
+                if y > b.y {
+                    break;
+                }
+                let t = if b.y - a.y > 1e-9 { (y - a.y) / (b.y - a.y) } else { 0.0 };
+                let zi = a.z + (b.z - a.z) * t;
+                if z[i].is_nan() || zi > z[i] {
+                    z[i] = zi;
+                }
+                i += 1;
+            }
+        }
+        Self { y0: y_lo, step, z }
+    }
+
+    fn y(&self, i: usize) -> f32 {
+        self.y0 + i as f32 * self.step
+    }
+
+    fn range(&self, lo: f32, hi: f32) -> impl Iterator<Item = usize> + '_ {
+        let a = ((lo - self.y0) / self.step).ceil().max(0.0) as usize;
+        let b = (((hi - self.y0) / self.step).floor().max(-1.0) + 1.0) as usize;
+        (a..b.min(self.z.len())).filter(|i| !self.z[*i].is_nan())
+    }
+
+    /// Profondeur du contour à la hauteur `y` (échantillon le plus proche).
+    pub fn at(&self, y: f32) -> Option<f32> {
+        let i = ((y - self.y0) / self.step).round();
+        (i >= 0.0).then(|| self.z.get(i as usize).copied()).flatten().filter(|z| !z.is_nan())
+    }
+
+    /// Point le plus en avant entre `lo` et `hi` : (y, z).
+    pub fn max(&self, lo: f32, hi: f32) -> Option<Point> {
+        self.range(lo, hi)
+            .max_by(|a, b| self.z[*a].total_cmp(&self.z[*b]))
+            .map(|i| Point { y: self.y(i), z: self.z[i] })
+    }
+
+    /// Point le plus en retrait entre `lo` et `hi`.
+    pub fn min(&self, lo: f32, hi: f32) -> Option<Point> {
+        self.range(lo, hi)
+            .min_by(|a, b| self.z[*a].total_cmp(&self.z[*b]))
+            .map(|i| Point { y: self.y(i), z: self.z[i] })
+    }
+
+    /// Creux le plus marqué entre `lo` et `hi` : minimum local dont le
+    /// contour remonte des deux côtés dans un rayon `window` (profondeur =
+    /// la plus faible des deux remontées).
+    pub fn deepest_notch(&self, lo: f32, hi: f32, window: f32) -> Option<Point> {
+        let mut best: Option<(f32, usize)> = None;
+        for i in self.range(lo, hi) {
+            let z = self.z[i];
+            let y = self.y(i);
+            let above = self.max(y, y + window).map_or(z, |p| p.z);
+            let below = self.max(y - window, y).map_or(z, |p| p.z);
+            let depth = (above - z).min(below - z);
+            if depth > best.map_or(0.0, |b| b.0) {
+                best = Some((depth, i));
+            }
+        }
+        best.map(|(_, i)| Point { y: self.y(i), z: self.z[i] })
+    }
+}
+
+/// Repères du profil.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Landmarks {
+    pub nose: Point,
+    pub nasion: Point,
+    pub brow: Point,
+    pub slit: Point,
+    pub lip_top: Point,
+    pub lip_bottom: Point,
+    pub chin: Point,
+}
+
+impl Profile {
+    /// Repères d'un visage humain entre la base du cou (`neck`) et le sommet
+    /// du crâne (`top`). `None` si le profil n'a pas de nez saillant (tête
+    /// sans détails : pas de visage à rigger).
+    pub fn landmarks(&self, neck: f32, top: f32) -> Option<Landmarks> {
+        let hh = top - neck;
+        let nose = self.max(neck + 0.3 * hh, neck + 0.75 * hh)?;
+        let around = |dy: f32| self.at(nose.y + dy).unwrap_or(nose.z);
+        let protrusion = nose.z - around(0.05 * hh).max(around(-0.05 * hh));
+        if protrusion < 0.012 * hh {
+            return None;
+        }
+        let nasion = self.min(nose.y + 0.05 * hh, nose.y + 0.25 * hh)?;
+        let brow = self.max(nasion.y, nasion.y + 0.15 * hh)?;
+        let slit = self
+            .deepest_notch(nose.y - 0.2 * hh, nose.y - 0.08 * hh, 0.03 * hh)
+            .unwrap_or_else(|| {
+                let y = nose.y - 0.13 * hh;
+                Point {
+                    y,
+                    z: self.at(y).unwrap_or(nose.z),
+                }
+            });
+        let lip_top = self.max(slit.y, slit.y + 0.06 * hh)?;
+        let lip_bottom = self.max(slit.y - 0.06 * hh, slit.y)?;
+        let chin_y = slit.y - 0.75 * (nose.y - slit.y);
+        let chin = Point {
+            y: chin_y,
+            z: self.at(chin_y)?,
+        };
+        Some(Landmarks {
+            nose,
+            nasion,
+            brow,
+            slit,
+            lip_top,
+            lip_bottom,
+            chin,
+        })
+    }
+}
