<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>bones</string>
	<key>CFBundleIdentifier</key>
	<string>com.paintsharp.bones</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Bones</string>
	<key>CFBundleDisplayName</key>
	<string>Bones</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Obligatoire : sans écran de lancement, iPadOS exécute l'app en mode
	     compatibilité (letterbox) au lieu de la résolution native. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>metal</string>
	</array>

	<!-- Pavé tactile et souris (Magic Keyboard). -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Dossier Documents visible dans l'app Fichiers (« Sur mon iPad > Bones »). -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Projets .kbrig : un fichier compressé par projet (conteneur ZIP, mais
	     déclaré comme simple donnée pour que Fichiers ne propose pas de le
	     décompresser). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PaintSharp Bones Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.paintsharp.bones.kbrig</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.paintsharp.bones.kbrig</string>
			<key>UTTypeDescription</key>
			<string>PaintSharp Bones Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kbrig</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.paintsharp.bones.kbrig</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
